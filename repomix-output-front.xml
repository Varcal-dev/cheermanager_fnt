<file path="app/pagos/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Plus,
  Search,
  CreditCard,
  Trash2,
  CheckCircle2,
  Loader2,
  CalendarClock,
} from "lucide-react";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { toast } from "react-toastify";
import RegistrarPagoModal from "@/app/components/Forms/RegistrarPagoModal";
import {
  Factura,
  FacturaConSaldo,
  Pago,
  ResumenGeneracionCobros,
  calcularFacturasConSaldo,
  cambiarEstadoPago,
  eliminarPago,
  formatCOP,
  generarCobrosMensualidad,
  mensajeError,
  obtenerFacturas,
  obtenerPagos,
} from "@/app/lib/facturas-pagos";

export default function PagosPage() {
  const [cargando, setCargando] = useState(true);
  const [facturas, setFacturas] = useState<Factura[]>([]);
  const [pagos, setPagos] = useState<Pago[]>([]);
  const [searchTerm, setSearchTerm] = useState("");

  const [modalAbierto, setModalAbierto] = useState(false);
  const [facturaParaPago, setFacturaParaPago] =
    useState<FacturaConSaldo | null>(null);

  const [actualizandoId, setActualizandoId] = useState<number | null>(null);

  // Generación de cobros de mensualidad del mes.
  const [periodoAFacturar, setPeriodoAFacturar] = useState(() =>
    new Date().toISOString().slice(0, 7),
  );
  const [generandoCobros, setGenerandoCobros] = useState(false);
  const [resumenCobros, setResumenCobros] =
    useState<ResumenGeneracionCobros | null>(null);

  const handleGenerarCobros = async () => {
    setGenerandoCobros(true);
    setResumenCobros(null);
    try {
      const resumen = await generarCobrosMensualidad(periodoAFacturar);
      setResumenCobros(resumen);
      if (resumen.facturasGeneradas > 0) {
        toast.success(
          `Se generaron ${resumen.facturasGeneradas} facturas de mensualidad para ${resumen.periodo}`,
        );
        cargarDatos();
      } else {
        toast.info(
          `No había nada pendiente por facturar para ${resumen.periodo}`,
        );
      }
    } catch (error) {
      toast.error(
        mensajeError(error, "No se pudieron generar los cobros de mensualidad"),
      );
    } finally {
      setGenerandoCobros(false);
    }
  };

  const cargarDatos = () => {
    setCargando(true);
    Promise.allSettled([obtenerFacturas(), obtenerPagos()]).then(
      ([resFacturas, resPagos]) => {
        if (resFacturas.status === "fulfilled") {
          setFacturas(resFacturas.value);
        } else {
          toast.error("No se pudieron cargar las facturas");
        }

        if (resPagos.status === "fulfilled") {
          setPagos(resPagos.value);
        } else {
          toast.error("No se pudieron cargar los pagos");
        }

        setCargando(false);
      },
    );
  };

  useEffect(() => {
    cargarDatos();
  }, []);

  const facturasConSaldo = useMemo(
    () => calcularFacturasConSaldo(facturas, pagos),
    [facturas, pagos],
  );

  const facturasPendientes = useMemo(
    () => facturasConSaldo.filter((f) => f.saldoPendiente > 0),
    [facturasConSaldo],
  );

  const facturasPendientesFiltradas = facturasPendientes.filter((f) => {
    const texto =
      `${f.numeroFactura} ${f.persona.nombre} ${f.persona.apellidos}`.toLowerCase();
    return texto.includes(searchTerm.toLowerCase());
  });

  const pagosFiltrados = pagos
    .filter((p) => p.numeroFactura.toLowerCase().includes(searchTerm.toLowerCase()))
    .sort((a, b) => (a.fecha < b.fecha ? 1 : -1));

  const totalRecaudado = pagos
    .filter((p) => p.estado === "Pagado")
    .reduce((acc, p) => acc + p.monto, 0);

  const totalPendiente = facturasPendientes.reduce(
    (acc, f) => acc + f.saldoPendiente,
    0,
  );

  const abrirModalParaFactura = (factura: FacturaConSaldo) => {
    setFacturaParaPago(factura);
    setModalAbierto(true);
  };

  const abrirModalGeneral = () => {
    setFacturaParaPago(null);
    setModalAbierto(true);
  };

  const marcarComoPagado = async (pago: Pago) => {
    setActualizandoId(pago.id);
    try {
      await cambiarEstadoPago(pago.id, "Pagado");
      toast.success(
        `Pago de la factura ${pago.numeroFactura} marcado como Pagado`,
      );
      cargarDatos();
    } catch (error) {
      toast.error(mensajeError(error, "No se pudo actualizar el pago"));
    } finally {
      setActualizandoId(null);
    }
  };

  const borrarPago = async (pago: Pago) => {
    if (
      !confirm(
        `¿Eliminar el pago de ${formatCOP(pago.monto)} de la factura ${pago.numeroFactura}? Esta acción no se puede deshacer.`,
      )
    ) {
      return;
    }
    setActualizandoId(pago.id);
    try {
      await eliminarPago(pago.id);
      toast.success("Pago eliminado");
      cargarDatos();
    } catch (error) {
      toast.error(mensajeError(error, "No se pudo eliminar el pago"));
    } finally {
      setActualizandoId(null);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Pagos</h1>
          <p className="text-muted-foreground">
            Registra pagos y consulta el saldo pendiente de cada factura
          </p>
        </div>
        <Button onClick={abrirModalGeneral}>
          <Plus className="mr-2 h-4 w-4" /> Registrar pago
        </Button>
      </div>

      <div className="grid gap-4 md:grid-cols-2">
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">
              Recaudado (pagos en estado Pagado)
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold">{formatCOP(totalRecaudado)}</p>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">
              Cartera pendiente ({facturasPendientes.length} facturas)
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-2xl font-bold">{formatCOP(totalPendiente)}</p>
          </CardContent>
        </Card>
      </div>

      <Card>
        <CardHeader className="pb-2">
          <CardTitle className="text-base flex items-center gap-2">
            <CalendarClock className="h-4 w-4" />
            Generar cobros de mensualidad
          </CardTitle>
          <CardDescription>
            Crea la factura del mes indicado para todas las inscripciones
            activas con plan de mensualidad. Si una inscripción ya tiene
            factura para ese mes, se salta — no duplica cobros aunque lo
            corras varias veces.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-3">
          <div className="flex items-end gap-3">
            <div className="grid gap-1.5">
              <label className="text-xs text-muted-foreground">Período</label>
              <Input
                type="month"
                value={periodoAFacturar}
                onChange={(e) => setPeriodoAFacturar(e.target.value)}
                className="h-9 w-40"
              />
            </div>
            <Button onClick={handleGenerarCobros} disabled={generandoCobros}>
              {generandoCobros ? (
                <>
                  <Loader2 className="mr-2 h-4 w-4 animate-spin" /> Generando…
                </>
              ) : (
                "Generar cobros de este período"
              )}
            </Button>
          </div>

          {resumenCobros && (
            <div className="text-sm rounded-md border p-3 bg-muted/30">
              <p>
                Período <strong>{resumenCobros.periodo}</strong>:{" "}
                <strong>{resumenCobros.facturasGeneradas}</strong> facturas
                nuevas,{" "}
                <strong>{resumenCobros.yaFacturadas}</strong> ya existían.
              </p>
              {resumenCobros.errores.length > 0 && (
                <ul className="mt-2 list-disc pl-5 text-destructive">
                  {resumenCobros.errores.map((err, i) => (
                    <li key={i}>{err}</li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </CardContent>
      </Card>

      <div className="flex items-center space-x-2 max-w-sm">
        <Input
          placeholder="Buscar por número de factura o deportista…"
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className="h-9"
        />
        <Button variant="outline" size="sm">
          <Search className="h-4 w-4" />
        </Button>
      </div>

      {cargando ? (
        <div className="flex items-center justify-center py-12 text-muted-foreground">
          <Loader2 className="mr-2 h-5 w-5 animate-spin" /> Cargando datos
          financieros…
        </div>
      ) : (
        <>
          <Card>
            <CardHeader>
              <CardTitle>Facturas con saldo pendiente</CardTitle>
              <CardDescription>
                Total de la factura menos los pagos ya registrados, calculado
                en tiempo real
              </CardDescription>
            </CardHeader>
            <CardContent className="p-0">
              {facturasPendientesFiltradas.length === 0 ? (
                <div className="text-center py-6 text-muted-foreground">
                  No hay facturas con saldo pendiente
                </div>
              ) : (
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Factura</TableHead>
                      <TableHead>Deportista / Persona</TableHead>
                      <TableHead>Total</TableHead>
                      <TableHead>Pagado</TableHead>
                      <TableHead>Saldo</TableHead>
                      <TableHead>Estado</TableHead>
                      <TableHead>Acciones</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {facturasPendientesFiltradas.map((f) => (
                      <TableRow key={f.id}>
                        <TableCell className="font-medium">
                          {f.numeroFactura}
                        </TableCell>
                        <TableCell>
                          {f.persona.nombre} {f.persona.apellidos}
                        </TableCell>
                        <TableCell>{formatCOP(f.total)}</TableCell>
                        <TableCell>{formatCOP(f.totalPagado)}</TableCell>
                        <TableCell className="font-semibold">
                          {formatCOP(f.saldoPendiente)}
                        </TableCell>
                        <TableCell>
                          <Badge
                            variant={
                              f.estadoCuenta === "Abono parcial"
                                ? "outline"
                                : "destructive"
                            }
                          >
                            {f.estadoCuenta}
                          </Badge>
                        </TableCell>
                        <TableCell>
                          <Button size="sm" onClick={() => abrirModalParaFactura(f)}>
                            <CreditCard className="h-4 w-4 mr-1" /> Registrar
                            pago
                          </Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Historial de pagos</CardTitle>
              <CardDescription>
                Todos los pagos registrados en el sistema
              </CardDescription>
            </CardHeader>
            <CardContent className="p-0">
              {pagosFiltrados.length === 0 ? (
                <div className="text-center py-6 text-muted-foreground">
                  No hay pagos registrados todavía
                </div>
              ) : (
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Factura</TableHead>
                      <TableHead>Fecha</TableHead>
                      <TableHead>Monto</TableHead>
                      <TableHead>Tipo</TableHead>
                      <TableHead>Método</TableHead>
                      <TableHead>Estado</TableHead>
                      <TableHead>Saldo restante</TableHead>
                      <TableHead>Acciones</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {pagosFiltrados.map((p) => (
                      <TableRow key={p.id}>
                        <TableCell className="font-medium">
                          {p.numeroFactura}
                        </TableCell>
                        <TableCell>
                          {new Date(p.fecha).toLocaleDateString()}
                        </TableCell>
                        <TableCell>{formatCOP(p.monto)}</TableCell>
                        <TableCell>{p.tipoPago}</TableCell>
                        <TableCell>{p.metodoPago}</TableCell>
                        <TableCell>
                          <Badge
                            variant={
                              p.estado === "Pagado"
                                ? "default"
                                : p.estado === "Pendiente"
                                ? "outline"
                                : "destructive"
                            }
                          >
                            {p.estado}
                          </Badge>
                        </TableCell>
                        <TableCell>
                          {formatCOP(p.saldoPendienteFactura)}
                        </TableCell>
                        <TableCell>
                          <div className="flex space-x-2">
                            {p.estado !== "Pagado" && (
                              <Button
                                variant="outline"
                                size="sm"
                                disabled={actualizandoId === p.id}
                                onClick={() => marcarComoPagado(p)}
                              >
                                <CheckCircle2 className="h-4 w-4 mr-1" />{" "}
                                Marcar pagado
                              </Button>
                            )}
                            <Button
                              variant="outline"
                              size="sm"
                              disabled={actualizandoId === p.id}
                              onClick={() => borrarPago(p)}
                            >
                              <Trash2 className="h-4 w-4" />
                            </Button>
                          </div>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}
            </CardContent>
          </Card>
        </>
      )}

      <RegistrarPagoModal
        open={modalAbierto}
        onOpenChange={setModalAbierto}
        facturas={facturasPendientes}
        facturaPreseleccionada={facturaParaPago}
        onPagoRegistrado={cargarDatos}
      />
    </div>
  );
}
</file>

<file path="app/ventas/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { ChevronDown, ChevronRight, Plus, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import ProtectedRoute from "@/components/ProtectedRoute";
import React from "react";

interface Venta {
  id: number;
  fecha: string;
  total: number;
  metodoPago: string;
  personaId: number | null;
  nombreComprador: string;
  facturaId: number | null;
  detalles: {
    productoVarianteId: number;
    skuVariante: string;
    nombreProducto: string;
    talla: string;
    color: string;
    cantidad: number;
    precioUnitario: number;
    subtotal: number;
  }[];
}

interface DeportistaOpcion {
  deportistaId: number;
  nombre: string;
  apellidos: string;
}

interface VarianteOpcion {
  id: number;
  productoId: number;
  nombreProducto: string;
  talla: string;
  color: string;
  precioVenta: number;
  stockActual: number | null;
}

interface ItemCarrito {
  productoVarianteId: number;
  descripcion: string;
  cantidad: number;
  precioUnitario: number;
}

function primerDiaDelMes() {
  const d = new Date();
  return new Date(d.getFullYear(), d.getMonth(), 1).toISOString().slice(0, 10);
}

function hoy() {
  return new Date().toISOString().slice(0, 10);
}

const COMPRADOR_INTERNO = "interno";
const COMPRADOR_EXTERNO = "externo";

export default function VentasPage() {
  const [cargando, setCargando] = useState(true);
  const [ventas, setVentas] = useState<Venta[]>([]);
  const [desde, setDesde] = useState(primerDiaDelMes());
  const [hasta, setHasta] = useState(hoy());
  const [expandidas, setExpandidas] = useState<number[]>([]);

  const [modalAbierto, setModalAbierto] = useState(false);
  const [tipoComprador, setTipoComprador] = useState(COMPRADOR_INTERNO);
  const [deportistas, setDeportistas] = useState<DeportistaOpcion[]>([]);
  const [variantes, setVariantes] = useState<VarianteOpcion[]>([]);
  const [personaId, setPersonaId] = useState("");
  const [nombreExterno, setNombreExterno] = useState("");
  const [contactoExterno, setContactoExterno] = useState("");
  const [metodoPago, setMetodoPago] = useState("Efectivo");
  const [carrito, setCarrito] = useState<ItemCarrito[]>([]);
  const [varianteParaAgregar, setVarianteParaAgregar] = useState("");
  const [cantidadParaAgregar, setCantidadParaAgregar] = useState("1");
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    api
      .get("/api/ventas", { params: { desde, hasta } })
      .then((res) => setVentas(res.data))
      .catch(() => toast.error("No se pudieron cargar las ventas"))
      .finally(() => setCargando(false));
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [desde, hasta]);

  const toggleExpand = (id: number) => {
    setExpandidas((prev) =>
      prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id],
    );
  };

  const abrirNuevaVenta = () => {
    setTipoComprador(COMPRADOR_INTERNO);
    setPersonaId("");
    setNombreExterno("");
    setContactoExterno("");
    setMetodoPago("Efectivo");
    setCarrito([]);
    setVarianteParaAgregar("");
    setCantidadParaAgregar("1");
    setModalAbierto(true);

    Promise.allSettled([
      api.get("/api/deportistas"),
      api.get("/api/productos/activos"),
    ]).then(([resDeportistas, resProductos]) => {
      if (resDeportistas.status === "fulfilled") setDeportistas(resDeportistas.value.data);
      if (resProductos.status === "fulfilled") {
        const todasLasVariantes: VarianteOpcion[] = [];
        for (const p of resProductos.value.data) {
          for (const v of p.variantes ?? []) {
            todasLasVariantes.push({
              id: v.id,
              productoId: p.id,
              nombreProducto: p.nombre,
              talla: v.talla,
              color: v.color,
              precioVenta: v.precioVenta,
              stockActual: v.stockActual,
            });
          }
        }
        setVariantes(todasLasVariantes);
      }
    });
  };

  const agregarAlCarrito = () => {
    const variante = variantes.find((v) => String(v.id) === varianteParaAgregar);
    const cantidad = Number(cantidadParaAgregar);
    if (!variante) {
      toast.error("Selecciona un producto");
      return;
    }
    if (!cantidad || cantidad <= 0) {
      toast.error("Cantidad inválida");
      return;
    }
    const descripcion = `${variante.nombreProducto}${variante.talla ? ` - ${variante.talla}` : ""}${variante.color ? ` - ${variante.color}` : ""}`;
    setCarrito((prev) => [
      ...prev,
      {
        productoVarianteId: variante.id,
        descripcion,
        cantidad,
        precioUnitario: variante.precioVenta,
      },
    ]);
    setVarianteParaAgregar("");
    setCantidadParaAgregar("1");
  };

  const quitarDelCarrito = (index: number) => {
    setCarrito((prev) => prev.filter((_, i) => i !== index));
  };

  const totalCarrito = carrito.reduce((sum, i) => sum + i.cantidad * i.precioUnitario, 0);

  const guardarVenta = async () => {
    if (tipoComprador === COMPRADOR_INTERNO && !personaId) {
      toast.error("Selecciona el deportista comprador");
      return;
    }
    if (tipoComprador === COMPRADOR_EXTERNO && !nombreExterno.trim()) {
      toast.error("Ingresa el nombre del comprador externo");
      return;
    }
    if (carrito.length === 0) {
      toast.error("Agrega al menos un producto");
      return;
    }
    setGuardando(true);
    try {
      await api.post("/api/ventas", {
        personaId: tipoComprador === COMPRADOR_INTERNO ? Number(personaId) : null,
        nombreCompradorExterno: tipoComprador === COMPRADOR_EXTERNO ? nombreExterno : null,
        contactoCompradorExterno: tipoComprador === COMPRADOR_EXTERNO ? contactoExterno : null,
        metodoPago,
        items: carrito.map((i) => ({
          productoVarianteId: i.productoVarianteId,
          cantidad: i.cantidad,
        })),
      });
      toast.success("Venta registrada");
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      // El backend responde 409 tanto para "comprador inválido" como para
      // "stock insuficiente" — el mensaje ya viene claro sobre cuál es.
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo registrar la venta",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <ProtectedRoute requiredPermission="ver_venta">
      <div className="space-y-6">
        <div className="flex justify-between items-center">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Ventas</h1>
            <p className="text-muted-foreground">Ventas de la tienda del club</p>
          </div>
          <Button onClick={abrirNuevaVenta}>
            <Plus className="mr-2 h-4 w-4" /> Nueva Venta
          </Button>
        </div>

        <div className="flex gap-4 items-end">
          <div className="grid gap-1.5">
            <Label>Desde</Label>
            <Input type="date" value={desde} onChange={(e) => setDesde(e.target.value)} />
          </div>
          <div className="grid gap-1.5">
            <Label>Hasta</Label>
            <Input type="date" value={hasta} onChange={(e) => setHasta(e.target.value)} />
          </div>
        </div>

        <Card>
          <CardContent className="p-0">
            {cargando ? (
              <div className="flex items-center justify-center py-10 text-muted-foreground">
                <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
              </div>
            ) : (
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead className="w-[50px]"></TableHead>
                    <TableHead>Fecha</TableHead>
                    <TableHead>Comprador</TableHead>
                    <TableHead>Método de pago</TableHead>
                    <TableHead>Total</TableHead>
                    <TableHead>Factura</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {ventas.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={6} className="text-center py-8 text-muted-foreground">
                        No hay ventas en este rango de fechas.
                      </TableCell>
                    </TableRow>
                  ) : (
                    ventas.map((venta) => {
                      const estaExpandida = expandidas.includes(venta.id);
                      return (
                        <React.Fragment key={venta.id}>
                          <TableRow>
                            <TableCell>
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => toggleExpand(venta.id)}
                              >
                                {estaExpandida ? (
                                  <ChevronDown className="h-4 w-4" />
                                ) : (
                                  <ChevronRight className="h-4 w-4" />
                                )}
                              </Button>
                            </TableCell>
                            <TableCell>{new Date(venta.fecha).toLocaleDateString()}</TableCell>
                            <TableCell className="font-medium">{venta.nombreComprador}</TableCell>
                            <TableCell>{venta.metodoPago}</TableCell>
                            <TableCell>${Number(venta.total).toLocaleString()}</TableCell>
                            <TableCell>
                              {venta.facturaId ? (
                                <Badge variant="outline">Factura #{venta.facturaId}</Badge>
                              ) : (
                                <span className="text-muted-foreground">—</span>
                              )}
                            </TableCell>
                          </TableRow>
                          {estaExpandida && (
                            <TableRow className="bg-muted/50">
                              <TableCell colSpan={6} className="p-0">
                                <div className="p-4">
                                  <Table>
                                    <TableHeader>
                                      <TableRow>
                                        <TableHead>Producto</TableHead>
                                        <TableHead>Talla/Color</TableHead>
                                        <TableHead>Cantidad</TableHead>
                                        <TableHead>Precio unitario</TableHead>
                                        <TableHead>Subtotal</TableHead>
                                      </TableRow>
                                    </TableHeader>
                                    <TableBody>
                                      {venta.detalles.map((d, i) => (
                                        <TableRow key={i}>
                                          <TableCell>{d.nombreProducto}</TableCell>
                                          <TableCell>
                                            {[d.talla, d.color].filter(Boolean).join(" / ") || "—"}
                                          </TableCell>
                                          <TableCell>{d.cantidad}</TableCell>
                                          <TableCell>
                                            ${Number(d.precioUnitario).toLocaleString()}
                                          </TableCell>
                                          <TableCell>
                                            ${Number(d.subtotal).toLocaleString()}
                                          </TableCell>
                                        </TableRow>
                                      ))}
                                    </TableBody>
                                  </Table>
                                </div>
                              </TableCell>
                            </TableRow>
                          )}
                        </React.Fragment>
                      );
                    })
                  )}
                </TableBody>
              </Table>
            )}
          </CardContent>
        </Card>
      </div>

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-lg max-h-[85vh] flex flex-col p-0">
          <DialogHeader className="px-6 pt-6 pb-2">
            <DialogTitle>Nueva venta</DialogTitle>
          </DialogHeader>
          <div className="space-y-4 px-6 py-4 overflow-y-auto flex-1">
            <Tabs value={tipoComprador} onValueChange={setTipoComprador}>
              <TabsList>
                <TabsTrigger value={COMPRADOR_INTERNO}>Deportista del club</TabsTrigger>
                <TabsTrigger value={COMPRADOR_EXTERNO}>Comprador externo</TabsTrigger>
              </TabsList>
            </Tabs>

            {tipoComprador === COMPRADOR_INTERNO ? (
              <div className="grid gap-1.5">
                <Label>Deportista</Label>
                <Select value={personaId} onValueChange={setPersonaId}>
                  <SelectTrigger>
                    <SelectValue placeholder="Selecciona un deportista" />
                  </SelectTrigger>
                  <SelectContent>
                    {deportistas.map((d) => (
                      <SelectItem key={d.deportistaId} value={String(d.deportistaId)}>
                        {d.nombre} {d.apellidos}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            ) : (
              <div className="space-y-3">
                <div className="grid gap-1.5">
                  <Label>Nombre</Label>
                  <Input
                    value={nombreExterno}
                    onChange={(e) => setNombreExterno(e.target.value)}
                  />
                </div>
                <div className="grid gap-1.5">
                  <Label>Contacto</Label>
                  <Input
                    value={contactoExterno}
                    onChange={(e) => setContactoExterno(e.target.value)}
                    placeholder="Teléfono o email"
                  />
                </div>
              </div>
            )}

            <div className="grid gap-1.5">
              <Label>Método de pago</Label>
              <Select value={metodoPago} onValueChange={setMetodoPago}>
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Efectivo">Efectivo</SelectItem>
                  <SelectItem value="Transferencia">Transferencia</SelectItem>
                  <SelectItem value="Tarjeta">Tarjeta</SelectItem>
                </SelectContent>
              </Select>
            </div>

            <div className="border-t pt-4 space-y-3">
              <Label>Productos</Label>
              <div className="flex gap-2">
                <Select value={varianteParaAgregar} onValueChange={setVarianteParaAgregar}>
                  <SelectTrigger className="flex-1">
                    <SelectValue placeholder="Selecciona un producto" />
                  </SelectTrigger>
                  <SelectContent>
                    {variantes.map((v) => (
                      <SelectItem key={v.id} value={String(v.id)}>
                        {v.nombreProducto}
                        {v.talla ? ` - ${v.talla}` : ""}
                        {v.color ? ` - ${v.color}` : ""} (${Number(v.precioVenta).toLocaleString()})
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                <Input
                  type="number"
                  min={1}
                  className="w-20"
                  value={cantidadParaAgregar}
                  onChange={(e) => setCantidadParaAgregar(e.target.value)}
                />
                <Button variant="outline" onClick={agregarAlCarrito}>
                  Agregar
                </Button>
              </div>

              {carrito.length > 0 && (
                <Table>
                  <TableBody>
                    {carrito.map((item, i) => (
                      <TableRow key={i}>
                        <TableCell>{item.descripcion}</TableCell>
                        <TableCell>x{item.cantidad}</TableCell>
                        <TableCell>
                          ${(item.cantidad * item.precioUnitario).toLocaleString()}
                        </TableCell>
                        <TableCell>
                          <Button variant="ghost" size="sm" onClick={() => quitarDelCarrito(i)}>
                            <Trash2 className="h-4 w-4" />
                          </Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}

              {carrito.length > 0 && (
                <p className="text-right font-semibold">
                  Total: ${totalCarrito.toLocaleString()}
                </p>
              )}
            </div>
          </div>
          <DialogFooter className="px-6 pb-6 pt-3 border-t">
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardarVenta} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Registrar Venta
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </ProtectedRoute>
  );
}
</file>

