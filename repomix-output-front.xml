<file path="app/components/matricula/PasoDeportista.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Command,
  CommandInput,
  CommandList,
  CommandEmpty,
  CommandGroup,
  CommandItem,
} from "@/components/ui/command";
import { Avatar, AvatarFallback } from "@/components/ui/avatar";
import { Loader2, UserPlus } from "lucide-react";
import { api } from "@/lib/api";
import { toast } from "react-toastify";
import { DeportistaDisponible } from "@/app/lib/matricula";

function iniciales(nombre: string) {
  return nombre
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase())
    .join("");
}

export default function PasoDeportista({
  onSeleccionar,
}: {
  onSeleccionar: (deportista: DeportistaDisponible) => void;
}) {
  const [cargando, setCargando] = useState(true);
  const [deportistas, setDeportistas] = useState<DeportistaDisponible[]>([]);

  useEffect(() => {
    setCargando(true);
    api
      .get("/api/inscripciones/no-inscritos")
      .then((res) => {
        setDeportistas(
          res.data.map((d: any) => ({
            deportista_id: d.deportistaId,
            nombre_completo: d.nombreCompleto,
            nivel: d.nivel,
          })),
        );
      })
      .catch(() => toast.error("No se pudo cargar la lista de deportistas disponibles"))
      .finally(() => setCargando(false));
  }, []);

  return (
    <Command className="rounded-lg border">
      <CommandInput placeholder="Buscar deportista…" />
      <CommandList className="h-[320px]">
        {cargando ? (
          <div className="flex h-full items-center justify-center text-sm text-muted-foreground">
            <Loader2 className="mr-2 size-4 animate-spin" />
            Cargando…
          </div>
        ) : (
          <>
            <CommandEmpty className="py-8 text-center text-sm text-muted-foreground">
              <UserPlus className="mx-auto mb-2 size-6 opacity-40" />
              No hay deportistas registrados
              <br />
              pendientes de inscripción.
            </CommandEmpty>
            <CommandGroup>
              {deportistas.map((d) => (
                <CommandItem
                  key={d.deportista_id}
                  value={d.nombre_completo}
                  onSelect={() => onSeleccionar(d)}
                  className="flex items-center gap-2 py-2"
                >
                  <Avatar className="size-7">
                    <AvatarFallback className="bg-primary/10 text-[11px] font-medium text-primary">
                      {iniciales(d.nombre_completo)}
                    </AvatarFallback>
                  </Avatar>
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-sm font-medium leading-none">
                      {d.nombre_completo}
                    </p>
                    <p className="mt-1 text-xs text-muted-foreground">{d.nivel}</p>
                  </div>
                </CommandItem>
              ))}
            </CommandGroup>
          </>
        )}
      </CommandList>
    </Command>
  );
}
</file>

<file path="app/components/matricula/PasoGrupo.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Loader2, CheckCircle2, XCircle } from "lucide-react";
import { obtenerGruposElegibles, GrupoElegible } from "@/app/lib/matricula";
import { toast } from "react-toastify";

export default function PasoGrupo({
  deportistaId,
  guardando,
  onVolver,
  onConfirmar,
}: {
  deportistaId: number;
  guardando: boolean;
  onVolver: () => void;
  onConfirmar: (grupoId: number, grupoNombre: string) => Promise<void>;
}) {
  const [cargando, setCargando] = useState(true);
  const [elegibles, setElegibles] = useState<GrupoElegible[]>([]);
  const [noElegibles, setNoElegibles] = useState<GrupoElegible[]>([]);
  const [mostrarNoElegibles, setMostrarNoElegibles] = useState(false);

  useEffect(() => {
    setCargando(true);
    obtenerGruposElegibles(deportistaId)
      .then((data) => {
        setElegibles(data.elegibles);
        setNoElegibles(data.noElegibles);
      })
      .catch((err) => {
        toast.error(
          err.response?.data ?? "No se pudieron cargar los grupos elegibles",
        );
      })
      .finally(() => setCargando(false));
  }, [deportistaId]);

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-10 text-muted-foreground">
        <Loader2 className="h-5 w-5 animate-spin mr-2" /> Buscando grupos elegibles...
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {elegibles.length === 0 ? (
        <p className="text-sm text-muted-foreground py-6 text-center">
          No hay grupos elegibles para el nivel de este deportista todavía.
        </p>
      ) : (
        <div className="space-y-2 max-h-[320px] overflow-y-auto">
          {elegibles.map((g) => (
            <div
              key={g.grupoId}
              className="flex items-center justify-between border p-2 rounded"
            >
              <div className="flex items-center gap-2">
                <CheckCircle2 className="h-4 w-4 text-green-600 shrink-0" />
                <div>
                  <p className="font-medium">{g.nombreGrupo}</p>
                  <p className="text-sm text-gray-600">
                    {g.categoriaNivel}
                    {g.cupoMaximo != null ? ` · cupo ${g.cupoActual}/${g.cupoMaximo}` : ""}
                  </p>
                </div>
              </div>
              <Button
                size="sm"
                disabled={guardando}
                onClick={() => onConfirmar(g.grupoId, g.nombreGrupo)}
              >
                {guardando ? "Asignando..." : "Asignar"}
              </Button>
            </div>
          ))}
        </div>
      )}

      {noElegibles.length > 0 && (
        <div className="pt-2 border-t">
          <button
            type="button"
            className="text-sm text-muted-foreground hover:underline"
            onClick={() => setMostrarNoElegibles((v) => !v)}
          >
            {mostrarNoElegibles ? "Ocultar" : "Mostrar"} no elegibles ({noElegibles.length})
          </button>
          {mostrarNoElegibles && (
            <div className="space-y-2 mt-2 max-h-[180px] overflow-y-auto">
              {noElegibles.map((g) => (
                <div
                  key={g.grupoId}
                  className="flex items-center gap-2 border p-2 rounded bg-muted/40"
                >
                  <XCircle className="h-4 w-4 text-red-500 shrink-0" />
                  <div>
                    <p className="font-medium">{g.nombreGrupo}</p>
                    <p className="text-sm text-red-600">{g.motivo}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      <div className="flex justify-start pt-2 border-t mt-2">
        <Button variant="outline" onClick={onVolver} disabled={guardando}>
          Volver
        </Button>
      </div>
    </div>
  );
}
</file>

<file path="app/components/matricula/PasoPlanPago.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { CalendarDays, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import { DeportistaDisponible, FECHA_VALIDA, FECHA_MAXIMA } from "@/app/lib/matricula";

interface PlanPago {
  id: number;
  nombre: string;
}
interface Convenio {
  id: number;
  nombreEmpresa: string;
  descuento?: { nombre: string };
}

export default function PasoPlanPago({
  deportista,
  guardando,
  permitirVolver = true,
  onVolver,
  onConfirmar,
}: {
  deportista: DeportistaDisponible;
  guardando: boolean;
  // false cuando ya existe una inscripción creada para este deportista (p.
  // ej. volvimos aquí desde el paso Grupo): volver más atrás, a la búsqueda
  // de deportista, dejaría la inscripción "huérfana" de su selección.
  permitirVolver?: boolean;
  onVolver: () => void;
  onConfirmar: (payload: {
    planPagoId: number;
    planMensualidadId?: number;
    convenioId?: number;
    fechaVencimiento: string;
  }) => Promise<void>;
}) {
  const [cargando, setCargando] = useState(true);
  const [planesInscripcion, setPlanesInscripcion] = useState<PlanPago[]>([]);
  const [planesMensualidad, setPlanesMensualidad] = useState<PlanPago[]>([]);
  const [convenios, setConvenios] = useState<Convenio[]>([]);

  const [planSeleccionado, setPlanSeleccionado] = useState("");
  const [planMensualidadSeleccionado, setPlanMensualidadSeleccionado] = useState("");
  const [convenioSeleccionado, setConvenioSeleccionado] = useState("");
  const [fechaVencimiento, setFechaVencimiento] = useState(() => {
    const año = new Date().getFullYear();
    return new Date(año, 11, 31).toISOString().slice(0, 10);
  });

  useEffect(() => {
    setCargando(true);
    Promise.allSettled([
      api.get("/api/planes-pago", { params: { categoria: "inscripcion" } }),
      api.get("/api/planes-pago", { params: { categoria: "mensualidad" } }),
      api.get("/api/convenios"),
    ]).then(([resPlanes, resPlanesMensualidad, resConvenios]) => {
      if (resPlanes.status === "fulfilled") setPlanesInscripcion(resPlanes.value.data);
      else toast.error("No se pudieron cargar los planes de inscripción");

      if (resPlanesMensualidad.status === "fulfilled")
        setPlanesMensualidad(resPlanesMensualidad.value.data);
      else toast.error("No se pudieron cargar los planes de mensualidad");

      if (resConvenios.status === "fulfilled") setConvenios(resConvenios.value.data);

      setCargando(false);
    });
  }, []);

  const planActual = useMemo(
    () => planesInscripcion.find((p) => String(p.id) === planSeleccionado),
    [planesInscripcion, planSeleccionado],
  );

  const handleSubmit = async () => {
    if (!planSeleccionado) {
      toast.error("Selecciona un plan de inscripción");
      return;
    }
    if (!FECHA_VALIDA.test(fechaVencimiento)) {
      toast.error(
        "La fecha de vencimiento no es válida — revisa que el año tenga 4 dígitos.",
      );
      return;
    }
    await onConfirmar({
      planPagoId: Number(planSeleccionado),
      planMensualidadId: planMensualidadSeleccionado ? Number(planMensualidadSeleccionado) : undefined,
      convenioId: convenioSeleccionado ? Number(convenioSeleccionado) : undefined,
      fechaVencimiento,
    });
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-10 text-muted-foreground">
        <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando planes...
      </div>
    );
  }

  return (
    <div className="space-y-4">
      <div className="flex items-center gap-2">
        <span className="text-sm text-muted-foreground">Matriculando a</span>
        <Badge variant="outline">{deportista.nombre_completo}</Badge>
      </div>

      <div className="grid gap-1.5">
        <Label>Plan de inscripción</Label>
        <Select value={planSeleccionado} onValueChange={setPlanSeleccionado}>
          <SelectTrigger>
            <SelectValue placeholder="Selecciona un plan" />
          </SelectTrigger>
          <SelectContent>
            {planesInscripcion.map((plan) => (
              <SelectItem key={plan.id} value={String(plan.id)}>
                {plan.nombre}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      <div className="grid gap-1.5">
        <Label>
          Plan de mensualidad{" "}
          <span className="font-normal text-muted-foreground">(opcional)</span>
        </Label>
        <Select value={planMensualidadSeleccionado} onValueChange={setPlanMensualidadSeleccionado}>
          <SelectTrigger>
            <SelectValue placeholder="Sin mensualidad" />
          </SelectTrigger>
          <SelectContent>
            {planesMensualidad.map((plan) => (
              <SelectItem key={plan.id} value={String(plan.id)}>
                {plan.nombre}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      <div className="grid gap-1.5">
        <Label>
          Convenio <span className="font-normal text-muted-foreground">(opcional)</span>
        </Label>
        <Select value={convenioSeleccionado} onValueChange={setConvenioSeleccionado}>
          <SelectTrigger>
            <SelectValue placeholder="Sin convenio" />
          </SelectTrigger>
          <SelectContent>
            {convenios.map((c) => (
              <SelectItem key={c.id} value={String(c.id)}>
                {c.nombreEmpresa}
                {c.descuento?.nombre ? ` — ${c.descuento.nombre}` : ""}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      <div className="grid gap-1.5">
        <Label>Fecha de vencimiento</Label>
        <div className="relative">
          <CalendarDays className="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
          <Input
            type="date"
            className="pl-8"
            value={fechaVencimiento}
            min={new Date().toISOString().slice(0, 10)}
            max={FECHA_MAXIMA}
            onChange={(e) => setFechaVencimiento(e.target.value)}
          />
        </div>
      </div>

      {planActual && (
        <p className="text-xs text-muted-foreground">
          Se inscribirá con el plan {planActual.nombre}, vigente hasta el {fechaVencimiento}.
        </p>
      )}

      <div className="flex justify-between pt-2">
        {permitirVolver ? (
          <Button variant="outline" onClick={onVolver} disabled={guardando}>
            Volver
          </Button>
        ) : (
          <span />
        )}
        <Button onClick={handleSubmit} disabled={!planSeleccionado || guardando}>
          {guardando ? (
            <>
              <Loader2 className="mr-2 size-4 animate-spin" /> Guardando…
            </>
          ) : (
            "Guardar y continuar"
          )}
        </Button>
      </div>
    </div>
  );
}
