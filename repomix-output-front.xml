                    deportistas
                  </CardDescription>
                </div>
                <ProtectedRoute requiredPermission="crear_nivel">
                  <Button onClick={abrirModal}>
                    <Plus className="mr-2 h-4 w-4" /> Nuevo Nivel
                  </Button>
                </ProtectedRoute>
              </CardHeader>
              <CardContent>
                <div className="flex justify-between mb-4">
                  <div className="flex items-center space-x-2 w-full max-w-sm">
                    <Input
                      placeholder="Buscar niveles..."
                      value={searchTerm}
                      onChange={(e) => setSearchTerm(e.target.value)}
                      className="h-9"
                    />
                  </div>
                  <div className="flex space-x-2">
                    {/*
                  <Button variant="outline" size="sm">
                    <Download className="mr-2 h-4 w-4" />
                    Exportar
                  </Button>*/}
                  </div>
                </div>

                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead className="w-[50px]"></TableHead>
                      <TableHead>Nivel</TableHead>
                      <TableHead>Descripción</TableHead>
                      <TableHead>Categorías</TableHead>
                      <TableHead>Accion</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {filteredNiveles.map((nivel) => {
                      const categorias = nivel.categorias || [];

                      return (
                        <React.Fragment key={nivel.id}>
                          {/* Fila del nivel */}
                          <TableRow>
                            <TableCell>
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => toggleNivelExpand(nivel.id)}
                              >
                                {expandedNiveles.includes(nivel.id) ? (
                                  <ChevronDown className="h-4 w-4" />
                                ) : (
                                  <ChevronRight className="h-4 w-4" />
                                )}
                              </Button>
                            </TableCell>
                            <TableCell>
                              <div className="flex items-center">
                                <span className="font-medium">
                                  {nivel.nombre}
                                </span>
                              </div>
                            </TableCell>
                            <TableCell>
                              {nivel.descripcion || "Sin descripción"}
                            </TableCell>
                            <TableCell>
                              <Badge variant="outline">
                                {categorias.length}
                              </Badge>
                            </TableCell>
                            <TableCell>
                              <div className="flex space-x-2">
                                {/*
                              <Button variant="outline" size="sm">
                                <Pencil className="h-4 w-4 mr-1" /> Editar
                              </Button>*/}
                                <ProtectedRoute requiredPermission="eliminar_nivel">
                                  <Button
                                    variant="destructive"
                                    size="sm"
                                    onClick={() =>
                                      abrirDialogoEliminar(nivel.id)
                                    }
                                  >
                                    <Trash2 className="mr-2 h-4 w-4" />
                                    Eliminar
                                  </Button>
                                </ProtectedRoute>
                              </div>
                            </TableCell>
                          </TableRow>

                          {/* Subtabla de categorías */}
                          {expandedNiveles.includes(nivel.id) && (
                            <TableRow
                              key={`${nivel.id}-categorias`}
                              className="bg-muted/50"
                            >
                              <TableCell colSpan={5} className="p-0">
                                <div className="p-4">
                                  <div className="flex justify-between items-center mb-2">
                                    <h3 className="font-semibold">
                                      Categorías en {nivel.nombre}
                                    </h3>
                                  </div>
                                  <Table>
                                    <TableHeader>
                                      <TableRow>
                                        <TableHead>Nombre</TableHead>
                                        <TableHead>División</TableHead>
                                        <TableHead>Año Nacimiento</TableHead>
                                        <TableHead>Cantidad</TableHead>
                                        <TableHead>Restricciones</TableHead>
                                      </TableRow>
                                    </TableHeader>
                                    <TableBody>
                                      {categorias.map((categoria) => (
                                        <TableRow key={categoria.id}>
                                          <TableCell className="font-medium">
                                            {categoria.nombre}
                                          </TableCell>
                                          <TableCell>
                                            {categoria.division}
                                          </TableCell>
                                          <TableCell>
                                            {categoria.añoNacimientoMin
                                              ? categoria.añoNacimientoMax
                                                ? `${categoria.añoNacimientoMin} a ${categoria.añoNacimientoMax}`
                                                : `${categoria.añoNacimientoMin} en adelante`
                                              : categoria.añoNacimientoMax
                                              ? `Hasta ${categoria.añoNacimientoMax}`
                                              : "Sin restricción"}
                                          </TableCell>
                                          <TableCell>
                                            {categoria.cantidadMin} a{" "}
                                            {categoria.cantidadMax} deportistas
                                          </TableCell>
                                          <TableCell>
                                            {categoria.restricciones}
                                          </TableCell>
                                        </TableRow>
                                      ))}
                                    </TableBody>
                                  </Table>
                                </div>
                              </TableCell>
                            </TableRow>
                          )}
                        </React.Fragment>
                      );
                    })}
                  </TableBody>
                </Table>
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
        {/* Pestaña de Categorías */}
        <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>Crear Nuevo Nivel</DialogTitle>
            </DialogHeader>
            <div className="grid gap-4 py-4">
              <div className="grid grid-cols-4 items-center gap-4">
                <Label htmlFor="nombre" className="text-right">
                  Nombre
                </Label>
                <Input
                  id="nombre"
                  className="col-span-3"
                  value={nombre}
                  onChange={(e) => setNombre(e.target.value)}
                />
              </div>
              <div className="grid grid-cols-4 items-center gap-4">
                <Label className="text-right">Categoría</Label>
                <Select value={categoriaId} onValueChange={setCategoriaId}>
                  <SelectTrigger className="col-span-3">
                    <SelectValue placeholder="Seleccionar categoría" />
                  </SelectTrigger>
                  <SelectContent>
                    {categorias.map((cat) => (
                      <SelectItem key={cat.id} value={cat.id.toString()}>
