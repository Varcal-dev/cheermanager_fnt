<file path="app/components/eventos/PremiosEventoPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Award, Pencil, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

export interface PremioEvento {
  id: number;
  eventoId: number;
  descripcion: string;
  premio: string;
}

const FORM_VACIO = { descripcion: "", premio: "" };

export default function PremiosEventoPanel({ eventoId }: { eventoId: number }) {
  const [cargando, setCargando] = useState(true);
  const [premios, setPremios] = useState<PremioEvento[]>([]);
  const [modalAbierto, setModalAbierto] = useState(false);
  const [premioEnEdicion, setPremioEnEdicion] = useState<PremioEvento | null>(null);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    api
      .get(`/api/premios-evento/evento/${eventoId}`)
      .then((res) => setPremios(res.data))
      .catch(() => toast.error("No se pudieron cargar los premios"))
      .finally(() => setCargando(false));
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [eventoId]);

  const abrirNuevo = () => {
    setPremioEnEdicion(null);
    setForm(FORM_VACIO);
    setModalAbierto(true);
  };

  const abrirEdicion = (premio: PremioEvento) => {
    setPremioEnEdicion(premio);
    setForm({ descripcion: premio.descripcion, premio: premio.premio });
    setModalAbierto(true);
  };

  const guardar = async () => {
    if (!form.descripcion.trim() || !form.premio.trim()) {
      toast.error("Descripción y premio son obligatorios");
      return;
    }
    setGuardando(true);
    try {
      if (premioEnEdicion) {
        await api.put(`/api/premios-evento/${premioEnEdicion.id}`, {
          eventoId,
          ...form,
        });
        toast.success("Premio actualizado");
      } else {
        await api.post("/api/premios-evento", { eventoId, ...form });
        toast.success("Premio agregado");
      }
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el premio",
      );
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async (id: number) => {
    if (!confirm("¿Eliminar este premio?")) return;
    try {
      await api.delete(`/api/premios-evento/${id}`);
      toast.success("Premio eliminado");
      cargar();
    } catch {
      toast.error("No se pudo eliminar el premio");
    }
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex justify-end">
        <Button size="sm" variant="outline" onClick={abrirNuevo}>
          <Award className="h-4 w-4 mr-1" /> Nuevo Premio
        </Button>
      </div>

      {premios.length === 0 ? (
        <p className="text-center py-4 text-muted-foreground">
          Ningún premio registrado todavía.
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Descripción</TableHead>
              <TableHead>Premio</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {premios.map((p) => (
              <TableRow key={p.id}>
                <TableCell>{p.descripcion}</TableCell>
                <TableCell>{p.premio}</TableCell>
                <TableCell>
                  <div className="flex space-x-2">
                    <Button variant="outline" size="sm" onClick={() => abrirEdicion(p)}>
                      <Pencil className="h-4 w-4 mr-1" /> Editar
                    </Button>
                    <Button variant="destructive" size="sm" onClick={() => eliminar(p.id)}>
                      <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>{premioEnEdicion ? "Editar premio" : "Nuevo premio"}</DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid gap-1.5">
              <Label>Descripción</Label>
              <Input
                value={form.descripcion}
                onChange={(e) => setForm({ ...form, descripcion: e.target.value })}
                placeholder="Ej. 1er lugar Nivel 3 Youth"
              />
            </div>
            <div className="grid gap-1.5">
              <Label>Premio</Label>
              <Input
                value={form.premio}
                onChange={(e) => setForm({ ...form, premio: e.target.value })}
                placeholder="Ej. Trofeo + beca 20% próxima temporada"
              />
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="app/components/eventos/ResultadosEventoPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Trophy, Pencil, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface Resultado {
  id: number;
  eventoId: number;
  grupoEntrenamientoId: number;
  nombreGrupo: string;
  posicion: number;
  puntaje: number;
  premioId: number | null;
  descripcionPremio: string | null;
  observaciones: string;
}

interface GrupoEvento {
  id: number;
  grupoEntrenamientoId: number;
  nombreGrupo: string;
}

interface PremioEvento {
  id: number;
  descripcion: string;
  premio: string;
}

const FORM_VACIO = {
  grupoEntrenamientoId: "",
  posicion: "",
  puntaje: "",
  premioId: "",
  observaciones: "",
};

export default function ResultadosEventoPanel({ eventoId }: { eventoId: number }) {
  const [cargando, setCargando] = useState(true);
  const [resultados, setResultados] = useState<Resultado[]>([]);
  const [gruposInscritos, setGruposInscritos] = useState<GrupoEvento[]>([]);
  const [premios, setPremios] = useState<PremioEvento[]>([]);

  const [modalAbierto, setModalAbierto] = useState(false);
  const [resultadoEnEdicion, setResultadoEnEdicion] = useState<Resultado | null>(null);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    Promise.allSettled([
      api.get(`/api/resultados-competencia/evento/${eventoId}`),
      api.get(`/api/grupos-evento/evento/${eventoId}`),
      api.get(`/api/premios-evento/evento/${eventoId}`),
    ]).then(([resResultados, resGrupos, resPremios]) => {
      if (resResultados.status === "fulfilled") setResultados(resResultados.value.data);
      else toast.error("No se pudieron cargar los resultados");

      if (resGrupos.status === "fulfilled") setGruposInscritos(resGrupos.value.data);
      if (resPremios.status === "fulfilled") setPremios(resPremios.value.data);

      setCargando(false);
    });
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [eventoId]);

  const abrirNuevo = () => {
    setResultadoEnEdicion(null);
    setForm(FORM_VACIO);
    setModalAbierto(true);
  };

  const abrirEdicion = (r: Resultado) => {
    setResultadoEnEdicion(r);
    setForm({
      grupoEntrenamientoId: String(r.grupoEntrenamientoId),
      posicion: String(r.posicion),
      puntaje: String(r.puntaje),
      premioId: r.premioId ? String(r.premioId) : "",
      observaciones: r.observaciones ?? "",
    });
    setModalAbierto(true);
  };

  const guardar = async () => {
    if (!form.grupoEntrenamientoId || !form.posicion || !form.puntaje) {
      toast.error("Grupo, posición y puntaje son obligatorios");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        eventoId,
        grupoEntrenamientoId: Number(form.grupoEntrenamientoId),
        posicion: Number(form.posicion),
        puntaje: Number(form.puntaje),
        premioId: form.premioId ? Number(form.premioId) : null,
        observaciones: form.observaciones,
      };
      if (resultadoEnEdicion) {
        await api.put(`/api/resultados-competencia/${resultadoEnEdicion.id}`, payload);
        toast.success("Resultado actualizado");
      } else {
        await api.post("/api/resultados-competencia", payload);
        toast.success("Resultado registrado");
      }
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el resultado",
      );
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async (id: number) => {
    if (!confirm("¿Eliminar este resultado?")) return;
    try {
      await api.delete(`/api/resultados-competencia/${id}`);
      toast.success("Resultado eliminado");
      cargar();
    } catch {
      toast.error("No se pudo eliminar el resultado");
    }
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex justify-end">
        <Button size="sm" variant="outline" onClick={abrirNuevo} disabled={gruposInscritos.length === 0}>
          <Trophy className="h-4 w-4 mr-1" /> Registrar Resultado
        </Button>
      </div>
      {gruposInscritos.length === 0 && (
        <p className="text-xs text-muted-foreground text-right">
          Primero inscribe al menos un grupo en la pestaña "Grupos".
        </p>
      )}

      {resultados.length === 0 ? (
        <p className="text-center py-4 text-muted-foreground">
          Ningún resultado registrado todavía.
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Posición</TableHead>
              <TableHead>Grupo</TableHead>
              <TableHead>Puntaje</TableHead>
              <TableHead>Premio</TableHead>
              <TableHead>Observaciones</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {resultados
              .slice()
              .sort((a, b) => a.posicion - b.posicion)
              .map((r) => (
                <TableRow key={r.id}>
                  <TableCell className="font-medium">#{r.posicion}</TableCell>
                  <TableCell>{r.nombreGrupo}</TableCell>
                  <TableCell>{r.puntaje}</TableCell>
                  <TableCell>{r.descripcionPremio ?? "—"}</TableCell>
                  <TableCell>{r.observaciones}</TableCell>
                  <TableCell>
                    <div className="flex space-x-2">
                      <Button variant="outline" size="sm" onClick={() => abrirEdicion(r)}>
                        <Pencil className="h-4 w-4 mr-1" /> Editar
                      </Button>
                      <Button variant="destructive" size="sm" onClick={() => eliminar(r.id)}>
                        <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                      </Button>
                    </div>
                  </TableCell>
                </TableRow>
              ))}
          </TableBody>
        </Table>
      )}

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>
              {resultadoEnEdicion ? "Editar resultado" : "Registrar resultado"}
            </DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid gap-1.5">
              <Label>Grupo</Label>
              <Select
                value={form.grupoEntrenamientoId}
                onValueChange={(v) => setForm({ ...form, grupoEntrenamientoId: v })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un grupo" />
                </SelectTrigger>
                <SelectContent>
                  {gruposInscritos.map((g) => (
                    <SelectItem key={g.grupoEntrenamientoId} value={String(g.grupoEntrenamientoId)}>
                      {g.nombreGrupo}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="flex gap-4">
              <div className="flex-1 grid gap-1.5">
                <Label>Posición</Label>
                <Input
                  type="number"
                  min={1}
                  value={form.posicion}
                  onChange={(e) => setForm({ ...form, posicion: e.target.value })}
                />
              </div>
              <div className="flex-1 grid gap-1.5">
                <Label>Puntaje</Label>
                <Input
                  type="number"
                  step={0.01}
                  value={form.puntaje}
                  onChange={(e) => setForm({ ...form, puntaje: e.target.value })}
                />
              </div>
            </div>
            <div className="grid gap-1.5">
              <Label>
                Premio <span className="font-normal text-muted-foreground">(opcional)</span>
              </Label>
              <Select
                value={form.premioId}
                onValueChange={(v) => setForm({ ...form, premioId: v })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Sin premio asociado" />
                </SelectTrigger>
                <SelectContent>
                  {premios.map((p) => (
                    <SelectItem key={p.id} value={String(p.id)}>
                      {p.descripcion}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="grid gap-1.5">
              <Label>Observaciones</Label>
              <Textarea
                value={form.observaciones}
                onChange={(e) => setForm({ ...form, observaciones: e.target.value })}
              />
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="app/components/Forms/AsignarDeportistasModal.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { CheckCircle2, Loader2, Search, XCircle } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface Candidato {
  deportistaId: number;
  nombreCompleto: string;
  genero: string;
  nivel: string;
  edad: number | null;
  elegible: boolean;
  motivo: string | null;
}

interface CandidatosResponse {
  grupoNombre: string;
  cupoActual: number;
  cupoMaximo: number | null;
  elegibles: Candidato[];
  noElegibles: Candidato[];
}

export default function AsignarDeportistasModal({
  grupoId,
  grupoNombre,
  open,
  onOpenChange,
  onDeportistaAgregado,
}: {
  grupoId: number;
  grupoNombre: string;
  open: boolean;
  onOpenChange: (open: boolean) => void;
  onDeportistaAgregado: () => void;
}) {
  const [loading, setLoading] = useState(true);
  const [data, setData] = useState<CandidatosResponse | null>(null);
  const [search, setSearch] = useState("");
  const [addingId, setAddingId] = useState<number | null>(null);
  const [mostrarNoElegibles, setMostrarNoElegibles] = useState(false);

  const fetchCandidatos = () => {
    setLoading(true);
    api
      .get(`/api/grupos/${grupoId}/candidatos`)
      .then((res) => setData(res.data))
      .catch((err) => {
        console.error("Error cargando candidatos:", err);
        toast.error("No se pudo cargar la lista de candidatos");
      })
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    if (open) {
      setSearch("");
      setMostrarNoElegibles(false);
      fetchCandidatos();
    }
  }, [open, grupoId]);

  const handleAdd = async (candidato: Candidato) => {
    setAddingId(candidato.deportistaId);
    try {
      const response = await api.post(`/api/grupos/${grupoId}/agregar-deportistas`, {
        deportistaId: candidato.deportistaId,
        observaciones: "",
      });
      // El backend devuelve un string plano, no un objeto { mensaje }.
      toast.success(response.data || "Deportista añadido correctamente");

      // Se quita de la lista local (en vez de cerrar el modal) para poder
      // seguir añadiendo al siguiente deportista sin reabrir nada.
      setData((prev) =>
        prev
          ? {
              ...prev,
              cupoActual: prev.cupoActual + 1,
              elegibles: prev.elegibles.filter(
                (d) => d.deportistaId !== candidato.deportistaId,
              ),
            }
          : prev,
      );
      onDeportistaAgregado();

      // Si con esta asignación el grupo llegó al cupo máximo, refrescamos
      // para que el resto de elegibles pase a "no elegible: cupo lleno".
      if (data?.cupoMaximo != null && data.cupoActual + 1 >= data.cupoMaximo) {
        fetchCandidatos();
      }
    } catch (error: any) {
      console.error("Error al agregar deportista:", error);
      toast.error(
        error.response?.data ?? "Error al agregar deportista. Intenta de nuevo.",
      );
    } finally {
      setAddingId(null);
    }
  };

  const filtro = (lista: Candidato[]) =>
    lista.filter((d) =>
      d.nombreCompleto.toLowerCase().includes(search.toLowerCase()),
    );

  const elegiblesFiltrados = useMemo(
    () => (data ? filtro(data.elegibles) : []),
    [data, search],
  );
  const noElegiblesFiltrados = useMemo(
    () => (data ? filtro(data.noElegibles) : []),
    [data, search],
  );

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-2xl">
        <DialogHeader>
          <DialogTitle>Añadir deportistas a: {grupoNombre}</DialogTitle>
        </DialogHeader>

        {loading ? (
          <div className="flex items-center justify-center py-10 text-muted-foreground">
            <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando candidatos...
          </div>
        ) : data ? (
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2 flex-1">
                <Search className="h-4 w-4 text-muted-foreground" />
                <Input
                  placeholder="Buscar deportista..."
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  className="h-9"
                />
              </div>
              {data.cupoMaximo != null && (
                <Badge
                  variant="outline"
                  className={
                    data.cupoActual >= data.cupoMaximo
                      ? "ml-3 bg-red-50 text-red-700 border-red-200"
                      : "ml-3"
                  }
                >
                  Cupo: {data.cupoActual}/{data.cupoMaximo}
                </Badge>
              )}
            </div>

            <div className="space-y-2 max-h-[360px] overflow-y-auto">
              {elegiblesFiltrados.length === 0 ? (
                <p className="text-sm text-muted-foreground py-6 text-center">
                  No hay deportistas elegibles disponibles para este grupo.
                </p>
              ) : (
                elegiblesFiltrados.map((d) => (
                  <div
                    key={d.deportistaId}
                    className="flex items-center justify-between border p-2 rounded"
                  >
                    <div className="flex items-center gap-2">
                      <CheckCircle2 className="h-4 w-4 text-green-600 shrink-0" />
                      <div>
                        <p className="font-medium">{d.nombreCompleto}</p>
                        <p className="text-sm text-gray-600">
                          {d.genero} · {d.nivel}
                          {d.edad != null ? ` · ${d.edad} años` : ""}
                        </p>
                      </div>
                    </div>
                    <Button
                      size="sm"
                      variant="secondary"
                      disabled={addingId === d.deportistaId}
                      onClick={() => handleAdd(d)}
                    >
                      {addingId === d.deportistaId ? "Añadiendo..." : "Añadir"}
                    </Button>
                  </div>
                ))
              )}
            </div>

            {noElegiblesFiltrados.length > 0 && (
              <div className="pt-2 border-t">
                <button
                  type="button"
                  className="text-sm text-muted-foreground hover:underline"
                  onClick={() => setMostrarNoElegibles((v) => !v)}
                >
                  {mostrarNoElegibles ? "Ocultar" : "Mostrar"} no elegibles (
                  {noElegiblesFiltrados.length})
                </button>

                {mostrarNoElegibles && (
                  <div className="space-y-2 mt-2 max-h-[200px] overflow-y-auto">
                    {noElegiblesFiltrados.map((d) => (
                      <div
                        key={d.deportistaId}
                        className="flex items-center justify-between border p-2 rounded bg-muted/40"
                      >
                        <div className="flex items-center gap-2">
                          <XCircle className="h-4 w-4 text-red-500 shrink-0" />
                          <div>
                            <p className="font-medium">{d.nombreCompleto}</p>
                            <p className="text-sm text-red-600">{d.motivo}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>
        ) : null}
      </DialogContent>
    </Dialog>
  );
}
