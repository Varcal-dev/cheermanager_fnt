interface PremioEvento {
  id: number;
  descripcion: string;
  premio: string;
}

const FORM_VACIO = {
  grupoEntrenamientoId: "",
  posicion: "",
  puntaje: "",
  premioId: "",
  observaciones: "",
};

export default function ResultadosEventoPanel({ eventoId }: { eventoId: number }) {
  const [cargando, setCargando] = useState(true);
  const [resultados, setResultados] = useState<Resultado[]>([]);
  const [gruposInscritos, setGruposInscritos] = useState<GrupoEvento[]>([]);
  const [premios, setPremios] = useState<PremioEvento[]>([]);

  const [modalAbierto, setModalAbierto] = useState(false);
  const [resultadoEnEdicion, setResultadoEnEdicion] = useState<Resultado | null>(null);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    Promise.allSettled([
      api.get(`/api/resultados-competencia/evento/${eventoId}`),
      api.get(`/api/grupos-evento/evento/${eventoId}`),
      api.get(`/api/premios-evento/evento/${eventoId}`),
    ]).then(([resResultados, resGrupos, resPremios]) => {
      if (resResultados.status === "fulfilled") setResultados(resResultados.value.data);
      else toast.error("No se pudieron cargar los resultados");

      if (resGrupos.status === "fulfilled") setGruposInscritos(resGrupos.value.data);
      if (resPremios.status === "fulfilled") setPremios(resPremios.value.data);

      setCargando(false);
    });
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [eventoId]);

  const abrirNuevo = () => {
    setResultadoEnEdicion(null);
    setForm(FORM_VACIO);
    setModalAbierto(true);
  };

  const abrirEdicion = (r: Resultado) => {
    setResultadoEnEdicion(r);
    setForm({
      grupoEntrenamientoId: String(r.grupoEntrenamientoId),
      posicion: String(r.posicion),
      puntaje: String(r.puntaje),
      premioId: r.premioId ? String(r.premioId) : "",
      observaciones: r.observaciones ?? "",
    });
    setModalAbierto(true);
  };

  const guardar = async () => {
    if (!form.grupoEntrenamientoId || !form.posicion || !form.puntaje) {
      toast.error("Grupo, posición y puntaje son obligatorios");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        eventoId,
        grupoEntrenamientoId: Number(form.grupoEntrenamientoId),
        posicion: Number(form.posicion),
        puntaje: Number(form.puntaje),
        premioId: form.premioId ? Number(form.premioId) : null,
        observaciones: form.observaciones,
      };
      if (resultadoEnEdicion) {
        await api.put(`/api/resultados-competencia/${resultadoEnEdicion.id}`, payload);
        toast.success("Resultado actualizado");
      } else {
        await api.post("/api/resultados-competencia", payload);
        toast.success("Resultado registrado");
      }
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el resultado",
      );
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async (id: number) => {
    if (!confirm("¿Eliminar este resultado?")) return;
    try {
      await api.delete(`/api/resultados-competencia/${id}`);
      toast.success("Resultado eliminado");
      cargar();
    } catch {
      toast.error("No se pudo eliminar el resultado");
    }
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex justify-end">
        <Button size="sm" variant="outline" onClick={abrirNuevo} disabled={gruposInscritos.length === 0}>
          <Trophy className="h-4 w-4 mr-1" /> Registrar Resultado
        </Button>
      </div>
      {gruposInscritos.length === 0 && (
        <p className="text-xs text-muted-foreground text-right">
          Primero inscribe al menos un grupo en la pestaña "Grupos".
        </p>
      )}

      {resultados.length === 0 ? (
        <p className="text-center py-4 text-muted-foreground">
          Ningún resultado registrado todavía.
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Posición</TableHead>
              <TableHead>Grupo</TableHead>
              <TableHead>Puntaje</TableHead>
              <TableHead>Premio</TableHead>
              <TableHead>Observaciones</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {resultados
              .slice()
              .sort((a, b) => a.posicion - b.posicion)
              .map((r) => (
                <TableRow key={r.id}>
                  <TableCell className="font-medium">#{r.posicion}</TableCell>
                  <TableCell>{r.nombreGrupo}</TableCell>
                  <TableCell>{r.puntaje}</TableCell>
                  <TableCell>{r.descripcionPremio ?? "—"}</TableCell>
                  <TableCell>{r.observaciones}</TableCell>
                  <TableCell>
                    <div className="flex space-x-2">
                      <Button variant="outline" size="sm" onClick={() => abrirEdicion(r)}>
                        <Pencil className="h-4 w-4 mr-1" /> Editar
                      </Button>
                      <Button variant="destructive" size="sm" onClick={() => eliminar(r.id)}>
                        <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                      </Button>
                    </div>
                  </TableCell>
                </TableRow>
              ))}
          </TableBody>
        </Table>
      )}

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>
              {resultadoEnEdicion ? "Editar resultado" : "Registrar resultado"}
            </DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid gap-1.5">
              <Label>Grupo</Label>
              <Select
                value={form.grupoEntrenamientoId}
                onValueChange={(v) => setForm({ ...form, grupoEntrenamientoId: v })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un grupo" />
                </SelectTrigger>
                <SelectContent>
                  {gruposInscritos.map((g) => (
                    <SelectItem key={g.grupoEntrenamientoId} value={String(g.grupoEntrenamientoId)}>
                      {g.nombreGrupo}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="flex gap-4">
              <div className="flex-1 grid gap-1.5">
                <Label>Posición</Label>
                <Input
                  type="number"
                  min={1}
                  value={form.posicion}
                  onChange={(e) => setForm({ ...form, posicion: e.target.value })}
                />
              </div>
              <div className="flex-1 grid gap-1.5">
                <Label>Puntaje</Label>
                <Input
                  type="number"
                  step={0.01}
                  value={form.puntaje}
                  onChange={(e) => setForm({ ...form, puntaje: e.target.value })}
                />
              </div>
            </div>
            <div className="grid gap-1.5">
              <Label>
                Premio <span className="font-normal text-muted-foreground">(opcional)</span>
              </Label>
              <Select
                value={form.premioId}
                onValueChange={(v) => setForm({ ...form, premioId: v })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Sin premio asociado" />
                </SelectTrigger>
                <SelectContent>
                  {premios.map((p) => (
                    <SelectItem key={p.id} value={String(p.id)}>
                      {p.descripcion}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="grid gap-1.5">
              <Label>Observaciones</Label>
              <Textarea
                value={form.observaciones}
                onChange={(e) => setForm({ ...form, observaciones: e.target.value })}
              />
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="components/matricula/EditarInscripcionModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface PlanPago {
  id: number;
  nombre: string;
}

export default function EditarInscripcionModal({
  open,
  onOpenChange,
  inscripcionId,
  nombreDeportista,
  fechaInscripcion,
  onActualizado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  inscripcionId: number | null;
  // La lista de Inscripciones ya conoce estos dos datos (vienen de
  // InscripcionDetalleDto, ya probado) — se los pasamos en vez de
  // volver a derivarlos del GET /{id}, que devuelve el entity crudo
  // con una forma anidada distinta.
  nombreDeportista: string;
  fechaInscripcion: string;
  onActualizado: () => void;
}) {
  const [cargando, setCargando] = useState(true);
  const [guardando, setGuardando] = useState(false);

  const [planesInscripcion, setPlanesInscripcion] = useState<PlanPago[]>([]);
  const [planesMensualidad, setPlanesMensualidad] = useState<PlanPago[]>([]);

  const [planSeleccionado, setPlanSeleccionado] = useState("");
  const [planMensualidadSeleccionado, setPlanMensualidadSeleccionado] = useState("");
  const [fechaVencimiento, setFechaVencimiento] = useState("");
  const [estado, setEstado] = useState("Activa");

  useEffect(() => {
    if (!open || !inscripcionId) return;

    setCargando(true);
    Promise.allSettled([
      api.get(`/api/inscripciones/${inscripcionId}`),
      api.get("/api/planes-pago", { params: { categoria: "inscripcion" } }),
      api.get("/api/planes-pago", { params: { categoria: "mensualidad" } }),
    ]).then(([resInscripcion, resPlanes, resPlanesMensualidad]) => {
      if (resInscripcion.status === "fulfilled") {
        const data = resInscripcion.value.data;
        setPlanSeleccionado(data.planPago?.id ? String(data.planPago.id) : "");
        setPlanMensualidadSeleccionado(
          data.planMensualidad?.id ? String(data.planMensualidad.id) : "",
        );
        setFechaVencimiento(data.fechaVencimiento ?? "");
        setEstado(data.estado ?? "Activa");
      } else {
        toast.error("No se pudo cargar la inscripción");
      }

      if (resPlanes.status === "fulfilled") setPlanesInscripcion(resPlanes.value.data);
      if (resPlanesMensualidad.status === "fulfilled")
        setPlanesMensualidad(resPlanesMensualidad.value.data);

      setCargando(false);
    });
  }, [open, inscripcionId]);

  const handleSubmit = async () => {
    if (!inscripcionId || !planSeleccionado) return;

    // Salvavidas: si por algún motivo no tenemos la fecha de inscripción
    // original, no mandamos el PUT — el backend la rechazaría igual (la
    // columna es NOT NULL) pero preferimos avisar claro aquí en vez de
    // dejar que llegue como error de base de datos.
    if (!fechaInscripcion) {
      toast.error(
        "No se pudo determinar la fecha de inscripción original. Cierra y vuelve a intentar.",
      );
      return;
    }

    setGuardando(true);
    try {
      await api.put(`/api/inscripciones/${inscripcionId}`, {
        planPago: { id: Number(planSeleccionado) },
        planMensualidad: planMensualidadSeleccionado
          ? { id: Number(planMensualidadSeleccionado) }
          : null,
        fechaInscripcion,
        fechaVencimiento,
        estado,
      });
      toast.success("Inscripción actualizada correctamente");
      onOpenChange(false);
      onActualizado();
    } catch (error: any) {
      // El backend rechaza el cambio de plan con un mensaje claro si la
      // factura ya tiene pagos registrados — se lo mostramos tal cual.
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo actualizar la inscripción",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>Editar inscripción</DialogTitle>
        </DialogHeader>

        {cargando ? (
          <div className="flex items-center justify-center py-10 text-muted-foreground">
            <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
          </div>
        ) : (
          <div className="space-y-4 py-2">
            <p className="text-sm text-muted-foreground">
              Editando la inscripción de <strong>{nombreDeportista}</strong>
            </p>

            <div className="grid gap-1.5">
              <Label>Plan de inscripción</Label>
              <Select value={planSeleccionado} onValueChange={setPlanSeleccionado}>
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un plan" />
                </SelectTrigger>
                <SelectContent>
                  {planesInscripcion.map((plan) => (
                    <SelectItem key={plan.id} value={String(plan.id)}>
                      {plan.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              <p className="text-xs text-muted-foreground">
                Si esta inscripción ya tiene pagos registrados, cambiar el
                plan será rechazado por el sistema.
              </p>
            </div>

            <div className="grid gap-1.5">
              <Label>
                Plan de mensualidad{" "}
                <span className="font-normal text-muted-foreground">(opcional)</span>
              </Label>
              <Select
                value={planMensualidadSeleccionado}
                onValueChange={setPlanMensualidadSeleccionado}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Sin mensualidad" />
                </SelectTrigger>
                <SelectContent>
                  {planesMensualidad.map((plan) => (
                    <SelectItem key={plan.id} value={String(plan.id)}>
                      {plan.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            <div className="grid gap-1.5">
              <Label>Fecha de vencimiento</Label>
              <Input
                type="date"
                value={fechaVencimiento}
                onChange={(e) => setFechaVencimiento(e.target.value)}
              />
            </div>

            <div className="grid gap-1.5">
              <Label>Estado</Label>
              <Select value={estado} onValueChange={setEstado}>
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Activa">Activa</SelectItem>
                  <SelectItem value="Inactiva">Inactiva</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
        )}

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={guardando}>
            Cancelar
          </Button>
          <Button onClick={handleSubmit} disabled={cargando || guardando || !planSeleccionado}>
            {guardando ? (
              <>
                <Loader2 className="mr-2 h-4 w-4 animate-spin" /> Guardando…
              </>
            ) : (
              "Guardar cambios"
            )}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/matricula/MatriculaWizard.tsx">
"use client";

import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { UserPlus, Check } from "lucide-react";
import { useMatriculaState } from "./useMatriculaState";
import { EstadoMatricula, PasoMatricula } from "@/app/lib/matricula";
import PasoDeportista from "./PasoDeportista";
import PasoPlanPago from "./PasoPlanPago";
import PasoGrupo from "./PasoGrupo";
import PasoConfirmacion from "./PasoConfirmacion";

const PASOS: { id: PasoMatricula; label: string }[] = [
  { id: "deportista", label: "Deportista" },
  { id: "plan", label: "Plan de pago" },
  { id: "grupo", label: "Grupo" },
  { id: "confirmacion", label: "Confirmar" },
];

export default function MatriculaWizard({
  open,
  onOpenChange,
  estadoInicial,
  onCompletado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  estadoInicial?: EstadoMatricula;
  onCompletado: () => void;
}) {
  const wizard = useMatriculaState(estadoInicial);
  const pasoActualIndex = PASOS.findIndex((p) => p.id === wizard.estado.paso);

  const cerrar = (nuevoOpen: boolean) => {
    // No hay "cancelar" destructivo: cualquier avance ya está guardado en
    // el backend. Cerrar simplemente pausa; la fila de inscripciones
    // refleja el estado real y permite continuar después.
    onOpenChange(nuevoOpen);
    if (!nuevoOpen) onCompletado();
  };

  return (
    <Dialog open={open} onOpenChange={cerrar}>
      <DialogContent className="max-w-xl">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <UserPlus className="h-5 w-5" /> Matricular deportista
          </DialogTitle>
        </DialogHeader>

        <div className="flex items-center gap-2 mb-2">
          {PASOS.map((paso, i) => (
            <div key={paso.id} className="flex items-center gap-2 flex-1">
              <div
                className={`h-7 w-7 rounded-full flex items-center justify-center text-xs font-medium shrink-0 ${
                  i < pasoActualIndex
                    ? "bg-green-600 text-white"
                    : i === pasoActualIndex
                    ? "bg-primary text-primary-foreground"
                    : "bg-muted text-muted-foreground"
                }`}
              >
                {i < pasoActualIndex ? <Check className="h-4 w-4" /> : i + 1}
              </div>
              <span className="text-xs text-muted-foreground hidden sm:block">
                {paso.label}
              </span>
              {i < PASOS.length - 1 && (
                <div className="h-px bg-border flex-1" />
              )}
            </div>
          ))}
        </div>

        {wizard.estado.paso === "deportista" && (
          <PasoDeportista onSeleccionar={wizard.elegirDeportista} />
        )}
        {wizard.estado.paso === "plan" && wizard.estado.deportista && (
          <PasoPlanPago
            deportista={wizard.estado.deportista}
            guardando={wizard.guardando}
            permitirVolver={!wizard.estado.inscripcionId}
            onVolver={() => wizard.irA("deportista")}
            onConfirmar={wizard.confirmarPlan}
          />
        )}
        {wizard.estado.paso === "grupo" && wizard.estado.deportista && (
          <PasoGrupo
            deportistaId={wizard.estado.deportista.deportista_id}
            guardando={wizard.guardando}
            onVolver={() => wizard.irA("plan")}
            onConfirmar={wizard.confirmarGrupo}
          />
        )}
        {wizard.estado.paso === "confirmacion" && (
          <PasoConfirmacion
            estado={wizard.estado}
            onCerrar={() => cerrar(false)}
          />
        )}
      </DialogContent>
    </Dialog>
  );
}
</file>

