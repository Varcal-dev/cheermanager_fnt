<file path="app/components/eventos/CobroEventoPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Eye, Receipt, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api, getErrorMessage } from "@/lib/api";

interface GrupoEvento {
  id: number;
  grupoEntrenamientoId: number;
  nombreGrupo: string;
}

interface Linea {
  personaId: number;
  nombre: string;
  grupo: string;
  numeroFactura: string | null;
  motivo: string | null;
}

interface Resultado {
  simulacion: boolean;
  eventoId: number;
  eventoNombre: string;
  montoPorDeportista: number;
  totalACobrar: number;
  valorTotal: number;
  yaCobrados: number;
  cobrados: Linea[];
  omitidos: Linea[];
}

const moneda = (n: number) =>
  new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);

/**
 * Cobro del evento por lote: genera una factura concepto EVENTO a cada deportista de los
 * grupos inscritos. Primero se pide una vista previa (no crea nada) y luego se confirma.
 * Es seguro repetirlo: el back omite a quien ya tiene un cobro vigente de este evento.
 */
export default function CobroEventoPanel({ eventoId }: { eventoId: number }) {
  const [cargando, setCargando] = useState(true);
  const [grupos, setGrupos] = useState<GrupoEvento[]>([]);
  const [seleccionados, setSeleccionados] = useState<number[]>([]);
  const [monto, setMonto] = useState("");
  const [descripcion, setDescripcion] = useState("");
  const [vencimiento, setVencimiento] = useState("");
  const [vista, setVista] = useState<Resultado | null>(null);
  const [resultado, setResultado] = useState<Resultado | null>(null);
  const [trabajando, setTrabajando] = useState(false);

  useEffect(() => {
    setCargando(true);
    api
      .get(`/api/grupos-evento/evento/${eventoId}`)
      .then((res) => {
        const data: GrupoEvento[] = res.data;
        setGrupos(data);
        setSeleccionados(data.map((g) => g.grupoEntrenamientoId));
      })
      .catch(() => toast.error("No se pudieron cargar los grupos del evento"))
      .finally(() => setCargando(false));
  }, [eventoId]);

  const alternar = (id: number, marcado: boolean) => {
    setSeleccionados((prev) => (marcado ? [...prev, id] : prev.filter((x) => x !== id)));
    setVista(null); // cambió el alcance: la vista previa ya no vale
  };

  const montoNumero = Number(monto);
  const formularioValido = montoNumero > 0 && seleccionados.length > 0;

  const llamar = async (simular: boolean) => {
    setTrabajando(true);
    try {
      const res = await api.post(`/api/eventos/${eventoId}/cobro-lote`, {
        monto: montoNumero,
        descripcion: descripcion.trim() || undefined,
        fechaVencimiento: vencimiento || undefined,
        grupoIds: seleccionados,
        simular,
      });
      if (simular) {
        setVista(res.data);
        setResultado(null);
      } else {
        setResultado(res.data);
        setVista(null);
        toast.success(`Se generaron ${res.data.totalACobrar} cobros`);
      }
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo procesar el cobro"));
    } finally {
      setTrabajando(false);
    }
  };

  const confirmar = () => {
    if (!vista) return;
    if (
      !confirm(
        `Se generarán ${vista.totalACobrar} facturas de ${moneda(vista.montoPorDeportista)} ` +
          `(total ${moneda(vista.valorTotal)}). ¿Continuar?`,
      )
    )
      return;
    llamar(false);
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  if (grupos.length === 0) {
    return (
      <p className="text-center py-4 text-muted-foreground">
        Inscribe primero los grupos que participan (pestaña Grupos) para poder cobrar el evento.
      </p>
    );
  }

  const mostrado = resultado ?? vista;

  return (
    <div className="space-y-4">
      <div className="space-y-2">
        <Label>Grupos a cobrar</Label>
        <div className="flex flex-wrap gap-4">
          {grupos.map((g) => (
            <label key={g.id} className="flex items-center gap-2 text-sm">
              <Checkbox
                checked={seleccionados.includes(g.grupoEntrenamientoId)}
                onCheckedChange={(v) => alternar(g.grupoEntrenamientoId, v === true)}
              />
              {g.nombreGrupo}
            </label>
          ))}
        </div>
      </div>

      <div className="grid gap-3 sm:grid-cols-3">
        <div className="space-y-1">
          <Label htmlFor={`monto-${eventoId}`}>Valor por deportista (COP)</Label>
          <Input
            id={`monto-${eventoId}`}
            type="number"
            min={0}
            value={monto}
            onChange={(e) => {
              setMonto(e.target.value);
              setVista(null);
            }}
            placeholder="Ej: 80000"
          />
        </div>
        <div className="space-y-1">
          <Label htmlFor={`venc-${eventoId}`}>Vence (opcional)</Label>
          <Input
            id={`venc-${eventoId}`}
            type="date"
            value={vencimiento}
            onChange={(e) => {
              setVencimiento(e.target.value);
              setVista(null);
            }}
          />
          <p className="text-xs text-muted-foreground">Por defecto, 10 días desde hoy.</p>
        </div>
        <div className="space-y-1">
          <Label htmlFor={`desc-${eventoId}`}>Descripción (opcional)</Label>
          <Input
            id={`desc-${eventoId}`}
            value={descripcion}
            onChange={(e) => {
              setDescripcion(e.target.value);
              setVista(null);
            }}
            placeholder="Por defecto: Evento: <nombre>"
          />
        </div>
      </div>

      <div className="flex gap-2">
        <Button variant="outline" size="sm" onClick={() => llamar(true)} disabled={!formularioValido || trabajando}>
          {trabajando && !vista ? <Loader2 className="h-4 w-4 animate-spin mr-1" /> : <Eye className="h-4 w-4 mr-1" />}
          Vista previa
        </Button>
        <Button size="sm" onClick={confirmar} disabled={!vista || vista.totalACobrar === 0 || trabajando}>
          {trabajando && vista ? <Loader2 className="h-4 w-4 animate-spin mr-1" /> : <Receipt className="h-4 w-4 mr-1" />}
          Cobrar{vista ? ` a ${vista.totalACobrar}` : ""}
        </Button>
      </div>

      {mostrado && (
        <div className="space-y-3">
          <p className="text-sm">
            {mostrado.simulacion ? "Vista previa: " : "Listo: "}
            <strong>{mostrado.totalACobrar}</strong> {mostrado.simulacion ? "deportistas a cobrar" : "cobros generados"} ·{" "}
            <strong>{moneda(mostrado.valorTotal)}</strong>
            {mostrado.yaCobrados > 0 && ` · ${mostrado.yaCobrados} ya tenían cobro de este evento`}
          </p>

          {mostrado.cobrados.length > 0 && (
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Deportista</TableHead>
                  <TableHead>Grupo</TableHead>
                  <TableHead>{mostrado.simulacion ? "Valor" : "Factura"}</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {mostrado.cobrados.map((l) => (
                  <TableRow key={l.personaId}>
                    <TableCell>{l.nombre}</TableCell>
                    <TableCell>{l.grupo}</TableCell>
                    <TableCell>{mostrado.simulacion ? moneda(mostrado.montoPorDeportista) : l.numeroFactura}</TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          )}

          {mostrado.omitidos.length > 0 && (
            <div>
              <p className="text-sm font-medium mb-1">No se cobra a ({mostrado.omitidos.length})</p>
              <ul className="text-sm text-muted-foreground list-disc pl-5">
                {mostrado.omitidos.map((l) => (
                  <li key={l.personaId}>
                    {l.nombre} ({l.grupo}): {l.motivo}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="app/components/pagos/RecordatoriosMoraCard.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Checkbox } from "@/components/ui/checkbox";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { BellRing, Eye, Loader2, Save, Send, MessageCircle, Mail, Monitor } from "lucide-react";
import { toast } from "react-toastify";
import { api, getErrorMessage } from "@/lib/api";
import { formatCOP } from "@/app/lib/facturas-pagos";

interface CanalesDisponibles {
  sistema: boolean;
  correo: boolean;
  whatsappApi: boolean;
}

interface Config {
  automatico: boolean;
  sistema: boolean;
  correo: boolean;
  whatsapp: boolean;
  diasEntreAvisos: number;
}

interface CanalAviso {
  canal: string;
  destino: string | null;
  estado: string;
  detalle: string | null;
}

interface Aviso {
  personaId: number;
  nombre: string;
  facturas: number;
  saldo: number;
  canales: CanalAviso[];
}

interface Resultado {
  simulacion: boolean;
  facturasEnMora: number;
  personas: number;
  omitidosPorFrecuencia: number;
  enviados: Record<string, number>;
  fallidos: Record<string, number>;
  avisos: Aviso[];
  enlacesWhatsapp: { nombre: string; telefono: string; url: string }[];
  advertencias: string[];
}

const ETIQUETA_CANAL: Record<string, string> = {
  SISTEMA: "Sistema",
  CORREO: "Correo",
  WHATSAPP: "WhatsApp",
};

const ETIQUETA_ESTADO: Record<string, string> = {
  ENVIADO: "Enviado",
  FALLIDO: "Falló",
  SIN_DESTINO: "Sin destino",
  MANUAL: "Enlace manual",
  PROGRAMADO: "Se enviaría",
};

const sumar = (m: Record<string, number>) => Object.values(m).reduce((a, b) => a + b, 0);

/**
 * Recordatorios de mora: elige por dónde avisar (el aviso dentro del sistema viene marcado), mira a quién
 * se avisaría (vista previa) y envía. También guarda el envío automático diario del club.
 */
export default function RecordatoriosMoraCard() {
  const [cargando, setCargando] = useState(true);
  const [disponibles, setDisponibles] = useState<CanalesDisponibles>({
    sistema: true,
    correo: false,
    whatsappApi: false,
  });
  const [sistema, setSistema] = useState(true);
  const [correo, setCorreo] = useState(false);
  const [whatsapp, setWhatsapp] = useState(false);
  const [forzar, setForzar] = useState(false);
  const [automatico, setAutomatico] = useState(false);
  const [dias, setDias] = useState("7");

  const [trabajando, setTrabajando] = useState<"" | "previa" | "envio" | "config" | "prueba">("");
  const [resultado, setResultado] = useState<Resultado | null>(null);
  const [correoPrueba, setCorreoPrueba] = useState("");

  useEffect(() => {
    Promise.allSettled([api.get("/api/recordatorios-mora/canales"), api.get("/api/recordatorios-mora/config")])
      .then(([rCanales, rConfig]) => {
        if (rCanales.status === "fulfilled") setDisponibles(rCanales.value.data);
        if (rConfig.status === "fulfilled") {
          const c: Config = rConfig.value.data;
          setSistema(c.sistema);
          setCorreo(c.correo);
          setWhatsapp(c.whatsapp);
          setAutomatico(c.automatico);
          setDias(String(c.diasEntreAvisos));
        }
      })
      .finally(() => setCargando(false));
  }, []);

  const cuerpo = () => ({ sistema, correo, whatsapp, forzar });
  const sinCanal = !sistema && !correo && !whatsapp;

  const ejecutar = async (simular: boolean) => {
    if (sinCanal) {
      toast.error("Elige al menos un canal");
      return;
    }
    setTrabajando(simular ? "previa" : "envio");
    try {
      const res = await api.post(
        simular ? "/api/recordatorios-mora/previsualizar" : "/api/recordatorios-mora/enviar",
        cuerpo(),
      );
      setResultado(res.data);
      if (!simular) {
        const ok = sumar(res.data.enviados);
        const mal = sumar(res.data.fallidos);
        if (ok > 0) toast.success(`Se enviaron ${ok} avisos${mal ? ` (${mal} fallaron)` : ""}`);
        else if (mal > 0) toast.error(`No se pudo enviar: ${mal} fallaron`);
        else toast.info("No había avisos por enviar");
      }
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudieron procesar los recordatorios"));
    } finally {
      setTrabajando("");
    }
  };

  const confirmarEnvio = () => {
    if (!confirm("Se enviarán los recordatorios a las personas en mora por los canales elegidos. ¿Continuar?")) return;
    ejecutar(false);
  };

  const guardarConfig = async () => {
    setTrabajando("config");
    try {
      await api.put("/api/recordatorios-mora/config", {
        automatico,
        sistema,
        correo,
        whatsapp,
        diasEntreAvisos: Number(dias),
      });
      toast.success(automatico ? "Envío automático activado" : "Configuración guardada");
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo guardar la configuración"));
    } finally {
      setTrabajando("");
    }
  };

  const probarCorreo = async () => {
    setTrabajando("prueba");
    try {
      await api.post("/api/recordatorios-mora/probar-correo", { email: correoPrueba });
      toast.success("Correo de prueba enviado");
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo enviar el correo de prueba"));
    } finally {
      setTrabajando("");
    }
  };

  if (cargando) return null;

  return (
    <Card>
      <CardHeader className="pb-2">
        <CardTitle className="text-base font-display flex items-center gap-2">
          <BellRing className="h-4 w-4" />
          Recordatorios de mora
        </CardTitle>
        <CardDescription>
          Avisa al deportista y a sus acudientes de las facturas vencidas, un solo mensaje por persona con todas sus
          facturas. No repite el aviso de la misma factura por el mismo canal antes de {dias || "7"} días.
        </CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        <div className="space-y-2">
          <p className="text-sm font-medium">Enviar por</p>
          <label className="flex items-start gap-2 text-sm">
            <Checkbox checked={sistema} onCheckedChange={(v) => setSistema(v === true)} className="mt-0.5" />
            <span>
              <span className="flex items-center gap-1 font-medium">
                <Monitor className="h-4 w-4" /> Dentro del sistema <Badge variant="secondary">Estándar</Badge>
              </span>
              <span className="text-muted-foreground">
                Aviso en el portal del deportista y de los acudientes que tengan usuario.
              </span>
            </span>
          </label>
          <label className="flex items-start gap-2 text-sm">
            <Checkbox
              checked={correo}
              disabled={!disponibles.correo}
              onCheckedChange={(v) => setCorreo(v === true)}
              className="mt-0.5"
            />
            <span>
              <span className="flex items-center gap-1 font-medium">
                <Mail className="h-4 w-4" /> Correo
              </span>
              <span className="text-muted-foreground">
                {disponibles.correo
                  ? "A los correos del usuario del deportista y de sus acudientes."
                  : "No disponible: falta configurar el SMTP en el servidor."}
              </span>
            </span>
          </label>
          <label className="flex items-start gap-2 text-sm">
            <Checkbox checked={whatsapp} onCheckedChange={(v) => setWhatsapp(v === true)} className="mt-0.5" />
            <span>
              <span className="flex items-center gap-1 font-medium">
                <MessageCircle className="h-4 w-4" /> WhatsApp
              </span>
              <span className="text-muted-foreground">
                {disponibles.whatsappApi
                  ? "Envío automático por WhatsApp Business."
                  : "Sin envío automático configurado: se generan enlaces para enviar cada mensaje a mano."}
              </span>
            </span>
          </label>
          <label className="flex items-center gap-2 text-sm text-muted-foreground">
            <Checkbox checked={forzar} onCheckedChange={(v) => setForzar(v === true)} />
            Incluir también a quienes ya se avisó hace poco
          </label>
        </div>

        <div className="flex flex-wrap gap-2">
          <Button variant="outline" size="sm" onClick={() => ejecutar(true)} disabled={trabajando !== "" || sinCanal}>
            {trabajando === "previa" ? (
              <Loader2 className="h-4 w-4 animate-spin mr-1" />
            ) : (
              <Eye className="h-4 w-4 mr-1" />
            )}
            Vista previa
          </Button>
          <Button size="sm" onClick={confirmarEnvio} disabled={trabajando !== "" || sinCanal}>
            {trabajando === "envio" ? (
              <Loader2 className="h-4 w-4 animate-spin mr-1" />
            ) : (
              <Send className="h-4 w-4 mr-1" />
            )}
            Enviar recordatorios
          </Button>
        </div>

        {resultado && (
          <div className="space-y-3 rounded-md border p-3 bg-muted/30 text-sm">
            <p>
              {resultado.simulacion ? "Vista previa: " : "Resultado: "}
              <strong>{resultado.facturasEnMora}</strong> facturas en mora de <strong>{resultado.personas}</strong>{" "}
              personas.
              {!resultado.simulacion && (
                <>
                  {" "}
                  Enviados: <strong>{sumar(resultado.enviados)}</strong>
                  {sumar(resultado.fallidos) > 0 && (
                    <>
                      {" "}
                      · Fallidos: <strong className="text-destructive">{sumar(resultado.fallidos)}</strong>
                    </>
                  )}
                  .
                </>
              )}
              {resultado.omitidosPorFrecuencia > 0 &&
                ` ${resultado.omitidosPorFrecuencia} se omitieron porque ya se avisó hace poco.`}
            </p>

            {resultado.advertencias.map((a, i) => (
              <p key={i} className="text-amber-600">
                {a}
              </p>
            ))}

            {resultado.avisos.length > 0 && (
              <ul className="space-y-2">
                {resultado.avisos.map((a) => (
                  <li key={a.personaId}>
                    <p className="font-medium">
                      {a.nombre}{" "}
                      <span className="font-normal text-muted-foreground">
                        · {a.facturas} factura(s) · {formatCOP(a.saldo)}
                      </span>
                    </p>
                    <ul className="pl-4 text-muted-foreground">
                      {a.canales.map((c, i) => (
                        <li key={i}>
                          {ETIQUETA_CANAL[c.canal] ?? c.canal}
                          {c.destino ? ` → ${c.destino}` : ""}:{" "}
                          <span className={c.estado === "FALLIDO" ? "text-destructive" : ""}>
                            {ETIQUETA_ESTADO[c.estado] ?? c.estado}
                          </span>
                          {c.detalle ? ` (${c.detalle})` : ""}
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            )}

            {resultado.enlacesWhatsapp.length > 0 && (
              <div>
                <p className="font-medium">WhatsApp: abre cada enlace y envía el mensaje</p>
                <ul className="list-disc pl-5">
                  {resultado.enlacesWhatsapp.map((e, i) => (
                    <li key={i}>
                      <a href={e.url} target="_blank" rel="noopener noreferrer" className="underline">
                        {e.nombre} ({e.telefono})
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <div className="space-y-3 border-t pt-4">
          <p className="text-sm font-medium">Envío automático</p>
          <label className="flex items-center gap-2 text-sm">
            <Checkbox checked={automatico} onCheckedChange={(v) => setAutomatico(v === true)} />
            Enviar solo cada día a las 8:00 a.m. con los canales marcados arriba
          </label>
          <div className="flex items-end gap-3">
            <div className="grid gap-1.5">
              <label className="text-xs text-muted-foreground">Días entre avisos de la misma factura</label>
              <Input
                type="number"
                min={1}
                max={90}
                value={dias}
                onChange={(e) => setDias(e.target.value)}
                className="h-9 w-32"
              />
            </div>
            <Button variant="outline" size="sm" onClick={guardarConfig} disabled={trabajando !== ""}>
              {trabajando === "config" ? (
                <Loader2 className="h-4 w-4 animate-spin mr-1" />
              ) : (
                <Save className="h-4 w-4 mr-1" />
              )}
              Guardar
            </Button>
          </div>
          {disponibles.correo && (
            <div className="flex items-end gap-3">
              <div className="grid gap-1.5">
                <label className="text-xs text-muted-foreground">Probar el correo del sistema</label>
                <Input
                  type="email"
                  placeholder="tu@correo.com"
                  value={correoPrueba}
                  onChange={(e) => setCorreoPrueba(e.target.value)}
                  className="h-9 w-64"
                />
              </div>
              <Button variant="outline" size="sm" onClick={probarCorreo} disabled={trabajando !== "" || !correoPrueba}>
                {trabajando === "prueba" && <Loader2 className="h-4 w-4 animate-spin mr-1" />}
                Enviar correo de prueba
              </Button>
            </div>
          )}
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="app/components/portal/AvisosPortal.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { Bell, Check } from "lucide-react";
import { toast } from "react-toastify";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { getErrorMessage } from "@/lib/api";
import {
  portalMarcarAvisoVisto,
  portalMarcarAvisosVistos,
  portalNotificaciones,
  type ListaAvisos,
} from "@/app/lib/portal";

/** Avisos del club para este usuario (p. ej. recordatorios de pago). No se muestra si no hay ninguno. */
export default function AvisosPortal() {
  const [datos, setDatos] = useState<ListaAvisos | null>(null);
  const [verTodos, setVerTodos] = useState(false);

  const cargar = useCallback(() => {
    portalNotificaciones()
      .then(setDatos)
      .catch(() => setDatos(null)); // los avisos son accesorios: si fallan, el portal sigue
  }, []);

  useEffect(() => {
    cargar();
  }, [cargar]);

  if (!datos || datos.items.length === 0) return null;

  const visibles = verTodos ? datos.items : datos.items.filter((n) => !n.vista).slice(0, 5);
  if (visibles.length === 0 && !verTodos) {
    return (
      <div className="print:hidden">
        <Button variant="ghost" size="sm" onClick={() => setVerTodos(true)}>
          <Bell className="h-4 w-4 mr-1" /> Ver avisos anteriores
        </Button>
      </div>
    );
  }

  const marcar = async (id: number) => {
    try {
      await portalMarcarAvisoVisto(id);
      cargar();
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo marcar el aviso"));
    }
  };

  const marcarTodos = async () => {
    try {
      await portalMarcarAvisosVistos();
      cargar();
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudieron marcar los avisos"));
    }
  };

  return (
    <Card className="print:hidden">
      <CardHeader className="pb-2 flex flex-row items-center justify-between space-y-0">
        <CardTitle className="text-base flex items-center gap-2">
          <Bell className="h-4 w-4" /> Avisos del club
          {datos.noVistas > 0 && <Badge variant="destructive">{datos.noVistas}</Badge>}
        </CardTitle>
        <div className="flex gap-2">
          <Button variant="ghost" size="sm" onClick={() => setVerTodos((v) => !v)}>
            {verTodos ? "Solo nuevos" : "Ver todos"}
          </Button>
          {datos.noVistas > 0 && (
            <Button variant="ghost" size="sm" onClick={marcarTodos}>
              <Check className="h-4 w-4 mr-1" /> Marcar todos como leídos
            </Button>
          )}
        </div>
      </CardHeader>
      <CardContent className="space-y-3">
        {visibles.map((n) => (
          <div key={n.id} className={`rounded-md border p-3 text-sm ${n.vista ? "opacity-60" : "bg-muted/30"}`}>
            <p className="whitespace-pre-line">{n.mensaje}</p>
            <div className="mt-2 flex items-center justify-between text-xs text-muted-foreground">
              <span>{new Date(n.fecha).toLocaleString("es-CO")}</span>
              {!n.vista && (
                <Button variant="link" size="sm" className="h-auto p-0" onClick={() => marcar(n.id)}>
                  Marcar como leído
                </Button>
              )}
            </div>
          </div>
        ))}
      </CardContent>
    </Card>
  );
}
</file>

<file path="app/criterios-evaluacion/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Plus, Pencil, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api, getErrorMessage } from "@/lib/api";
import ProtectedRoute from "@/components/ProtectedRoute";
import { useUser } from "@/context/UserContext";

interface Criterio {
  id: number;
  nombre: string;
  categoriaId: number;
  categoria: string;
  enUso: boolean; // ya tiene evaluaciones: no se borra ni cambia de categoría
}

interface Categoria {
  id: number;
  categoria: string;
}

const TODAS = "todas";

export default function CriteriosEvaluacionPage() {
  const { permissions } = useUser();
  const puedeCrear = permissions.includes("crear_criterio_evaluacion");
  const puedeEditar = permissions.includes("modificar_criterio_evaluacion");
  const puedeEliminar = permissions.includes("eliminar_criterio_evaluacion");

  const [cargando, setCargando] = useState(true);
  const [criterios, setCriterios] = useState<Criterio[]>([]);
  const [categorias, setCategorias] = useState<Categoria[]>([]);
  const [filtroCategoria, setFiltroCategoria] = useState(TODAS);
  const [busqueda, setBusqueda] = useState("");

  // Formulario crear / editar
  const [formAbierto, setFormAbierto] = useState(false);
  const [enEdicion, setEnEdicion] = useState<Criterio | null>(null);
  const [nombre, setNombre] = useState("");
  const [categoriaId, setCategoriaId] = useState("");
  const [guardando, setGuardando] = useState(false);

  // Eliminar
  const [aEliminar, setAEliminar] = useState<Criterio | null>(null);
  const [eliminando, setEliminando] = useState(false);

  const cargar = () => {
    setCargando(true);
    Promise.allSettled([api.get("/api/criterios-evaluacion"), api.get("/api/tipos-categoria")]).then(
      ([resCriterios, resCategorias]) => {
        if (resCriterios.status === "fulfilled") setCriterios(resCriterios.value.data);
        else toast.error("No se pudieron cargar los criterios");
        if (resCategorias.status === "fulfilled") setCategorias(resCategorias.value.data);
        else toast.error("No se pudieron cargar las categorías");
        setCargando(false);
      },
    );
  };

  useEffect(() => {
    cargar();
  }, []);

  const visibles = useMemo(
    () =>
      criterios
        .filter((c) => filtroCategoria === TODAS || String(c.categoriaId) === filtroCategoria)
        .filter((c) => c.nombre.toLowerCase().includes(busqueda.trim().toLowerCase()))
        .sort((a, b) => a.categoria.localeCompare(b.categoria) || a.nombre.localeCompare(b.nombre)),
    [criterios, filtroCategoria, busqueda],
  );

  const abrirCrear = () => {
    setEnEdicion(null);
    setNombre("");
    setCategoriaId(filtroCategoria !== TODAS ? filtroCategoria : "");
    setFormAbierto(true);
  };

  const abrirEditar = (c: Criterio) => {
    setEnEdicion(c);
    setNombre(c.nombre);
    setCategoriaId(String(c.categoriaId));
    setFormAbierto(true);
  };

  const guardar = async () => {
    if (!nombre.trim()) {
      toast.error("Escribe el nombre del criterio");
      return;
    }
    if (!categoriaId) {
      toast.error("Selecciona la categoría");
      return;
    }
    setGuardando(true);
    try {
      const body = { nombre: nombre.trim(), categoriaId: Number(categoriaId) };
      if (enEdicion) {
        await api.put(`/api/criterios-evaluacion/${enEdicion.id}`, body);
        toast.success("Criterio actualizado");
      } else {
        await api.post("/api/criterios-evaluacion", body);
        toast.success("Criterio creado");
      }
      setFormAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo guardar el criterio"));
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async () => {
    if (!aEliminar) return;
    setEliminando(true);
    try {
      await api.delete(`/api/criterios-evaluacion/${aEliminar.id}`);
      toast.success("Criterio eliminado");
      setAEliminar(null);
      cargar();
    } catch (error: any) {
      toast.error(getErrorMessage(error, "No se pudo eliminar el criterio"));
    } finally {
      setEliminando(false);
    }
  };

  const categoriaBloqueada = !!enEdicion?.enUso;

  return (
    <ProtectedRoute requiredPermission="ver_evaluacion">
      <div className="space-y-6">
        <div className="flex justify-between items-center">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Criterios de evaluación</h1>
            <p className="text-muted-foreground">
              Lo que se mide al evaluar a un deportista, agrupado por categoría (física, técnica, …).
            </p>
          </div>
          {puedeCrear && (
            <Button onClick={abrirCrear}>
              <Plus className="h-4 w-4 mr-1" /> Nuevo criterio
            </Button>
          )}
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <Input
            placeholder="Buscar criterio..."
            value={busqueda}
            onChange={(e) => setBusqueda(e.target.value)}
            className="h-9 w-64"
          />
          <Select value={filtroCategoria} onValueChange={setFiltroCategoria}>
            <SelectTrigger className="h-9 w-[220px]">
              <SelectValue placeholder="Categoría" />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value={TODAS}>Todas las categorías</SelectItem>
              {categorias.map((c) => (
                <SelectItem key={c.id} value={String(c.id)}>
                  {c.categoria}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        <Card>
          <CardContent className="p-0">
            {cargando ? (
              <div className="flex items-center justify-center py-10 text-muted-foreground">
                <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
              </div>
            ) : (
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Criterio</TableHead>
                    <TableHead>Categoría</TableHead>
                    <TableHead>Uso</TableHead>
                    {(puedeEditar || puedeEliminar) && <TableHead>Acciones</TableHead>}
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {visibles.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={4} className="text-center py-8 text-muted-foreground">
                        {criterios.length === 0
                          ? "Aún no hay criterios. Crea el primero para poder evaluar."
                          : "Ningún criterio coincide con el filtro."}
                      </TableCell>
                    </TableRow>
                  ) : (
                    visibles.map((c) => (
                      <TableRow key={c.id}>
                        <TableCell className="font-medium">{c.nombre}</TableCell>
                        <TableCell>{c.categoria}</TableCell>
                        <TableCell>
                          {c.enUso ? (
                            <Badge variant="secondary">Con evaluaciones</Badge>
                          ) : (
                            <span className="text-muted-foreground text-sm">Sin usar</span>
                          )}
                        </TableCell>
                        {(puedeEditar || puedeEliminar) && (
                          <TableCell>
                            <div className="flex space-x-2">
                              {puedeEditar && (
                                <Button variant="outline" size="sm" onClick={() => abrirEditar(c)}>
                                  <Pencil className="h-4 w-4 mr-1" /> Editar
                                </Button>
                              )}
                              {puedeEliminar && (
                                <Button
                                  variant="destructive"
                                  size="sm"
                                  disabled={c.enUso}
                                  title={c.enUso ? "Ya tiene evaluaciones: no se puede eliminar" : undefined}
                                  onClick={() => setAEliminar(c)}
                                >
                                  <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                                </Button>
                              )}
                            </div>
                          </TableCell>
                        )}
                      </TableRow>
                    ))
                  )}
                </TableBody>
              </Table>
            )}
          </CardContent>
        </Card>
      </div>

      <Dialog open={formAbierto} onOpenChange={setFormAbierto}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>{enEdicion ? "Editar criterio" : "Nuevo criterio"}</DialogTitle>
            <DialogDescription>
              {enEdicion
                ? "Cambiar el nombre actualiza también las evaluaciones ya registradas con este criterio."
                : "Ej.: Flexibilidad, Sincronía, Altura del salto."}
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div className="space-y-1">
              <Label htmlFor="criterio-nombre">Nombre</Label>
              <Input
                id="criterio-nombre"
                value={nombre}
                maxLength={150}
                onChange={(e) => setNombre(e.target.value)}
              />
            </div>
            <div className="space-y-1">
              <Label>Categoría</Label>
              <Select value={categoriaId} onValueChange={setCategoriaId} disabled={categoriaBloqueada}>
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona una categoría" />
                </SelectTrigger>
                <SelectContent>
                  {categorias.map((c) => (
                    <SelectItem key={c.id} value={String(c.id)}>
                      {c.categoria}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              {categoriaBloqueada && (
                <p className="text-xs text-muted-foreground">
                  Ya tiene evaluaciones: no se puede cambiar de categoría. Crea uno nuevo si lo necesitas en otra.
                </p>
              )}
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setFormAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando && <Loader2 className="h-4 w-4 animate-spin mr-1" />}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      <Dialog open={!!aEliminar} onOpenChange={(abierto) => !abierto && setAEliminar(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Eliminar criterio</DialogTitle>
            <DialogDescription>
              ¿Eliminar &quot;{aEliminar?.nombre}&quot; ({aEliminar?.categoria})? Esta acción no se puede deshacer.
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => setAEliminar(null)} disabled={eliminando}>
              Cancelar
            </Button>
            <Button variant="destructive" onClick={eliminar} disabled={eliminando}>
              {eliminando && <Loader2 className="h-4 w-4 animate-spin mr-1" />}
              Eliminar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </ProtectedRoute>
  );
}
</file>

<file path="app/solicitudes-inscripcion/page.tsx">
