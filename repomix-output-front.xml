<file path="app/auditoria/page.tsx">
"use client";

import { SetStateAction, useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Search, ChevronLeft, ChevronRight, Loader2, Eye, X } from "lucide-react";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { toast } from "react-toastify";
import ProtectedRoute from "@/components/ProtectedRoute";
import {
  obtenerAuditoria,
  obtenerTablasAuditadas,
  parsearSnapshot,
  type AccionAuditoria,
  type RegistroAuditoria,
} from "@/lib/auditoria";
import { cn } from "@/lib/utils";

const ACCION_BADGE: Record<AccionAuditoria, "success" | "outline" | "destructive"> = {
  INSERT: "success",
  UPDATE: "outline",
  DELETE: "destructive",
};

const PAGE_SIZE = 20;

export default function AuditoriaPage() {
  const [searchTerm, setSearchTerm] = useState("");
  const [tablaFiltro, setTablaFiltro] = useState<string | null>(null);
  const [accionFiltro, setAccionFiltro] = useState<AccionAuditoria | null>(null);
  const [fechaDesde, setFechaDesde] = useState("");
  const [fechaHasta, setFechaHasta] = useState("");
  const [page, setPage] = useState(0);

  const [registros, setRegistros] = useState<RegistroAuditoria[]>([]);
  const [totalElements, setTotalElements] = useState(0);
  const [totalPages, setTotalPages] = useState(0);
  const [cargando, setCargando] = useState(true);

  const [tablasDisponibles, setTablasDisponibles] = useState<string[]>([]);
  const [selectedRegistro, setSelectedRegistro] = useState<number | null>(null);

  // Resumen (pestaña "Estadísticas"): conteos reales vía totalElements de
  // consultas con size=1, no un cálculo aproximado sobre la página cargada.
  const [resumen, setResumen] = useState<{
    total: number;
    insert: number;
    update: number;
    delete: number;
  } | null>(null);
  const [cargandoResumen, setCargandoResumen] = useState(false);

  useEffect(() => {
    obtenerTablasAuditadas()
      .then(setTablasDisponibles)
      .catch(() => {
        // silencioso: el filtro de tabla simplemente queda vacío
      });
  }, []);

  useEffect(() => {
    setCargando(true);
    const desde = fechaDesde ? `${fechaDesde}T00:00:00` : undefined;
    const hasta = fechaHasta ? `${fechaHasta}T23:59:59` : undefined;

    obtenerAuditoria({
      tabla: tablaFiltro ?? undefined,
      accion: accionFiltro ?? undefined,
      q: searchTerm || undefined,
      desde,
      hasta,
      page,
      size: PAGE_SIZE,
    })
      .then((data: { content: SetStateAction<RegistroAuditoria[]>; totalElements: SetStateAction<number>; totalPages: SetStateAction<number>; }) => {
        setRegistros(data.content);
        setTotalElements(data.totalElements);
        setTotalPages(data.totalPages);
      })
      .catch(() => toast.error("No se pudieron cargar los registros de auditoría"))
      .finally(() => setCargando(false));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [tablaFiltro, accionFiltro, searchTerm, fechaDesde, fechaHasta, page]);

  const cargarResumen = () => {
    setCargandoResumen(true);
    const base = { tabla: tablaFiltro ?? undefined, size: 1 } as const;
    Promise.allSettled([
      obtenerAuditoria({ ...base }),
      obtenerAuditoria({ ...base, accion: "INSERT" }),
      obtenerAuditoria({ ...base, accion: "UPDATE" }),
      obtenerAuditoria({ ...base, accion: "DELETE" }),
    ])
      .then(([total, insert, update, del]) => {
        setResumen({
          total: total.status === "fulfilled" ? total.value.totalElements : 0,
          insert: insert.status === "fulfilled" ? insert.value.totalElements : 0,
          update: update.status === "fulfilled" ? update.value.totalElements : 0,
          delete: del.status === "fulfilled" ? del.value.totalElements : 0,
        });
      })
      .finally(() => setCargandoResumen(false));
  };

  const registroSeleccionado = registros.find((r) => r.id === selectedRegistro) ?? null;

  return (
    <ProtectedRoute requiredPermission="ver_dash_administracion">
      <div className="space-y-6">
        <div className="flex justify-between items-center">
          <div>
            <h1 className="text-3xl font-display font-bold tracking-tight">
              Auditoría
            </h1>
            <p className="text-muted-foreground">
              Registro de actividad y cambios en el sistema
            </p>
          </div>
        </div>

        <Tabs
          defaultValue="registros"
          className="w-full"
          onValueChange={(v) => {
            if (v === "estadisticas" && !resumen) cargarResumen();
          }}
        >
          <TabsList className="grid w-full grid-cols-2">
            <TabsTrigger value="registros">Registros de Auditoría</TabsTrigger>
            <TabsTrigger value="estadisticas">Estadísticas</TabsTrigger>
          </TabsList>

          <TabsContent value="registros" className="space-y-4">
            <div className="flex flex-col md:flex-row justify-between gap-4">
              <div className="relative flex items-center w-full max-w-sm">
                <Search className="pointer-events-none absolute left-3 h-4 w-4 text-muted-foreground" />
                <Input
                  placeholder="Buscar por usuario, tabla o IP…"
                  value={searchTerm}
                  onChange={(e) => {
                    setPage(0);
                    setSearchTerm(e.target.value);
                  }}
                  className="h-9 pl-9"
                />
              </div>
              <div className="flex flex-wrap gap-2">
                <Select
                  value={tablaFiltro ?? "all"}
                  onValueChange={(value) => {
                    setPage(0);
                    setTablaFiltro(value === "all" ? null : value);
                  }}
                >
                  <SelectTrigger className="w-[170px]">
                    <SelectValue placeholder="Tabla" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">Todas las tablas</SelectItem>
                    {tablasDisponibles.map((tabla) => (
                      <SelectItem key={tabla} value={tabla}>
                        {tabla}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                <Select
                  value={accionFiltro ?? "all"}
                  onValueChange={(value) => {
                    setPage(0);
                    setAccionFiltro(value === "all" ? null : (value as AccionAuditoria));
                  }}
                >
                  <SelectTrigger className="w-[150px]">
                    <SelectValue placeholder="Acción" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">Todas</SelectItem>
                    <SelectItem value="INSERT">Creación</SelectItem>
                    <SelectItem value="UPDATE">Actualización</SelectItem>
                    <SelectItem value="DELETE">Eliminación</SelectItem>
                  </SelectContent>
                </Select>
                <Input
                  type="date"
                  value={fechaDesde}
                  onChange={(e) => {
                    setPage(0);
                    setFechaDesde(e.target.value);
                  }}
                  className="h-9 w-[150px]"
                  title="Desde"
                />
                <Input
                  type="date"
                  value={fechaHasta}
                  onChange={(e) => {
                    setPage(0);
                    setFechaHasta(e.target.value);
                  }}
                  className="h-9 w-[150px]"
                  title="Hasta"
                />
                {(tablaFiltro || accionFiltro || fechaDesde || fechaHasta || searchTerm) && (
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => {
                      setTablaFiltro(null);
                      setAccionFiltro(null);
                      setFechaDesde("");
                      setFechaHasta("");
                      setSearchTerm("");
                      setPage(0);
                    }}
                  >
                    <X className="h-4 w-4 mr-1" /> Limpiar
                  </Button>
                )}
              </div>
            </div>

            <Card>
              <CardContent className="p-0">
                <Table>
                  <TableHeader>
                    <TableRow className="hover:bg-transparent">
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Usuario
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Tabla
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Acción
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Registro
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Fecha
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        IP
                      </TableHead>
                      <TableHead className="font-display text-xs uppercase tracking-wide text-muted-foreground">
                        Detalle
                      </TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {cargando ? (
                      <TableRow>
                        <TableCell colSpan={7}>
                          <div className="flex items-center justify-center py-10 text-muted-foreground">
                            <Loader2 className="mr-2 h-4 w-4 animate-spin" /> Cargando
                            registros…
                          </div>
                        </TableCell>
                      </TableRow>
                    ) : registros.length === 0 ? (
                      <TableRow>
                        <TableCell colSpan={7}>
                          <div className="flex flex-col items-center justify-center py-10 text-center text-muted-foreground">
                            <div className="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-accent/10">
                              <Search className="h-6 w-6 text-accent" />
                            </div>
                            <p className="text-lg font-display font-semibold text-foreground">
                              Sin actividad registrada
                            </p>
                            <p className="text-sm text-muted-foreground max-w-sm">
                              {tablaFiltro || accionFiltro || fechaDesde || fechaHasta || searchTerm
                                ? "No hay registros que coincidan con estos filtros."
                                : "Cuando alguien cree, edite o elimine algo en el sistema, aparecerá aquí."}
                            </p>
                          </div>
                        </TableCell>
                      </TableRow>
                    ) : (
                      registros.map((registro) => (
                        <TableRow
                          key={registro.id}
                          className={selectedRegistro === registro.id ? "bg-muted/50" : ""}
                        >
                          <TableCell className="font-medium">
                            {registro.usuarioUsername ?? "—"}
                          </TableCell>
                          <TableCell className="font-figures text-sm">
                            {registro.tablaAfectada}
                          </TableCell>
                          <TableCell>
                            <Badge variant={ACCION_BADGE[registro.accion]}>
                              {registro.accion}
                            </Badge>
                          </TableCell>
                          <TableCell className="font-figures text-sm text-muted-foreground">
                            {registro.registroId ?? "—"}
                          </TableCell>
                          <TableCell className="text-sm">
                            {new Date(registro.fecha).toLocaleString()}
                          </TableCell>
                          <TableCell className="font-figures text-sm text-muted-foreground">
                            {registro.ipUsuario ?? "—"}
                          </TableCell>
                          <TableCell>
                            <Button
                              variant="outline"
                              size="sm"
                              onClick={() =>
                                setSelectedRegistro(
                                  selectedRegistro === registro.id ? null : registro.id,
                                )
                              }
                            >
                              <Eye className="h-4 w-4 mr-1" /> Ver
                            </Button>
                          </TableCell>
                        </TableRow>
                      ))
                    )}
                  </TableBody>
                </Table>
              </CardContent>
            </Card>

            {totalPages > 1 && (
              <div className="flex items-center justify-between">
                <p className="text-sm text-muted-foreground">
                  {totalElements} registros · página {page + 1} de {totalPages}
                </p>
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={page === 0}
                    onClick={() => setPage((p) => Math.max(0, p - 1))}
                  >
                    <ChevronLeft className="h-4 w-4" />
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={page + 1 >= totalPages}
                    onClick={() => setPage((p) => p + 1)}
                  >
                    <ChevronRight className="h-4 w-4" />
                  </Button>
                </div>
              </div>
            )}

            {registroSeleccionado && (
              <Card>
                <CardHeader>
                  <CardTitle className="font-display">
                    Detalle del registro #{registroSeleccionado.id}
                  </CardTitle>
                  <CardDescription>
                    {registroSeleccionado.tablaAfectada} · {registroSeleccionado.accion}
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <div className="grid grid-cols-2 gap-4">
                    <div>
                      <h3 className="font-display font-semibold mb-2">
                        Información del registro
                      </h3>
                      <div className="space-y-2 text-sm">
                        <div className="grid grid-cols-2">
                          <span className="text-muted-foreground">Usuario:</span>
                          <span>{registroSeleccionado.usuarioUsername ?? "—"}</span>
                        </div>
                        <div className="grid grid-cols-2">
                          <span className="text-muted-foreground">Tabla:</span>
                          <span className="font-figures">
                            {registroSeleccionado.tablaAfectada}
                          </span>
                        </div>
                        <div className="grid grid-cols-2">
                          <span className="text-muted-foreground">Acción:</span>
                          <Badge variant={ACCION_BADGE[registroSeleccionado.accion]}>
                            {registroSeleccionado.accion}
                          </Badge>
                        </div>
                        <div className="grid grid-cols-2">
                          <span className="text-muted-foreground">Fecha:</span>
                          <span>
                            {new Date(registroSeleccionado.fecha).toLocaleString()}
                          </span>
                        </div>
                        <div className="grid grid-cols-2">
                          <span className="text-muted-foreground">IP:</span>
                          <span className="font-figures">
                            {registroSeleccionado.ipUsuario ?? "—"}
                          </span>
                        </div>
                      </div>
                    </div>
                    <div>
                      <h3 className="font-display font-semibold mb-2">
                        Cambios realizados
                      </h3>
                      <div className="space-y-4">
                        {parsearSnapshot(registroSeleccionado.valoresAnteriores) && (
                          <div>
                            <h4 className="text-sm font-medium text-muted-foreground">
                              Valores anteriores:
                            </h4>
                            <pre className="mt-1 rounded bg-muted p-2 text-xs overflow-auto font-figures">
                              {JSON.stringify(
                                parsearSnapshot(registroSeleccionado.valoresAnteriores),
                                null,
                                2,
                              )}
                            </pre>
                          </div>
                        )}
                        {parsearSnapshot(registroSeleccionado.nuevosValores) && (
                          <div>
                            <h4 className="text-sm font-medium text-muted-foreground">
                              Nuevos valores:
                            </h4>
                            <pre className="mt-1 rounded bg-muted p-2 text-xs overflow-auto font-figures">
                              {JSON.stringify(
                                parsearSnapshot(registroSeleccionado.nuevosValores),
                                null,
                                2,
                              )}
                            </pre>
                          </div>
                        )}
                        {!registroSeleccionado.valoresAnteriores &&
                          !registroSeleccionado.nuevosValores && (
                            <p className="text-sm text-muted-foreground">
                              Sin detalle de campos para este registro.
                            </p>
                          )}
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            )}
          </TabsContent>

          <TabsContent value="estadisticas" className="space-y-4">
            {cargandoResumen || !resumen ? (
              <div className="flex items-center justify-center py-10 text-muted-foreground">
                <Loader2 className="mr-2 h-4 w-4 animate-spin" /> Calculando…
              </div>
            ) : (
              <>
                <p className="text-xs text-muted-foreground">
                  {tablaFiltro
                    ? `Filtrado a la tabla "${tablaFiltro}". `
                    : ""}
                  Conteos reales sobre toda la tabla de auditoría, no solo la
                  página visible.
                </p>
                <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                  <ResumenCard
                    titulo="Total de registros"
                    valor={resumen.total}
                    tone="accent"
                  />
                  <ResumenCard
                    titulo="Creaciones"
                    valor={resumen.insert}
                    tone="success"
                  />
                  <ResumenCard
                    titulo="Actualizaciones"
                    valor={resumen.update}
                    tone="primary"
                  />
                  <ResumenCard
                    titulo="Eliminaciones"
                    valor={resumen.delete}
                    tone="destructive"
                  />
                </div>
              </>
            )}
          </TabsContent>
        </Tabs>
      </div>
    </ProtectedRoute>
  );
}

const RESUMEN_TONES = {
  primary: "text-primary",
  success: "text-success",
  accent: "text-accent",
  destructive: "text-destructive",
} as const;

function ResumenCard({
  titulo,
  valor,
  tone,
}: {
  titulo: string;
  valor: number;
  tone: keyof typeof RESUMEN_TONES;
}) {
  return (
    <Card className={cn("lane-accent", RESUMEN_TONES[tone])}>
      <CardHeader className="pb-2 pl-5">
        <CardTitle className="text-sm font-medium text-muted-foreground">
          {titulo}
        </CardTitle>
      </CardHeader>
      <CardContent className="pl-5">
        <div className="text-3xl font-display font-bold font-figures text-foreground">
          {valor.toLocaleString()}
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="app/clubes/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { Plus, Power } from "lucide-react";
import { toast } from "react-toastify";
import ProtectedRoute from "@/components/ProtectedRoute";
import { api, getErrorMessage } from "@/lib/api";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";

// Administración de clubes (multi-club). Solo el superadmin de la plataforma (permiso gestionar_clubes).

interface Club {
  id: number;
  nombre: string;
  slug: string;
  activo: boolean;
  fechaCreacion: string;
}

const VACIO = {
  nombre: "",
  slug: "",
  adminUsername: "",
  adminEmail: "",
  adminPassword: "",
  cargarPlantilla: true,
};

export default function ClubesPage() {
  const [clubes, setClubes] = useState<Club[]>([]);
  const [cargando, setCargando] = useState(true);
  const [abierto, setAbierto] = useState(false);
  const [form, setForm] = useState(VACIO);
  const [guardando, setGuardando] = useState(false);
  const [paraCambiar, setParaCambiar] = useState<Club | null>(null);

  const cargar = async () => {
    try {
      const res = await api.get("/api/clubes");
      setClubes(res.data ?? []);
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudieron cargar los clubes"));
    } finally {
      setCargando(false);
    }
  };

  useEffect(() => {
    cargar();
  }, []);

  const crear = async () => {
    if (form.adminPassword.length < 10) {
      toast.error("La clave inicial del administrador debe tener al menos 10 caracteres");
      return;
    }
    setGuardando(true);
    try {
      await api.post("/api/clubes", {
        ...form,
        slug: form.slug.trim() || null, // el back lo genera a partir del nombre si no se envía
      });
      toast.success("Club creado");
      setAbierto(false);
      setForm(VACIO);
      cargar();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo crear el club"));
    } finally {
      setGuardando(false);
    }
  };

  const cambiarActivo = async () => {
    if (!paraCambiar) return;
    try {
      await api.patch(`/api/clubes/${paraCambiar.id}/activo`, { activo: !paraCambiar.activo });
      toast.success(paraCambiar.activo ? "Club suspendido" : "Club reactivado");
      setParaCambiar(null);
      cargar();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo cambiar el estado del club"));
    }
  };

  return (
    <ProtectedRoute requiredPermission="gestionar_clubes">
      <div className="space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Clubes</h1>
            <p className="text-muted-foreground">
              Cada club ve únicamente sus propios datos. Aquí das de alta nuevos clubes o suspendes uno.
            </p>
          </div>
          <Button onClick={() => setAbierto(true)}>
            <Plus className="mr-2 h-4 w-4" /> Nuevo club
          </Button>
        </div>

        <Card>
          <CardContent className="p-0">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Club</TableHead>
                  <TableHead>Identificador</TableHead>
                  <TableHead>Estado</TableHead>
                  <TableHead>Creado</TableHead>
                  <TableHead>Acciones</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {cargando ? (
                  <TableRow>
                    <TableCell colSpan={5} className="text-center text-muted-foreground">
                      Cargando…
                    </TableCell>
                  </TableRow>
                ) : (
                  clubes.map((c) => (
                    <TableRow key={c.id}>
                      <TableCell className="font-medium">
                        {c.nombre}
                        {c.id === 1 && <span className="ml-2 text-xs text-muted-foreground">(Plataforma)</span>}
                      </TableCell>
                      <TableCell>{c.slug}</TableCell>
                      <TableCell>
                        <Badge variant={c.activo ? "default" : "secondary"}>{c.activo ? "Activo" : "Suspendido"}</Badge>
                      </TableCell>
                      <TableCell>{c.fechaCreacion ? new Date(c.fechaCreacion).toLocaleDateString("es-CO") : "—"}</TableCell>
                      <TableCell>
                        {c.id !== 1 && (
                          <Button size="sm" variant="outline" onClick={() => setParaCambiar(c)}>
                            <Power className="mr-1 h-4 w-4" /> {c.activo ? "Suspender" : "Reactivar"}
                          </Button>
                        )}
                      </TableCell>
                    </TableRow>
                  ))
                )}
              </TableBody>
            </Table>
          </CardContent>
        </Card>

        {/* Nuevo club */}
        <Dialog open={abierto} onOpenChange={setAbierto}>
          <DialogContent className="sm:max-w-[480px]">
            <DialogHeader>
              <DialogTitle>Nuevo club</DialogTitle>
              <DialogDescription>
                Se crea el club con los roles base (Administrador, Entrenador, Deportista) y su administrador.
                El username y el correo deben ser únicos en toda la plataforma.
              </DialogDescription>
            </DialogHeader>
            <div className="grid gap-3">
              <div>
                <Label>Nombre del club</Label>
                <Input value={form.nombre} onChange={(e) => setForm({ ...form, nombre: e.target.value })} />
              </div>
              <div>
                <Label>Identificador (opcional)</Label>
                <Input
                  placeholder="se genera del nombre si lo dejas vacío"
                  value={form.slug}
                  onChange={(e) => setForm({ ...form, slug: e.target.value })}
                />
              </div>
              <div>
                <Label>Usuario del administrador</Label>
                <Input value={form.adminUsername} onChange={(e) => setForm({ ...form, adminUsername: e.target.value })} />
              </div>
              <div>
                <Label>Correo del administrador</Label>
                <Input type="email" value={form.adminEmail} onChange={(e) => setForm({ ...form, adminEmail: e.target.value })} />
              </div>
              <div>
                <Label>Clave inicial (mínimo 10 caracteres)</Label>
                <Input type="password" value={form.adminPassword} onChange={(e) => setForm({ ...form, adminPassword: e.target.value })} />
              </div>
              <label className="flex items-center gap-2 text-sm">
                <Checkbox
                  checked={form.cargarPlantilla}
                  onCheckedChange={(c) => setForm({ ...form, cargarPlantilla: c === true })}
                />
                Cargar niveles (Nivel 1–6) y divisiones de ejemplo (editables)
              </label>
            </div>
            <DialogFooter>
              <Button variant="outline" onClick={() => setAbierto(false)}>
                Cancelar
              </Button>
              <Button onClick={crear} disabled={guardando}>
                {guardando ? "Creando..." : "Crear club"}
              </Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>

        {/* Suspender / reactivar */}
        <Dialog open={!!paraCambiar} onOpenChange={(o) => !o && setParaCambiar(null)}>
          <DialogContent className="sm:max-w-[420px]">
            <DialogHeader>
              <DialogTitle>{paraCambiar?.activo ? "Suspender club" : "Reactivar club"}</DialogTitle>
              <DialogDescription>
                {paraCambiar?.activo
                  ? `Los usuarios de "${paraCambiar?.nombre}" perderán el acceso de inmediato.`
                  : `Los usuarios de "${paraCambiar?.nombre}" podrán volver a iniciar sesión.`}
              </DialogDescription>
            </DialogHeader>
            <DialogFooter>
              <Button variant="outline" onClick={() => setParaCambiar(null)}>
                Cancelar
              </Button>
              <Button variant={paraCambiar?.activo ? "destructive" : "default"} onClick={cambiarActivo}>
                Confirmar
              </Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>
      </div>
    </ProtectedRoute>
  );
}
</file>

<file path="app/components/asistencias/asistencias-view.tsx">
"use client"

import * as React from "react"
import { CalendarClock, CheckCheck, History, ListChecks, Loader2, Save, Users } from "lucide-react"
import { toast } from "react-toastify"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import { api, getErrorMessage } from "@/lib/api"

// Vista de asistencias conectada al backend (antes usaba datos de ejemplo en memoria).
// Endpoints: /api/grupos/con-deportistas, /api/horarios, /api/estados-asistencia,
// /api/asistencias/grupo/{id}/deportistas-activos, /api/asistencias/grupo/{id}?fecha=, /api/asistencias/masivo

interface GrupoSimple {
  id: number
  nombre: string
}

interface HorarioDTO {
  id: number
  dia: string
  horaInicio: string
  horaFin: string
  grupos: { horarioEntrenamientoId: number; grupoId: number; nombreGrupo: string }[]
}

interface EstadoAsistencia {
  id: number
  estado: string
}

interface DeportistaActivo {
  deportistaId: number
  nombre: string
}

interface AsistenciaDTO {
  id: number
  deportistaId: number
  nombreDeportista: string
  horarioId: number
  fecha: string
  estadoAsistenciaId: number
  estadoAsistencia: string
}

const hoyISO = () => new Date().toISOString().slice(0, 10)
const hora = (h: string) => h?.slice(0, 5) ?? ""

function badgeVariant(estado: string): "default" | "secondary" | "destructive" | "outline" {
  const e = estado.toLowerCase()
  if (e === "presente") return "default"
  if (e === "ausente") return "destructive"
  if (e === "tarde") return "secondary"
  return "outline"
}

function useCatalogos() {
  const [grupos, setGrupos] = React.useState<GrupoSimple[]>([])
  const [horarios, setHorarios] = React.useState<HorarioDTO[]>([])
  const [estados, setEstados] = React.useState<EstadoAsistencia[]>([])
  const [cargando, setCargando] = React.useState(true)

  React.useEffect(() => {
    Promise.all([
      api.get("/api/grupos/con-deportistas"),
      api.get("/api/horarios"),
      api.get("/api/estados-asistencia"),
    ])
      .then(([g, h, e]) => {
        setGrupos((g.data as any[]).map((x) => ({ id: x.id, nombre: x.nombre })))
        setHorarios(h.data)
        setEstados(e.data)
      })
      .catch((err) => toast.error(getErrorMessage(err, "No se pudieron cargar grupos, horarios o estados")))
      .finally(() => setCargando(false))
  }, [])

  return { grupos, horarios, estados, cargando }
}

export function AsistenciasView() {
  const cat = useCatalogos()

  return (
    <div className="flex flex-col gap-6 p-4 md:p-6">
      <div className="flex flex-col gap-1">
        <h1 className="text-2xl font-semibold tracking-tight text-balance">Asistencias</h1>
        <p className="text-sm text-muted-foreground text-pretty">
          Registra la asistencia de un entrenamiento en bloque y consulta lo ya registrado por grupo y fecha.
        </p>
      </div>

      {cat.cargando ? (
        <div className="flex items-center gap-2 text-sm text-muted-foreground">
          <Loader2 className="size-4 animate-spin" /> Cargando…
        </div>
      ) : (
        <Tabs defaultValue="registro" className="gap-6">
          <TabsList>
            <TabsTrigger value="registro">
              <ListChecks data-icon="inline-start" />
              Registro masivo
            </TabsTrigger>
            <TabsTrigger value="historial">
              <History data-icon="inline-start" />
              Consulta
            </TabsTrigger>
          </TabsList>
          <TabsContent value="registro">
            <RegistroMasivo {...cat} />
          </TabsContent>
          <TabsContent value="historial">
            <Consulta {...cat} />
          </TabsContent>
        </Tabs>
      )}
    </div>
  )
}

type CatProps = { grupos: GrupoSimple[]; horarios: HorarioDTO[]; estados: EstadoAsistencia[] }

/* ---------------------------- Tab 1: Registro ---------------------------- */

function RegistroMasivo({ grupos, horarios, estados }: CatProps) {
  const [grupoId, setGrupoId] = React.useState("")
  const [horarioId, setHorarioId] = React.useState("")
  const [fecha, setFecha] = React.useState(hoyISO())
  const [roster, setRoster] = React.useState<{ deportistaId: number; nombre: string; estadoId: string }[]>([])
  const [cargada, setCargada] = React.useState(false)
  const [cargando, setCargando] = React.useState(false)
  const [guardando, setGuardando] = React.useState(false)

  const horariosDelGrupo = React.useMemo(
    () => (grupoId ? horarios.filter((h) => h.grupos.some((g) => g.grupoId === Number(grupoId))) : []),
    [horarios, grupoId],
  )

  React.useEffect(() => {
    setHorarioId("")
    setCargada(false)
    setRoster([])
  }, [grupoId])

  const estadoPorDefecto = () => (estados.find((e) => e.estado.toLowerCase() === "presente") ?? estados[0])?.id.toString() ?? ""

  async function cargarLista() {
    if (!grupoId || !horarioId || !fecha) {
      toast.error("Selecciona grupo, horario y fecha")
      return
    }
    setCargando(true)
    try {
      const [activos, yaRegistradas] = await Promise.all([
        api.get<DeportistaActivo[]>(`/api/asistencias/grupo/${grupoId}/deportistas-activos`),
        api.get<AsistenciaDTO[]>(`/api/asistencias/grupo/${grupoId}`, { params: { fecha } }),
      ])
      const previos = new Map(
        yaRegistradas.data.filter((a) => a.horarioId === Number(horarioId)).map((a) => [a.deportistaId, a]),
      )
      const defecto = estadoPorDefecto()
      setRoster(
        activos.data.map((d) => ({
          deportistaId: d.deportistaId,
          nombre: d.nombre,
          estadoId: previos.get(d.deportistaId)?.estadoAsistenciaId.toString() ?? defecto,
        })),
      )
      setCargada(true)
    } catch (err) {
      toast.error(getErrorMessage(err, "No se pudo cargar la lista del grupo"))
    } finally {
      setCargando(false)
    }
  }

  async function guardar() {
    if (!horarioId || roster.length === 0) return
    setGuardando(true)
    try {
      const { data } = await api.post("/api/asistencias/masivo", {
        horarioId: Number(horarioId),
        fecha,
        registros: roster.map((r) => ({ deportistaId: r.deportistaId, estadoAsistenciaId: Number(r.estadoId) })),
      })
      const errores: Record<string, string> = data?.errores ?? {}
      const n = Object.keys(errores).length
      if (n === 0) toast.success(`Asistencia guardada: ${data?.registrados?.length ?? roster.length} deportistas`)
      else toast.warn(`Se guardaron ${data?.registrados?.length ?? 0} registros y ${n} fallaron: ${Object.values(errores)[0]}`)
    } catch (err) {
      toast.error(getErrorMessage(err, "No se pudo guardar la asistencia"))
    } finally {
      setGuardando(false)
    }
  }

  const marcarTodos = (estadoId: string) => setRoster((p) => p.map((r) => ({ ...r, estadoId })))

  const resumen = React.useMemo(() => {
    const out: Record<string, number> = {}
    for (const r of roster) {
      const nombre = estados.find((e) => e.id === Number(r.estadoId))?.estado ?? "—"
      out[nombre] = (out[nombre] ?? 0) + 1
    }
    return out
  }, [roster, estados])

  return (
    <div className="flex flex-col gap-6">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <CalendarClock className="size-4 text-primary" />
            Grupo, horario y fecha
          </CardTitle>
          <CardDescription>Elige el entrenamiento para cargar los deportistas activos del grupo.</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="grid gap-4 sm:grid-cols-3">
            <div className="flex flex-col gap-2">
              <Label>Grupo</Label>
              <Select value={grupoId} onValueChange={setGrupoId}>
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un grupo" />
                </SelectTrigger>
                <SelectContent>
                  {grupos.map((g) => (
                    <SelectItem key={g.id} value={String(g.id)}>
                      {g.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="flex flex-col gap-2">
              <Label>Horario</Label>
              <Select value={horarioId} onValueChange={setHorarioId} disabled={!grupoId}>
                <SelectTrigger>
                  <SelectValue placeholder={grupoId ? "Selecciona un horario" : "Primero el grupo"} />
                </SelectTrigger>
                <SelectContent>
                  {horariosDelGrupo.map((h) => (
                    <SelectItem key={h.id} value={String(h.id)}>
                      {h.dia} {hora(h.horaInicio)}–{hora(h.horaFin)}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="flex flex-col gap-2">
              <Label>Fecha</Label>
              <Input type="date" value={fecha} max={hoyISO()} onChange={(e) => setFecha(e.target.value)} />
            </div>
          </div>
          <Button className="mt-4" onClick={cargarLista} disabled={cargando || !grupoId || !horarioId}>
            {cargando ? <Loader2 className="mr-2 size-4 animate-spin" /> : <Users className="mr-2 size-4" />}
            Cargar lista
          </Button>
        </CardContent>
      </Card>

      {cargada && (
        <Card>
          <CardHeader className="flex flex-row flex-wrap items-center justify-between gap-2">
            <div>
              <CardTitle>Lista de asistencia</CardTitle>
              <CardDescription>
                {roster.length} deportistas activos ·{" "}
                {Object.entries(resumen)
                  .map(([k, v]) => `${v} ${k.toLowerCase()}`)
                  .join(" · ")}
              </CardDescription>
            </div>
            <div className="flex gap-2">
              {estados.slice(0, 2).map((e) => (
                <Button key={e.id} variant="outline" size="sm" onClick={() => marcarTodos(String(e.id))}>
                  <CheckCheck className="mr-1 size-4" /> Todos {e.estado.toLowerCase()}
                </Button>
              ))}
            </div>
          </CardHeader>
          <CardContent>
            {roster.length === 0 ? (
              <p className="text-sm text-muted-foreground">Este grupo no tiene deportistas activos.</p>
            ) : (
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Deportista</TableHead>
                    <TableHead className="w-56">Estado</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {roster.map((r, i) => (
                    <TableRow key={r.deportistaId}>
                      <TableCell className="font-medium">{r.nombre}</TableCell>
                      <TableCell>
                        <Select
                          value={r.estadoId}
                          onValueChange={(v) => setRoster((p) => p.map((x, j) => (j === i ? { ...x, estadoId: v } : x)))}
                        >
                          <SelectTrigger>
                            <SelectValue />
                          </SelectTrigger>
                          <SelectContent>
                            {estados.map((e) => (
                              <SelectItem key={e.id} value={String(e.id)}>
                                {e.estado}
                              </SelectItem>
                            ))}
                          </SelectContent>
                        </Select>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
            <Button className="mt-4" onClick={guardar} disabled={guardando || roster.length === 0}>
              {guardando ? <Loader2 className="mr-2 size-4 animate-spin" /> : <Save className="mr-2 size-4" />}
              Guardar asistencia
            </Button>
          </CardContent>
        </Card>
      )}
    </div>
  )
}

/* ---------------------------- Tab 2: Consulta ---------------------------- */

function Consulta({ grupos, horarios }: CatProps) {
  const [grupoId, setGrupoId] = React.useState("")
  const [fecha, setFecha] = React.useState(hoyISO())
  const [filas, setFilas] = React.useState<AsistenciaDTO[] | null>(null)
  const [cargando, setCargando] = React.useState(false)

  async function consultar() {
    if (!grupoId || !fecha) {
      toast.error("Selecciona grupo y fecha")
      return
    }
    setCargando(true)
    try {
      const res = await api.get<AsistenciaDTO[]>(`/api/asistencias/grupo/${grupoId}`, { params: { fecha } })
      setFilas(res.data)
    } catch (err) {
      toast.error(getErrorMessage(err, "No se pudo consultar la asistencia"))
    } finally {
      setCargando(false)
    }
  }

  const etiquetaHorario = (id: number) => {
    const h = horarios.find((x) => x.id === id)
    return h ? `${h.dia} ${hora(h.horaInicio)}–${hora(h.horaFin)}` : `#${id}`
  }

  return (
    <Card>
      <CardHeader>
        <CardTitle>Asistencia registrada</CardTitle>
        <CardDescription>Consulta lo guardado para un grupo en una fecha.</CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-4">
        <div className="grid gap-4 sm:grid-cols-3">
          <div className="flex flex-col gap-2">
            <Label>Grupo</Label>
            <Select value={grupoId} onValueChange={setGrupoId}>
              <SelectTrigger>
                <SelectValue placeholder="Selecciona un grupo" />
              </SelectTrigger>
              <SelectContent>
                {grupos.map((g) => (
                  <SelectItem key={g.id} value={String(g.id)}>
                    {g.nombre}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          <div className="flex flex-col gap-2">
            <Label>Fecha</Label>
            <Input type="date" value={fecha} onChange={(e) => setFecha(e.target.value)} />
          </div>
          <div className="flex items-end">
            <Button onClick={consultar} disabled={cargando}>
              {cargando && <Loader2 className="mr-2 size-4 animate-spin" />}
              Consultar
            </Button>
          </div>
        </div>

        {filas && (
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Deportista</TableHead>
                <TableHead>Horario</TableHead>
                <TableHead>Estado</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {filas.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={3} className="text-center text-muted-foreground">
                    Sin registros para esa fecha.
                  </TableCell>
                </TableRow>
              ) : (
                filas.map((f) => (
                  <TableRow key={f.id}>
                    <TableCell className="font-medium">{f.nombreDeportista}</TableCell>
                    <TableCell>{etiquetaHorario(f.horarioId)}</TableCell>
                    <TableCell>
                      <Badge variant={badgeVariant(f.estadoAsistencia)}>{f.estadoAsistencia}</Badge>
                    </TableCell>
                  </TableRow>
                ))
              )}
            </TableBody>
          </Table>
        )}
      </CardContent>
    </Card>
  )
}
</file>

<file path="app/components/deportistas/AcudientesConsentimientosPanel.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import { Plus, Trash2, ShieldCheck, ShieldOff, UserPlus, KeyRound } from "lucide-react";
import { toast } from "react-toastify";
import { api, getErrorMessage } from "@/lib/api";
import { useUser } from "@/context/UserContext";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";

// Acudientes (padres/tutores) y consentimientos de datos (Ley 1581) de un deportista.
// Esto es registro de EVIDENCIA, no asesoría legal: el texto que se firma lo debe validar un abogado.

interface Props {
  deportistaId: number;
  personaId: number;
  fechaNacimiento?: string | null;
}

interface Vinculo {
  vinculoId: number;
  acudienteId: number;
  nombre: string;
  apellidos: string;
  telefono?: string;
  email?: string;
  parentesco?: string;
  principal: boolean;
  autorizaRecoger: boolean;
  tieneAcceso?: boolean;
}

interface AcudienteLista {
  id: number;
  nombre: string;
  apellidos: string;
  numeroDocumento?: string;
}

interface Consentimiento {
  id: number;
  tipo: string;
  versionTexto: string;
  canal: string;
  acudienteId?: number | null;
  fechaOtorgado: string;
  fechaRevocado?: string | null;
  motivoRevocacion?: string | null;
  vigente: boolean;
}

const TIPOS: { valor: string; etiqueta: string }[] = [
  { valor: "TRATAMIENTO_DATOS", etiqueta: "Tratamiento de datos personales" },
  { valor: "DATOS_SALUD", etiqueta: "Datos de salud" },
  { valor: "IMAGEN", etiqueta: "Uso de imagen (fotos y videos)" },
];

const esMenorDeEdad = (fecha?: string | null) => {
  if (!fecha) return null; // sin fecha no se puede saber (el back tampoco adivina)
  const nac = new Date(fecha);
  const hoy = new Date();
  let edad = hoy.getFullYear() - nac.getFullYear();
  const m = hoy.getMonth() - nac.getMonth();
  if (m < 0 || (m === 0 && hoy.getDate() < nac.getDate())) edad--;
  return edad < 18;
};

export default function AcudientesConsentimientosPanel({ deportistaId, personaId, fechaNacimiento }: Props) {
  const { permissions } = useUser();
  const verAcudientes = permissions.includes("ver_acudientes");
  const gestionarAcudientes = permissions.includes("gestionar_acudientes");
  const verConsentimientos = permissions.includes("ver_consentimientos");
  const gestionarConsentimientos = permissions.includes("gestionar_consentimientos");
  const menor = esMenorDeEdad(fechaNacimiento);

  const [vinculos, setVinculos] = useState<Vinculo[]>([]);
  const [consentimientos, setConsentimientos] = useState<Consentimiento[]>([]);

  // --- vincular acudiente ---
  const [vincularAbierto, setVincularAbierto] = useState(false);
  const [modo, setModo] = useState<"existente" | "nuevo">("existente");
  const [todos, setTodos] = useState<AcudienteLista[]>([]);
  const [acudienteSel, setAcudienteSel] = useState("");
  const [nuevo, setNuevo] = useState({
    nombre: "",
    apellidos: "",
    tipoDocumento: "CC",
    numeroDocumento: "",
    telefono: "",
    email: "",
  });
  const [parentesco, setParentesco] = useState("");
  const [autorizaRecoger, setAutorizaRecoger] = useState(true);
  const [guardandoVinculo, setGuardandoVinculo] = useState(false);

  // --- registrar consentimiento ---
  const [consentTipo, setConsentTipo] = useState<string | null>(null);
  const [versionTexto, setVersionTexto] = useState("");
  const [canal, setCanal] = useState("PAPEL");
  const [otorgaAcudienteId, setOtorgaAcudienteId] = useState("");
  const [observaciones, setObservaciones] = useState("");
  const [guardandoConsent, setGuardandoConsent] = useState(false);

  // --- acceso al portal del acudiente ---
  const [acceso, setAcceso] = useState<{ username: string; claveTemporal: string } | null>(null);

  const crearAcceso = async (v: Vinculo) => {
    if (!confirm(`¿Crear acceso al portal para ${v.nombre} ${v.apellidos}? Entrará con su correo (${v.email ?? "sin correo"}) y verá, solo lectura, la información de sus deportistas.`)) return;
    try {
      const res = await api.post(`/api/acudientes/${v.acudienteId}/acceso`);
      setAcceso(res.data);
      cargarVinculos();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo crear el acceso"));
    }
  };

  // --- revocar ---
  const [revocando, setRevocando] = useState<Consentimiento | null>(null);
  const [motivo, setMotivo] = useState("");

  const cargarVinculos = useCallback(async () => {
    if (!verAcudientes) return;
    try {
      const res = await api.get(`/api/acudientes/deportista/${deportistaId}`);
      setVinculos(res.data ?? []);
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudieron cargar los acudientes"));
    }
  }, [deportistaId, verAcudientes]);

  const cargarConsentimientos = useCallback(async () => {
    if (!verConsentimientos) return;
    try {
      const res = await api.get(`/api/consentimientos/persona/${personaId}`);
      setConsentimientos(res.data ?? []);
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudieron cargar los consentimientos"));
    }
  }, [personaId, verConsentimientos]);

  useEffect(() => {
    cargarVinculos();
    cargarConsentimientos();
  }, [cargarVinculos, cargarConsentimientos]);

  const abrirVincular = async () => {
    setModo("existente");
    setAcudienteSel("");
    setParentesco("");
    setAutorizaRecoger(true);
    setNuevo({ nombre: "", apellidos: "", tipoDocumento: "CC", numeroDocumento: "", telefono: "", email: "" });
    setVincularAbierto(true);
    try {
      const res = await api.get("/api/acudientes");
      setTodos(res.data ?? []);
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo cargar la lista de acudientes"));
    }
  };

  const guardarVinculo = async () => {
    setGuardandoVinculo(true);
    try {
      let acudienteId: number;
      if (modo === "nuevo") {
        if (!nuevo.nombre.trim() || !nuevo.apellidos.trim()) {
          toast.error("Nombre y apellidos del acudiente son obligatorios");
          return;
        }
        const creado = await api.post("/api/acudientes", nuevo);
        acudienteId = creado.data.id;
      } else {
        if (!acudienteSel) {
          toast.error("Selecciona un acudiente");
          return;
        }
        acudienteId = Number(acudienteSel);
      }
      // El primer acudiente que se vincula queda como principal (lo decide el back).
      await api.post(`/api/acudientes/deportista/${deportistaId}`, {
        acudienteId,
        parentesco: parentesco.trim() || null,
        principal: null,
        autorizaRecoger,
      });
      toast.success("Acudiente vinculado");
      setVincularAbierto(false);
      cargarVinculos();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo vincular el acudiente"));
    } finally {
      setGuardandoVinculo(false);
    }
  };

  const desvincular = async (v: Vinculo) => {
    if (!confirm(`¿Quitar a ${v.nombre} ${v.apellidos} como acudiente de este deportista?`)) return;
    try {
      await api.delete(`/api/acudientes/vinculos/${v.vinculoId}`);
      toast.success("Vínculo eliminado");
      cargarVinculos();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo quitar el vínculo"));
    }
  };

  const abrirConsentimiento = (tipo: string) => {
    setConsentTipo(tipo);
    setVersionTexto("");
    setCanal("PAPEL");
    setObservaciones("");
    setOtorgaAcudienteId(vinculos.find((v) => v.principal)?.acudienteId?.toString() ?? vinculos[0]?.acudienteId?.toString() ?? "");
  };

  const guardarConsentimiento = async () => {
    if (!consentTipo) return;
    if (!versionTexto.trim()) {
      toast.error("Indica la versión del texto de autorización que se firmó");
      return;
    }
    setGuardandoConsent(true);
    try {
      await api.post("/api/consentimientos", {
        personaId,
        tipo: consentTipo,
        versionTexto: versionTexto.trim(),
        canal,
        acudienteId: menor ? Number(otorgaAcudienteId) || null : null,
        observaciones: observaciones.trim() || null,
      });
      toast.success("Consentimiento registrado");
      setConsentTipo(null);
      cargarConsentimientos();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo registrar el consentimiento"));
    } finally {
      setGuardandoConsent(false);
    }
  };

  const revocar = async () => {
    if (!revocando) return;
    try {
      await api.patch(`/api/consentimientos/${revocando.id}/revocar`, { motivo: motivo.trim() || null });
      toast.success("Consentimiento revocado");
      setRevocando(null);
      setMotivo("");
      cargarConsentimientos();
    } catch (error) {
      toast.error(getErrorMessage(error, "No se pudo revocar el consentimiento"));
    }
  };

  if (!verAcudientes && !verConsentimientos) {
    return <p className="text-sm text-muted-foreground">No tienes permiso para ver acudientes ni consentimientos.</p>;
  }

  const vigentePorTipo = (tipo: string) => consentimientos.find((c) => c.tipo === tipo && c.vigente);

  return (
    <div className="space-y-8">
      {verAcudientes && (
        <section className="space-y-3">
          <div className="flex items-center justify-between">
            <h4 className="font-semibold">Acudientes</h4>
            {gestionarAcudientes && (
              <Button size="sm" variant="outline" onClick={abrirVincular}>
                <UserPlus className="h-4 w-4 mr-1" /> Vincular acudiente
              </Button>
            )}
          </div>
          {menor && vinculos.length === 0 && (
            <p className="text-sm text-amber-600">
              Este deportista es menor de edad y todavía no tiene acudiente.
            </p>
          )}
          {vinculos.length === 0 ? (
            <p className="text-sm text-muted-foreground">Sin acudientes registrados.</p>
          ) : (
            <ul className="space-y-2">
              {vinculos.map((v) => (
                <li key={v.vinculoId} className="flex items-center justify-between rounded-md border p-3">
                  <div className="text-sm">
                    <p className="font-medium">
                      {v.nombre} {v.apellidos}
                      {v.principal && <Badge className="ml-2">Principal</Badge>}
                      {v.tieneAcceso && <Badge variant="outline" className="ml-2">Con acceso al portal</Badge>}
                    </p>
                    <p className="text-muted-foreground">
                      {[v.parentesco, v.telefono, v.email].filter(Boolean).join(" · ") || "—"}
                      {v.autorizaRecoger ? " · Autorizado a recoger" : ""}
                    </p>
                  </div>
                  {gestionarAcudientes && (
                    <div className="flex items-center gap-1">
                      {!v.tieneAcceso && (
                        <Button size="sm" variant="outline" onClick={() => crearAcceso(v)} disabled={!v.email}
                          title={v.email ? "Crear usuario del portal" : "El acudiente necesita un correo"}>
                          <KeyRound className="h-4 w-4 mr-1" /> Crear acceso
                        </Button>
                      )}
                      <Button size="sm" variant="ghost" onClick={() => desvincular(v)} aria-label="Quitar acudiente">
                        <Trash2 className="h-4 w-4" />
                      </Button>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      {verConsentimientos && (
        <section className="space-y-3">
          <h4 className="font-semibold">Consentimientos (Ley 1581)</h4>
          {menor === null && (
            <p className="text-sm text-amber-600">
              Falta la fecha de nacimiento: sin ella no se puede registrar un consentimiento.
            </p>
          )}
          <ul className="space-y-2">
            {TIPOS.map((t) => {
              const vigente = vigentePorTipo(t.valor);
              return (
                <li key={t.valor} className="flex items-center justify-between rounded-md border p-3">
                  <div className="flex items-center gap-3 text-sm">
                    {vigente ? (
                      <ShieldCheck className="h-5 w-5 text-green-600" />
                    ) : (
                      <ShieldOff className="h-5 w-5 text-muted-foreground" />
                    )}
                    <div>
                      <p className="font-medium">{t.etiqueta}</p>
                      <p className="text-muted-foreground">
                        {vigente
                          ? `Vigente desde ${new Date(vigente.fechaOtorgado).toLocaleDateString("es-CO")} · texto ${vigente.versionTexto} · ${vigente.canal}`
                          : "Sin consentimiento vigente"}
                      </p>
                    </div>
                  </div>
                  {gestionarConsentimientos &&
                    (vigente ? (
                      <Button size="sm" variant="outline" onClick={() => setRevocando(vigente)}>
                        Revocar
                      </Button>
                    ) : (
                      <Button size="sm" onClick={() => abrirConsentimiento(t.valor)} disabled={menor === null}>
                        <Plus className="h-4 w-4 mr-1" /> Registrar
                      </Button>
                    ))}
                </li>
              );
            })}
          </ul>
          {consentimientos.some((c) => !c.vigente) && (
            <details className="text-sm text-muted-foreground">
              <summary className="cursor-pointer">Historial de revocados</summary>
              <ul className="mt-2 space-y-1">
                {consentimientos
                  .filter((c) => !c.vigente)
                  .map((c) => (
                    <li key={c.id}>
                      {TIPOS.find((t) => t.valor === c.tipo)?.etiqueta ?? c.tipo} · otorgado{" "}
                      {new Date(c.fechaOtorgado).toLocaleDateString("es-CO")} · revocado{" "}
                      {c.fechaRevocado ? new Date(c.fechaRevocado).toLocaleDateString("es-CO") : ""}
                      {c.motivoRevocacion ? ` (${c.motivoRevocacion})` : ""}
                    </li>
                  ))}
              </ul>
            </details>
          )}
        </section>
      )}

      {/* Vincular acudiente */}
      <Dialog open={vincularAbierto} onOpenChange={setVincularAbierto}>
        <DialogContent className="sm:max-w-[460px]">
          <DialogHeader>
            <DialogTitle>Vincular acudiente</DialogTitle>
            <DialogDescription>
              Un acudiente puede serlo de varios deportistas (hermanos). El primero que se vincula queda como principal.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div className="flex gap-4 text-sm">
              <label className="flex items-center gap-2">
                <input type="radio" checked={modo === "existente"} onChange={() => setModo("existente")} /> Ya registrado
              </label>
              <label className="flex items-center gap-2">
                <input type="radio" checked={modo === "nuevo"} onChange={() => setModo("nuevo")} /> Nuevo
              </label>
            </div>
            {modo === "existente" ? (
              <Select value={acudienteSel} onValueChange={setAcudienteSel}>
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un acudiente" />
                </SelectTrigger>
                <SelectContent>
                  {todos.map((a) => (
                    <SelectItem key={a.id} value={String(a.id)}>
                      {a.nombre} {a.apellidos}
                      {a.numeroDocumento ? ` · ${a.numeroDocumento}` : ""}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            ) : (
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <Label>Nombre</Label>
                  <Input value={nuevo.nombre} onChange={(e) => setNuevo({ ...nuevo, nombre: e.target.value })} />
                </div>
                <div>
                  <Label>Apellidos</Label>
                  <Input value={nuevo.apellidos} onChange={(e) => setNuevo({ ...nuevo, apellidos: e.target.value })} />
                </div>
                <div>
                  <Label>Tipo doc.</Label>
                  <Input value={nuevo.tipoDocumento} onChange={(e) => setNuevo({ ...nuevo, tipoDocumento: e.target.value })} />
                </div>
                <div>
                  <Label>N.º documento</Label>
                  <Input value={nuevo.numeroDocumento} onChange={(e) => setNuevo({ ...nuevo, numeroDocumento: e.target.value })} />
                </div>
                <div>
                  <Label>Teléfono</Label>
                  <Input value={nuevo.telefono} onChange={(e) => setNuevo({ ...nuevo, telefono: e.target.value })} />
                </div>
                <div>
                  <Label>Correo</Label>
                  <Input type="email" value={nuevo.email} onChange={(e) => setNuevo({ ...nuevo, email: e.target.value })} />
                </div>
              </div>
            )}
            <div>
              <Label>Parentesco</Label>
              <Input placeholder="Madre, padre, tutor…" value={parentesco} onChange={(e) => setParentesco(e.target.value)} />
            </div>
            <label className="flex items-center gap-2 text-sm">
              <Checkbox checked={autorizaRecoger} onCheckedChange={(c) => setAutorizaRecoger(c === true)} />
              Autorizado a recoger al deportista
            </label>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setVincularAbierto(false)}>
              Cancelar
            </Button>
            <Button onClick={guardarVinculo} disabled={guardandoVinculo}>
              {guardandoVinculo ? "Guardando..." : "Vincular"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Registrar consentimiento */}
      <Dialog open={consentTipo !== null} onOpenChange={(o) => !o && setConsentTipo(null)}>
        <DialogContent className="sm:max-w-[460px]">
          <DialogHeader>
            <DialogTitle>Registrar consentimiento</DialogTitle>
            <DialogDescription>
              {TIPOS.find((t) => t.valor === consentTipo)?.etiqueta}. Se guarda como evidencia: no se edita ni se
              borra, solo se puede revocar.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div>
              <Label>Versión del texto firmado</Label>
              <Input placeholder="Ej. Política v1 – 2026" value={versionTexto} onChange={(e) => setVersionTexto(e.target.value)} />
            </div>
            <div>
              <Label>Canal</Label>
              <Select value={canal} onValueChange={setCanal}>
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="PAPEL">Papel (firmado)</SelectItem>
                  <SelectItem value="DIGITAL">Digital</SelectItem>
                  <SelectItem value="OTRO">Otro</SelectItem>
                </SelectContent>
              </Select>
            </div>
            {menor && (
              <div>
                <Label>Lo otorga el acudiente</Label>
                {vinculos.length === 0 ? (
                  <p className="text-sm text-amber-600">
                    El titular es menor de edad: primero vincula un acudiente.
                  </p>
                ) : (
                  <Select value={otorgaAcudienteId} onValueChange={setOtorgaAcudienteId}>
                    <SelectTrigger>
                      <SelectValue placeholder="Selecciona el acudiente" />
                    </SelectTrigger>
                    <SelectContent>
                      {vinculos.map((v) => (
                        <SelectItem key={v.acudienteId} value={String(v.acudienteId)}>
                          {v.nombre} {v.apellidos}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                )}
              </div>
            )}
            <div>
              <Label>Observaciones (opcional)</Label>
              <Input value={observaciones} onChange={(e) => setObservaciones(e.target.value)} />
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setConsentTipo(null)}>
              Cancelar
            </Button>
            <Button onClick={guardarConsentimiento} disabled={guardandoConsent || (menor === true && vinculos.length === 0)}>
              {guardandoConsent ? "Guardando..." : "Registrar"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Clave temporal del acudiente */}
      <Dialog open={acceso !== null} onOpenChange={(o) => !o && setAcceso(null)}>
        <DialogContent className="sm:max-w-[420px]">
          <DialogHeader>
            <DialogTitle>Acceso creado</DialogTitle>
            <DialogDescription>
              Entrégale estos datos al acudiente. La clave se muestra UNA sola vez y deberá cambiarla al ingresar.
            </DialogDescription>
          </DialogHeader>
          <div className="rounded-md border p-3 text-sm space-y-1 font-mono">
            <p>Usuario: {acceso?.username}</p>
            <p>Clave temporal: {acceso?.claveTemporal}</p>
          </div>
          <DialogFooter>
            <Button onClick={() => setAcceso(null)}>Listo</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Revocar */}
      <Dialog open={revocando !== null} onOpenChange={(o) => !o && setRevocando(null)}>
        <DialogContent className="sm:max-w-[420px]">
          <DialogHeader>
            <DialogTitle>Revocar consentimiento</DialogTitle>
            <DialogDescription>El registro se conserva como evidencia, marcado como revocado.</DialogDescription>
          </DialogHeader>
          <div>
            <Label>Motivo (opcional)</Label>
            <Input value={motivo} onChange={(e) => setMotivo(e.target.value)} />
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setRevocando(null)}>
              Cancelar
            </Button>
            <Button variant="destructive" onClick={revocar}>
              Revocar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="app/components/Forms/ClaveTemporalDialog.tsx">
"use client";

import { useState } from "react";
import { Copy, Check, KeyRound } from "lucide-react";
import { toast } from "react-toastify";
import { Button } from "@/components/ui/button";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { api, getErrorMessage } from "@/lib/api";

/**
 * Llama a POST /api/usuario/{id}/clave-temporal (permiso restablecer_clave_usuario).
 * El back devuelve la clave UNA sola vez: por eso se muestra en un diálogo que
 * no se puede reabrir. Devuelve la clave o null si falló (ya muestra el error).
 */
export async function generarClaveTemporal(usuarioId: number): Promise<string | null> {
  try {
    const res = await api.post(`/api/usuario/${usuarioId}/clave-temporal`);
    return res.data?.claveTemporal ?? null;
  } catch (error: any) {
    toast.error(getErrorMessage(error, "No se pudo generar la clave temporal"));
    return null;
  }
}

interface Props {
  /** Clave a mostrar; si es null el diálogo está cerrado. */
  clave: string | null;
  /** Usuario (username) al que pertenece, solo para el texto. */
  username?: string;
  onClose: () => void;
}

export default function ClaveTemporalDialog({ clave, username, onClose }: Props) {
  const [copiado, setCopiado] = useState(false);

  const copiar = async () => {
    if (!clave) return;
    try {
      await navigator.clipboard.writeText(clave);
      setCopiado(true);
      setTimeout(() => setCopiado(false), 2000);
    } catch {
      toast.error("No se pudo copiar; selecciónala y cópiala a mano");
    }
  };

  return (
    <Dialog open={clave !== null} onOpenChange={(open) => !open && onClose()}>
      <DialogContent className="sm:max-w-[425px]">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <KeyRound className="h-5 w-5" /> Clave temporal generada
          </DialogTitle>
          <DialogDescription>
            {username ? `Usuario: ${username}. ` : ""}Esta clave se muestra <strong>una sola vez</strong>.
            Entrégala por un canal privado; la persona deberá cambiarla al iniciar sesión.
          </DialogDescription>
        </DialogHeader>
        <div className="flex items-center gap-2 rounded-md border bg-muted px-3 py-3">
          <code className="flex-1 select-all break-all text-lg font-mono tracking-wider">{clave}</code>
          <Button type="button" size="icon" variant="outline" onClick={copiar} aria-label="Copiar clave">
            {copiado ? <Check className="h-4 w-4" /> : <Copy className="h-4 w-4" />}
          </Button>
        </div>
        <DialogFooter>
          <Button onClick={onClose}>Ya la guardé</Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Horarios/CalendarioSemanal.tsx">
"use client";

import { useMemo } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

interface GrupoAsociado {
  horarioEntrenamientoId: number;
  grupoId: number;
  nombreGrupo: string;
}

interface HorarioResponseDTO {
  id: number;
  diaId: number;
  dia: string;
  horaInicio: string; // "HH:mm:ss"
  horaFin: string;
  grupos: GrupoAsociado[];
}

const DIAS_SEMANA = [
  { key: "lunes", label: "Lunes", corto: "Lun" },
  { key: "martes", label: "Martes", corto: "Mar" },
  { key: "miercoles", label: "Miércoles", corto: "Mié" },
  { key: "jueves", label: "Jueves", corto: "Jue" },
  { key: "viernes", label: "Viernes", corto: "Vie" },
  { key: "sabado", label: "Sábado", corto: "Sáb" },
  { key: "domingo", label: "Domingo", corto: "Dom" },
];

// Paleta cíclica para distinguir grupos a simple vista dentro del calendario
// — derivada de los tokens de marca (--chart-1..5), no colores sueltos.
const PALETA = [
  "bg-chart-1/15 text-chart-1 border-chart-1/40",
  "bg-chart-2/15 text-chart-2 border-chart-2/40",
  "bg-chart-3/15 text-chart-3 border-chart-3/40",
  "bg-chart-4/15 text-chart-4 border-chart-4/40",
  "bg-chart-5/15 text-chart-5 border-chart-5/40",
];

const HOUR_HEIGHT = 56; // px por hora

const normalizarDia = (dia: string) =>
  dia
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

const toMinutos = (hhmmss: string) => {
  const [h, m] = hhmmss.split(":").map(Number);
  return h * 60 + (m || 0);
};

const formatHora = (hora: string) => hora?.slice(0, 5) ?? "";

interface EventoLayout {
  horario: HorarioResponseDTO;
  startMin: number;
  endMin: number;
  col: number;
  totalCols: number;
}

// Algoritmo simple de layout tipo Google Calendar: agrupa eventos que se
// solapan en el tiempo y les reparte columnas para que no se encimen.
function layoutDia(horarios: HorarioResponseDTO[]): EventoLayout[] {
  const eventos = horarios
    .map((h) => ({
      horario: h,
      startMin: toMinutos(h.horaInicio),
      endMin: toMinutos(h.horaFin),
    }))
    .sort((a, b) => a.startMin - b.startMin || a.endMin - b.endMin);

  const columnas: (typeof eventos)[] = [];
  const asignadas = eventos.map((ev) => {
    let colIndex = columnas.findIndex(
      (col) => col[col.length - 1].endMin <= ev.startMin,
    );
    if (colIndex === -1) {
      colIndex = columnas.length;
      columnas.push([]);
    }
    columnas[colIndex].push(ev);
    return { ...ev, col: colIndex };
  });

  const totalCols = Math.max(columnas.length, 1);
  return asignadas.map((ev) => ({ ...ev, totalCols }));
}

export default function CalendarioSemanal({
  horarios,
}: {
  horarios: HorarioResponseDTO[];
}) {
  const { startHour, endHour } = useMemo(() => {
    if (horarios.length === 0) return { startHour: 7, endHour: 21 };
    const minStart = Math.min(...horarios.map((h) => toMinutos(h.horaInicio)));
    const maxEnd = Math.max(...horarios.map((h) => toMinutos(h.horaFin)));
    let sH = Math.floor(minStart / 60);
    let eH = Math.ceil(maxEnd / 60);
    if (eH - sH < 6) eH = sH + 6; // rango mínimo para que no se vea vacío
    return { startHour: sH, endHour: eH };
  }, [horarios]);

  const horas = useMemo(
    () => Array.from({ length: endHour - startHour + 1 }, (_, i) => startHour + i),
    [startHour, endHour],
  );

  const eventosPorDia = useMemo(() => {
    const map = new Map<string, HorarioResponseDTO[]>();
    DIAS_SEMANA.forEach((d) => map.set(d.key, []));
    horarios.forEach((h) => {
      const key = normalizarDia(h.dia);
      if (map.has(key)) {
        map.get(key)!.push(h);
      }
    });
    return map;
  }, [horarios]);

  // Asigna un color estable a cada grupo según el orden en que aparece,
  // así el mismo grupo se ve igual en todos los días de la semana.
  const colorPorGrupoId = useMemo(() => {
    const map = new Map<number, string>();
    let idx = 0;
    horarios.forEach((h) =>
      h.grupos.forEach((g) => {
        if (!map.has(g.grupoId)) {
          map.set(g.grupoId, PALETA[idx % PALETA.length]);
          idx++;
        }
      }),
    );
    return map;
  }, [horarios]);

  const totalAltura = (endHour - startHour) * HOUR_HEIGHT;

  if (horarios.length === 0) {
    return (
      <Card>
        <CardContent className="py-10 text-center text-muted-foreground">
          No hay horarios registrados todavía. Crea un horario para verlo en
          el calendario.
        </CardContent>
      </Card>
    );
  }

  return (
    <Card>
      <CardContent className="pt-6">
        <div className="overflow-x-auto">
          <div
            className="grid"
            style={{
              gridTemplateColumns: `56px repeat(${DIAS_SEMANA.length}, minmax(130px, 1fr))`,
              minWidth: `${56 + DIAS_SEMANA.length * 130}px`,
            }}
          >
            {/* Encabezado de días */}
            <div />
            {DIAS_SEMANA.map((d) => (
              <div
                key={d.key}
                className="text-center text-sm font-display font-semibold py-2 border-b"
              >
                <span className="hidden sm:inline">{d.label}</span>
                <span className="sm:hidden">{d.corto}</span>
              </div>
            ))}

            {/* Columna de horas */}
            <div className="relative" style={{ height: totalAltura }}>
              {horas.slice(0, -1).map((h) => (
                <div
                  key={h}
                  className="absolute right-2 -translate-y-1/2 text-xs text-muted-foreground"
                  style={{ top: (h - startHour) * HOUR_HEIGHT }}
                >
                  {String(h).padStart(2, "0")}:00
                </div>
              ))}
            </div>

            {/* Columnas de días con eventos */}
            {DIAS_SEMANA.map((d) => {
              const eventosDia = layoutDia(eventosPorDia.get(d.key) ?? []);
              return (
                <div
                  key={d.key}
                  className="relative border-l"
                  style={{ height: totalAltura }}
                >
                  {/* Líneas guía por hora */}
                  {horas.map((h) => (
                    <div
                      key={h}
                      className="absolute left-0 right-0 border-t border-dashed border-muted"
                      style={{ top: (h - startHour) * HOUR_HEIGHT }}
                    />
                  ))}

                  {/* Bloques de horario */}
                  {eventosDia.map((ev) => {
                    const top = ((ev.startMin - startHour * 60) / 60) * HOUR_HEIGHT;
                    const height = Math.max(
                      ((ev.endMin - ev.startMin) / 60) * HOUR_HEIGHT - 2,
                      22,
                    );
                    const widthPct = 100 / ev.totalCols;
                    const leftPct = widthPct * ev.col;
                    const nombresGrupos = ev.horario.grupos.map(
                      (g) => g.nombreGrupo,
                    );
                    const color =
                      ev.horario.grupos.length > 0
                        ? colorPorGrupoId.get(ev.horario.grupos[0].grupoId)
                        : "bg-muted text-muted-foreground border-dashed";

                    return (
                      <div
                        key={ev.horario.id}
                        title={`${nombresGrupos.join(", ") || "Sin grupo asignado"} · ${formatHora(ev.horario.horaInicio)}-${formatHora(ev.horario.horaFin)}`}
                        className={`absolute rounded-md border px-1.5 py-1 text-[11px] leading-tight overflow-hidden ${color}`}
                        style={{
                          top,
                          height,
                          left: `${leftPct}%`,
                          width: `calc(${widthPct}% - 4px)`,
                        }}
                      >
                        <div className="font-semibold">
                          {formatHora(ev.horario.horaInicio)}-
                          {formatHora(ev.horario.horaFin)}
                        </div>
                        <div className="truncate">
                          {nombresGrupos.length > 0
                            ? nombresGrupos.join(", ")
                            : "Sin grupo"}
                        </div>
                      </div>
                    );
                  })}
                </div>
              );
            })}
          </div>
        </div>

        {/* Leyenda de grupos */}
        {colorPorGrupoId.size > 0 && (
          <div className="flex flex-wrap gap-2 mt-4 pt-4 border-t">
            {Array.from(colorPorGrupoId.entries()).map(([grupoId, color]) => {
              const nombre = horarios
                .flatMap((h) => h.grupos)
                .find((g) => g.grupoId === grupoId)?.nombreGrupo;
              return (
                <Badge key={grupoId} variant="outline" className={color}>
                  {nombre}
                </Badge>
              );
            })}
          </div>
        )}
      </CardContent>
    </Card>
  );
}
</file>

<file path="app/components/inventario/ProductoFormModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Switch } from "@/components/ui/switch";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import { CategoriaProducto } from "./CategoriasProductoPanel";

export interface Producto {
  id: number;
  sku: string;
  nombre: string;
  descripcion: string;
  categoriaProductoId: number;
  categoriaNombre: string;
  precioMinReferencia: number;
  precioMaxReferencia: number;
  origen: string;
  notasProveedor: string;
  requiereControlStock: boolean;
  activo: boolean;
  stockTotal: number | null;
}

const FORM_VACIO = {
  codigo: "",
  nombre: "",
  descripcion: "",
  categoriaProductoId: "",
  precioMinReferencia: "",
  precioMaxReferencia: "",
  origen: "",
  notasProveedor: "",
  requiereControlStock: true,
};

export default function ProductoFormModal({
  open,
  onOpenChange,
  producto,
  onGuardado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  producto: Producto | null;
  onGuardado: () => void;
}) {
  const [categorias, setCategorias] = useState<CategoriaProducto[]>([]);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  useEffect(() => {
    if (!open) return;
    api
      .get("/api/categorias-producto")
      .then((res) => setCategorias(res.data))
      .catch(() => toast.error("No se pudieron cargar las categorías"));

    if (producto) {
      setForm({
        codigo: "",
        nombre: producto.nombre,
        descripcion: producto.descripcion ?? "",
        categoriaProductoId: String(producto.categoriaProductoId),
        precioMinReferencia: String(producto.precioMinReferencia ?? ""),
        precioMaxReferencia: String(producto.precioMaxReferencia ?? ""),
        origen: producto.origen ?? "",
        notasProveedor: producto.notasProveedor ?? "",
        requiereControlStock: producto.requiereControlStock,
      });
    } else {
      setForm(FORM_VACIO);
    }
  }, [open, producto]);

  const guardar = async () => {
    if (!form.nombre.trim() || !form.categoriaProductoId) {
      toast.error("Nombre y categoría son obligatorios");
      return;
    }
    if (!producto && !form.codigo.trim()) {
      toast.error("El código del artículo es obligatorio (se usa para armar el SKU)");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        codigo: form.codigo || undefined,
        nombre: form.nombre,
        descripcion: form.descripcion,
        categoriaProductoId: Number(form.categoriaProductoId),
        precioMinReferencia: form.precioMinReferencia ? Number(form.precioMinReferencia) : null,
        precioMaxReferencia: form.precioMaxReferencia ? Number(form.precioMaxReferencia) : null,
        origen: form.origen,
        notasProveedor: form.notasProveedor,
        requiereControlStock: form.requiereControlStock,
      };
      if (producto) {
        await api.put(`/api/productos/${producto.id}`, payload);
        toast.success("Producto actualizado");
      } else {
        await api.post("/api/productos", payload);
        toast.success("Producto creado");
      }
      onOpenChange(false);
      onGuardado();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el producto",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-lg max-h-[85vh] flex flex-col p-0">
        <DialogHeader className="px-6 pt-6 pb-2">
          <DialogTitle>{producto ? "Editar producto" : "Nuevo producto"}</DialogTitle>
        </DialogHeader>
        <div className="space-y-4 px-6 py-4 overflow-y-auto flex-1">
          <div className="grid gap-1.5">
            <Label>Nombre</Label>
            <Input
              value={form.nombre}
              onChange={(e) => setForm({ ...form, nombre: e.target.value })}
              placeholder="Ej. Camiseta de entrenamiento"
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Categoría</Label>
            <Select
              value={form.categoriaProductoId}
              onValueChange={(v) => setForm({ ...form, categoriaProductoId: v })}
            >
              <SelectTrigger>
                <SelectValue placeholder="Selecciona una categoría" />
              </SelectTrigger>
              <SelectContent>
                {categorias.map((c) => (
                  <SelectItem key={c.id} value={String(c.id)}>
                    {c.nombre}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          {!producto && (
            <div className="grid gap-1.5">
              <Label>Código del artículo (3 letras)</Label>
              <Input
                value={form.codigo}
                maxLength={3}
                onChange={(e) => setForm({ ...form, codigo: e.target.value.toUpperCase() })}
                placeholder="Ej. CAE"
              />
              <p className="text-xs text-muted-foreground">
                El SKU completo se arma solo (RAT + categoría + este código).
              </p>
            </div>
          )}
          <div className="grid gap-1.5">
            <Label>Descripción</Label>
            <Textarea
              value={form.descripcion}
              onChange={(e) => setForm({ ...form, descripcion: e.target.value })}
            />
          </div>
          <div className="flex gap-4">
            <div className="flex-1 grid gap-1.5">
              <Label>Precio mín. referencia</Label>
              <Input
                type="number"
                value={form.precioMinReferencia}
                onChange={(e) => setForm({ ...form, precioMinReferencia: e.target.value })}
              />
            </div>
            <div className="flex-1 grid gap-1.5">
              <Label>Precio máx. referencia</Label>
              <Input
                type="number"
                value={form.precioMaxReferencia}
                onChange={(e) => setForm({ ...form, precioMaxReferencia: e.target.value })}
              />
            </div>
          </div>
          {producto ? (
            <p className="text-xs text-muted-foreground">
              El stock se maneja por variante (talla/color). Agrega o ajusta variantes desde
              el detalle del producto para registrar entradas de inventario.
            </p>
          ) : (
            <p className="text-xs text-muted-foreground">
              Si llenas al menos un precio de referencia, se crea automáticamente una variante
              base (sin talla/color) con stock inicial en 0 — así el producto ya aparece en
              Inventario y Ventas. Si dejas ambos precios vacíos, tendrás que crear la primera
              variante manualmente después, desde el detalle del producto.
            </p>
          )}
          <div className="grid gap-1.5">
            <Label>Origen / Proveedor</Label>
            <Input
              value={form.origen}
              onChange={(e) => setForm({ ...form, origen: e.target.value })}
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Notas del proveedor</Label>
            <Textarea
              value={form.notasProveedor}
              onChange={(e) => setForm({ ...form, notasProveedor: e.target.value })}
            />
          </div>
          <div className="flex items-center gap-2">
            <Switch
              id="requiere-stock"
              checked={form.requiereControlStock}
              onCheckedChange={(v) => setForm({ ...form, requiereControlStock: v })}
            />
            <Label htmlFor="requiere-stock">Controlar stock de este producto</Label>
          </div>
        </div>
        <DialogFooter className="gap-3 px-6 pb-6 pt-3 border-t">
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={guardando}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={guardando}>
            {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
            Guardar
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

