                  <CardDescription>Premios ganados</CardDescription>
                </CardHeader>
                <CardContent>
                  {cargandoEventos ? (
                    <div className="flex items-center justify-center py-6 text-muted-foreground">
                      <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
                    </div>
                  ) : resumenEventos ? (
                    <>
                      <div className="text-2xl font-bold mb-3">
                        {resumenEventos.podiosTemporada} podios esta temporada
                      </div>
                      {resumenEventos.premiosGanados.length > 0 ? (
                        <div className="space-y-2">
                          {resumenEventos.premiosGanados.slice(0, 5).map((p, i) => (
                            <div key={i} className="text-sm border-b pb-2 last:border-0">
                              <span className="font-medium">#{p.posicion}</span> — {p.nombreGrupo} en{" "}
                              {p.nombreEvento}
                              {p.descripcionPremio ? ` (${p.descripcionPremio})` : ""}
                            </div>
                          ))}
                        </div>
                      ) : (
                        <p className="text-sm text-muted-foreground">
                          Todavía no hay premios registrados esta temporada.
                        </p>
                      )}
                    </>
                  ) : null}
                </CardContent>
              </Card>
            </div>
          </TabsContent>
        </Tabs>
      </div>
    </ProtectedRoute>
  );
}

function KpiCard({
  title,
  value,
  description,
  icon,
  link,
}: {
  title: string;
  value: string;
  description: string;
  icon: React.ReactNode;
  link: string;
}) {
  return (
    <Link href={link} className="block">
      <Card className="hover:shadow-md transition-shadow">
        <CardHeader className="flex flex-row items-center justify-between pb-2">
          <CardTitle className="text-sm font-medium">{title}</CardTitle>
          {icon}
        </CardHeader>
        <CardContent>
          <div className="text-2xl font-bold">{value}</div>
          <div className="flex items-center mt-1">
            <span className="text-xs text-muted-foreground">{description}</span>
          </div>
        </CardContent>
      </Card>
    </Link>
  );
}

function AlertItem({
  title,
  description,
  type,
}: {
  title: string;
  description: string;
  type: "warning" | "info" | "error";
}) {
  return (
    <div className="flex items-start space-x-4">
      <div
        className={`rounded-full p-2 ${
          type === "warning"
            ? "bg-yellow-100 text-yellow-600"
            : type === "error"
              ? "bg-red-100 text-red-600"
              : "bg-blue-100 text-blue-600"
        }`}
      >
        <AlertTriangle className="h-4 w-4" />
      </div>
      <div className="flex-1 space-y-1">
        <p className="text-sm font-medium leading-none">{title}</p>
        <p className="text-sm text-muted-foreground">{description}</p>
      </div>
    </div>
  );
}
