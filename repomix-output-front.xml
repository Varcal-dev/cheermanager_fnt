<file path="app/components/deportistas/ObjetivosPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Target, Pencil, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface EstadoObjetivo {
  id: number;
  nombreEstado: string;
}

interface Objetivo {
  id: number;
  deportistaId: number;
  nombreDeportista: string;
  nombre: string;
  descripcion: string;
  fechaCreacion: string;
  estadoObjetivoId: number;
  estadoObjetivo: string;
}

const FORM_VACIO = { nombre: "", descripcion: "", estadoObjetivoId: "" };

function badgeVariant(estado: string) {
  const e = estado.toLowerCase();
  if (e.includes("cumpl")) return "default" as const;
  if (e.includes("proceso") || e.includes("progreso")) return "outline" as const;
  return "secondary" as const;
}

export default function ObjetivosPanel({
  deportistaId,
}: {
  deportistaId: number;
}) {
  const [cargando, setCargando] = useState(true);
  const [objetivos, setObjetivos] = useState<Objetivo[]>([]);
  const [estados, setEstados] = useState<EstadoObjetivo[]>([]);

  const [modalAbierto, setModalAbierto] = useState(false);
  const [objetivoEnEdicion, setObjetivoEnEdicion] = useState<Objetivo | null>(null);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    Promise.allSettled([
      api.get(`/api/objetivos/deportista/${deportistaId}`),
      api.get("/api/estados-objetivo"),
    ]).then(([resObjetivos, resEstados]) => {
      if (resObjetivos.status === "fulfilled") setObjetivos(resObjetivos.value.data);
      else toast.error("No se pudieron cargar los objetivos");

      if (resEstados.status === "fulfilled") setEstados(resEstados.value.data);

      setCargando(false);
    });
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [deportistaId]);

  const abrirNuevo = () => {
    setObjetivoEnEdicion(null);
    setForm({
      nombre: "",
      descripcion: "",
      estadoObjetivoId: estados[0] ? String(estados[0].id) : "",
    });
    setModalAbierto(true);
  };

  const abrirEdicion = (objetivo: Objetivo) => {
    setObjetivoEnEdicion(objetivo);
    setForm({
      nombre: objetivo.nombre,
      descripcion: objetivo.descripcion ?? "",
      estadoObjetivoId: String(objetivo.estadoObjetivoId),
    });
    setModalAbierto(true);
  };

  const guardar = async () => {
    if (!form.nombre.trim()) {
      toast.error("El nombre del objetivo es obligatorio");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        deportistaId,
        nombre: form.nombre,
        descripcion: form.descripcion,
        fechaCreacion:
          objetivoEnEdicion?.fechaCreacion ?? new Date().toISOString().slice(0, 10),
        estadoObjetivoId: form.estadoObjetivoId ? Number(form.estadoObjetivoId) : null,
      };

      if (objetivoEnEdicion) {
        await api.put(`/api/objetivos/${objetivoEnEdicion.id}`, payload);
        toast.success("Objetivo actualizado");
      } else {
        await api.post("/api/objetivos", payload);
        toast.success("Objetivo creado");
      }
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el objetivo",
      );
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async (id: number) => {
    if (!confirm("¿Eliminar este objetivo? Esta acción no se puede deshacer.")) return;
    try {
      await api.delete(`/api/objetivos/${id}`);
      toast.success("Objetivo eliminado");
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo eliminar el objetivo",
      );
    }
  };

  const cambiarEstadoRapido = async (objetivo: Objetivo, nuevoEstadoId: string) => {
    try {
      await api.patch(`/api/objetivos/${objetivo.id}/estado`, {
        estadoObjetivoId: Number(nuevoEstadoId),
      });
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo cambiar el estado",
      );
    }
  };

  return (
    <div>
      <div className="flex justify-between items-center mb-4">
        <h4 className="font-semibold">Objetivos</h4>
        <Button size="sm" variant="outline" onClick={abrirNuevo}>
          <Target className="h-4 w-4 mr-1" /> Nuevo Objetivo
        </Button>
      </div>

      {cargando ? (
        <div className="flex items-center justify-center py-6 text-muted-foreground">
          <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
        </div>
      ) : objetivos.length === 0 ? (
        <div className="text-center py-4 text-muted-foreground">
          No hay objetivos registrados
        </div>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Objetivo</TableHead>
              <TableHead>Descripción</TableHead>
              <TableHead>Fecha Creación</TableHead>
              <TableHead>Estado</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {objetivos.map((objetivo) => (
              <TableRow key={objetivo.id}>
                <TableCell>{objetivo.nombre}</TableCell>
                <TableCell>{objetivo.descripcion}</TableCell>
                <TableCell>
                  {new Date(objetivo.fechaCreacion).toLocaleDateString()}
                </TableCell>
                <TableCell>
                  {estados.length > 0 ? (
                    <Select
                      value={String(objetivo.estadoObjetivoId)}
                      onValueChange={(v) => cambiarEstadoRapido(objetivo, v)}
                    >
                      <SelectTrigger className="h-8 w-[150px]">
                        <SelectValue>
                          <Badge variant={badgeVariant(objetivo.estadoObjetivo)}>
                            {objetivo.estadoObjetivo}
                          </Badge>
                        </SelectValue>
                      </SelectTrigger>
                      <SelectContent>
                        {estados.map((e) => (
                          <SelectItem key={e.id} value={String(e.id)}>
                            {e.nombreEstado}
                          </SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  ) : (
                    <Badge variant={badgeVariant(objetivo.estadoObjetivo)}>
                      {objetivo.estadoObjetivo}
                    </Badge>
                  )}
                </TableCell>
                <TableCell>
                  <div className="flex space-x-2">
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => abrirEdicion(objetivo)}
                    >
                      <Pencil className="h-4 w-4 mr-1" /> Editar
                    </Button>
                    <Button
                      variant="destructive"
                      size="sm"
                      onClick={() => eliminar(objetivo.id)}
                    >
                      <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>
              {objetivoEnEdicion ? "Editar objetivo" : "Nuevo objetivo"}
            </DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid gap-1.5">
              <Label>Nombre</Label>
              <Input
                value={form.nombre}
                onChange={(e) => setForm({ ...form, nombre: e.target.value })}
                placeholder="Ej. Mejorar flexibilidad"
              />
            </div>
            <div className="grid gap-1.5">
              <Label>Descripción</Label>
              <Textarea
                value={form.descripcion}
                onChange={(e) => setForm({ ...form, descripcion: e.target.value })}
              />
            </div>
            <div className="grid gap-1.5">
              <Label>Estado</Label>
              <Select
                value={form.estadoObjetivoId}
                onValueChange={(v) => setForm({ ...form, estadoObjetivoId: v })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un estado" />
                </SelectTrigger>
                <SelectContent>
                  {estados.map((e) => (
                    <SelectItem key={e.id} value={String(e.id)}>
                      {e.nombreEstado}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              {estados.length === 0 && (
                <p className="text-xs text-muted-foreground">
                  No hay estados configurados todavía en /api/estados-objetivo.
                </p>
              )}
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="app/components/eventos/EventoFormModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Switch } from "@/components/ui/switch";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

export interface Evento {
  id: number;
  nombre: string;
  fecha: string;
  tipoEventoId: number;
  tipoEvento: string;
  ubicacion: string;
  tieneResultados: boolean;
  cantidadGruposInscritos: number;
  cantidadPremios: number;
}

interface TipoEvento {
  id: number;
  evento: string;
}

const FORM_VACIO = {
  nombre: "",
  fecha: "",
  tipoEventoId: "",
  ubicacion: "",
  tieneResultados: true,
};

export default function EventoFormModal({
  open,
  onOpenChange,
  evento,
  onGuardado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  evento: Evento | null;
  onGuardado: () => void;
}) {
  const [tiposEvento, setTiposEvento] = useState<TipoEvento[]>([]);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  useEffect(() => {
    if (!open) return;
    api
      .get("/api/tipos-evento")
      .then((res) => setTiposEvento(res.data))
      .catch(() => toast.error("No se pudieron cargar los tipos de evento"));

    if (evento) {
      setForm({
        nombre: evento.nombre,
        fecha: evento.fecha,
        tipoEventoId: String(evento.tipoEventoId),
        ubicacion: evento.ubicacion ?? "",
        tieneResultados: evento.tieneResultados,
      });
    } else {
      setForm(FORM_VACIO);
    }
  }, [open, evento]);

  const guardar = async () => {
    if (!form.nombre.trim() || !form.fecha || !form.tipoEventoId) {
      toast.error("Nombre, fecha y tipo de evento son obligatorios");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        nombre: form.nombre,
        fecha: form.fecha,
        tipoEventoId: Number(form.tipoEventoId),
        ubicacion: form.ubicacion,
        tieneResultados: form.tieneResultados,
      };
      if (evento) {
        await api.put(`/api/eventos/${evento.id}`, payload);
        toast.success("Evento actualizado");
      } else {
        await api.post("/api/eventos", payload);
        toast.success("Evento creado");
      }
      onOpenChange(false);
      onGuardado();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el evento",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle>{evento ? "Editar evento" : "Nuevo evento"}</DialogTitle>
        </DialogHeader>
        <div className="space-y-4">
          <div className="grid gap-1.5">
            <Label>Nombre</Label>
            <Input
              value={form.nombre}
              onChange={(e) => setForm({ ...form, nombre: e.target.value })}
              placeholder="Ej. Copa Andina 2026"
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Tipo de evento</Label>
            <Select
              value={form.tipoEventoId}
              onValueChange={(v) => setForm({ ...form, tipoEventoId: v })}
            >
              <SelectTrigger>
                <SelectValue placeholder="Selecciona un tipo" />
              </SelectTrigger>
              <SelectContent>
                {tiposEvento.map((t) => (
                  <SelectItem key={t.id} value={String(t.id)}>
                    {t.evento}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          <div className="grid gap-1.5">
            <Label>Fecha</Label>
            <Input
              type="date"
              value={form.fecha}
              onChange={(e) => setForm({ ...form, fecha: e.target.value })}
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Ubicación</Label>
            <Input
              value={form.ubicacion}
              onChange={(e) => setForm({ ...form, ubicacion: e.target.value })}
              placeholder="Ej. Coliseo El Campín, Bogotá"
            />
          </div>
          <div className="flex items-center gap-2">
            <Switch
              id="tiene-resultados"
              checked={form.tieneResultados}
              onCheckedChange={(v) => setForm({ ...form, tieneResultados: v })}
            />
            <Label htmlFor="tiene-resultados">
              El organizador publica resultados oficiales
            </Label>
          </div>
        </div>
        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={guardando}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={guardando}>
            {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
            Guardar
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/eventos/GruposEventoPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { UserPlus, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface GrupoEvento {
  id: number;
  grupoEntrenamientoId: number;
  nombreGrupo: string;
}

interface GrupoOpcion {
  id: number;
  nombre: string;
}

export default function GruposEventoPanel({ eventoId }: { eventoId: number }) {
  const [cargando, setCargando] = useState(true);
  const [grupos, setGrupos] = useState<GrupoEvento[]>([]);
  const [gruposDisponibles, setGruposDisponibles] = useState<GrupoOpcion[]>([]);
  const [grupoSeleccionado, setGrupoSeleccionado] = useState("");
  const [inscribiendo, setInscribiendo] = useState(false);

  const cargar = () => {
    setCargando(true);
    Promise.allSettled([
      api.get(`/api/grupos-evento/evento/${eventoId}`),
      api.get("/api/grupos"),
    ]).then(([resGrupos, resDisponibles]) => {
      if (resGrupos.status === "fulfilled") setGrupos(resGrupos.value.data);
      else toast.error("No se pudieron cargar los grupos inscritos");

      if (resDisponibles.status === "fulfilled") setGruposDisponibles(resDisponibles.value.data);

      setCargando(false);
    });
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [eventoId]);

  const inscribir = async () => {
    if (!grupoSeleccionado) {
      toast.error("Selecciona un grupo");
      return;
    }
    setInscribiendo(true);
    try {
      await api.post("/api/grupos-evento", {
        grupoEntrenamientoId: Number(grupoSeleccionado),
        eventoId,
      });
      toast.success("Grupo inscrito al evento");
      setGrupoSeleccionado("");
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo inscribir el grupo",
      );
    } finally {
      setInscribiendo(false);
    }
  };

  const desinscribir = async (id: number) => {
    if (!confirm("¿Quitar este grupo del evento?")) return;
    try {
      await api.delete(`/api/grupos-evento/${id}`);
      toast.success("Grupo desinscrito");
      cargar();
    } catch {
      toast.error("No se pudo desinscribir el grupo");
    }
  };

  const grupoIdsYaInscritos = new Set(grupos.map((g) => g.grupoEntrenamientoId));
  const opcionesParaInscribir = gruposDisponibles.filter(
    (g) => !grupoIdsYaInscritos.has(g.id),
  );

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex gap-2">
        <Select value={grupoSeleccionado} onValueChange={setGrupoSeleccionado}>
          <SelectTrigger className="w-[260px]">
            <SelectValue placeholder="Selecciona un grupo para inscribir" />
          </SelectTrigger>
          <SelectContent>
            {opcionesParaInscribir.map((g) => (
              <SelectItem key={g.id} value={String(g.id)}>
                {g.nombre}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
        <Button size="sm" onClick={inscribir} disabled={inscribiendo}>
          {inscribiendo ? (
            <Loader2 className="h-4 w-4 animate-spin mr-1" />
          ) : (
            <UserPlus className="h-4 w-4 mr-1" />
          )}
          Inscribir
        </Button>
      </div>

      {grupos.length === 0 ? (
        <p className="text-center py-4 text-muted-foreground">
          Ningún grupo inscrito todavía.
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Grupo</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {grupos.map((g) => (
              <TableRow key={g.id}>
                <TableCell>{g.nombreGrupo}</TableCell>
                <TableCell>
                  <Button variant="destructive" size="sm" onClick={() => desinscribir(g.id)}>
                    <Trash2 className="h-4 w-4 mr-1" /> Quitar
                  </Button>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}
    </div>
  );
}
