              >
                <SelectTrigger id="rolId" className="w-full">
                  <SelectValue placeholder="Seleccionar rol" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="3">Entrenador</SelectItem>
                  <SelectItem value="4">Asistente</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div>
