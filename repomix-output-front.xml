<file path="app/components/Forms/NuevoHorarioModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Checkbox } from "@/components/ui/checkbox";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

interface DiaSemana {
  id: number;
  dia: string;
}

interface GrupoSimple {
  id: number;
  nombre: string;
}

interface HorarioEditar {
  id: number;
  diaId: number;
  horaInicio: string; // "HH:mm" o "HH:mm:ss"
  horaFin: string;
}

// Un solo modal para dos casos:
// - Crear: uno o varios días (checkboxes) + hora inicio + hora fin. Cada día
//   marcado genera un Horario independiente (el backend modela un Horario
//   como UN solo día), con opción de asignarlos todos de una vez al mismo
//   grupo.
// - Editar: un horario existente ya es un día puntual, así que aquí el
//   selector de día vuelve a ser único (no tendría sentido "editar y
//   convertir en 3 días" un registro que ya está vinculado a asistencias).
export default function NuevoHorarioModal({
  open,
  onOpenChange,
  horarioEditar,
  grupos,
  onGuardado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  horarioEditar?: HorarioEditar | null;
  grupos: GrupoSimple[];
  onGuardado: () => void;
}) {
  const esEdicion = !!horarioEditar;

  const [dias, setDias] = useState<DiaSemana[]>([]);
  const [diaIdEdicion, setDiaIdEdicion] = useState("");
  const [diasSeleccionados, setDiasSeleccionados] = useState<string[]>([]);
  const [horaInicio, setHoraInicio] = useState("");
  const [horaFin, setHoraFin] = useState("");
  const [grupoIdAsignar, setGrupoIdAsignar] = useState("");
  const [guardando, setGuardando] = useState(false);

  useEffect(() => {
    if (open) {
      api
        .get(`/api/dias-semana`)
        .then((res) => setDias(res.data))
        .catch((err) => {
          console.error("Error al cargar días de la semana", err);
          toast.error("No se pudo cargar el catálogo de días");
        });

      if (horarioEditar) {
        setDiaIdEdicion(String(horarioEditar.diaId));
        setHoraInicio(horarioEditar.horaInicio.slice(0, 5));
        setHoraFin(horarioEditar.horaFin.slice(0, 5));
      } else {
        setDiaIdEdicion("");
        setDiasSeleccionados([]);
        setHoraInicio("");
        setHoraFin("");
      }
      setGrupoIdAsignar("");
    }
  }, [open, horarioEditar]);

  const toggleDia = (diaId: string, checked: boolean) => {
    setDiasSeleccionados((prev) =>
      checked ? [...prev, diaId] : prev.filter((d) => d !== diaId),
    );
  };

  const handleGuardarEdicion = async () => {
    if (!horarioEditar) return;
    setGuardando(true);
    try {
      await api.put(`/api/horarios/${horarioEditar.id}`, {
        diaId: Number(diaIdEdicion),
        horaInicio,
        horaFin,
      });
      toast.success("Horario actualizado correctamente");
      onGuardado();
      onOpenChange(false);
    } catch (error: any) {
      console.error("Error al actualizar horario:", error);
      toast.error(
        error.response?.data?.message ||
          error.response?.data ||
          "Error al actualizar el horario.",
      );
    } finally {
      setGuardando(false);
    }
  };

  const handleCrear = async () => {
    setGuardando(true);
    try {
      // Un POST /api/horarios por cada día marcado (allSettled: si un día
      // falla -ej. ya existe ese mismo bloque-, los demás se crean igual).
      const resultados = await Promise.allSettled(
        diasSeleccionados.map((diaId) =>
          api.post(`/api/horarios`, {
            diaId: Number(diaId),
            horaInicio,
            horaFin,
          }),
        ),
      );

      const creados = resultados
        .filter(
          (r): r is PromiseFulfilledResult<any> => r.status === "fulfilled",
        )
        .map((r) => r.value.data);

      const fallidos = resultados.filter((r) => r.status === "rejected");

      if (grupoIdAsignar && creados.length > 0) {
        const asignaciones = await Promise.allSettled(
          creados.map((horario) =>
            api.post(`/api/horarios/asignar-grupo`, {
              horarioId: horario.id,
              grupoEntrenamientoId: Number(grupoIdAsignar),
            }),
          ),
        );
        const asignacionesFallidas = asignaciones.filter(
          (a) => a.status === "rejected",
        );
        if (asignacionesFallidas.length > 0) {
          toast.warn(
            `${creados.length - asignacionesFallidas.length} de ${creados.length} horarios se asignaron al grupo. Los demás puedes asignarlos manualmente desde la tabla.`,
          );
        }
      }

      if (fallidos.length === 0) {
        toast.success(
          creados.length === 1
            ? "Horario creado correctamente"
            : `${creados.length} horarios creados correctamente`,
        );
      } else if (creados.length > 0) {
        toast.warn(
          `Se crearon ${creados.length} de ${diasSeleccionados.length} horarios. Revisa la consola para ver qué días fallaron.`,
        );
        console.error(
          "Días que no se pudieron crear:",
          fallidos.map((f: any) => f.reason?.response?.data ?? f.reason),
        );
      } else {
        toast.error("No se pudo crear ningún horario. Intenta de nuevo.");
        console.error(
          "Errores al crear horarios:",
          fallidos.map((f: any) => f.reason?.response?.data ?? f.reason),
        );
        return;
      }

      onGuardado();
      onOpenChange(false);
    } finally {
      setGuardando(false);
    }
  };

  const handleGuardar = () => {
    if (esEdicion) {
      if (!diaIdEdicion || !horaInicio || !horaFin) {
        toast.error("Completa día, hora de inicio y hora de fin");
        return;
      }
    } else {
      if (diasSeleccionados.length === 0 || !horaInicio || !horaFin) {
        toast.error(
          "Selecciona al menos un día y completa las horas de inicio y fin",
        );
        return;
      }
    }
    if (horaInicio >= horaFin) {
      toast.error("La hora de inicio debe ser anterior a la hora de fin");
      return;
    }

    if (esEdicion) {
      handleGuardarEdicion();
    } else {
      handleCrear();
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>
            {esEdicion ? "Editar horario" : "Nuevo bloque de horario"}
          </DialogTitle>
          <DialogDescription>
            {esEdicion
              ? "Ajusta el día u horas de este bloque."
              : "Marca uno o varios días (ej. Martes y Jueves) para crear un horario por cada uno, con las mismas horas."}
          </DialogDescription>
        </DialogHeader>

        <div className="grid gap-4 py-2">
          {esEdicion ? (
            <div>
              <label className="text-sm font-medium">Día</label>
              <Select onValueChange={setDiaIdEdicion} value={diaIdEdicion}>
                <SelectTrigger className="w-full">
                  <SelectValue placeholder="Seleccionar día" />
                </SelectTrigger>
                <SelectContent>
                  {dias.map((d) => (
                    <SelectItem key={d.id} value={d.id.toString()}>
                      {d.dia}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
          ) : (
            <div>
              <label className="text-sm font-medium">Días</label>
              <div className="grid grid-cols-2 gap-2 mt-1 border rounded-md p-3">
                {dias.length === 0 ? (
                  <span className="text-sm text-muted-foreground col-span-2">
                    Cargando días...
                  </span>
                ) : (
                  dias.map((d) => {
                    const idStr = d.id.toString();
                    const checked = diasSeleccionados.includes(idStr);
                    return (
                      <label
                        key={d.id}
                        className="flex items-center gap-2 text-sm cursor-pointer"
                      >
                        <Checkbox
                          checked={checked}
                          onCheckedChange={(v) => toggleDia(idStr, !!v)}
                        />
                        {d.dia}
                      </label>
                    );
                  })
                )}
              </div>
            </div>
          )}

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text-sm font-medium">Hora de inicio</label>
              <Input
                type="time"
                value={horaInicio}
                onChange={(e) => setHoraInicio(e.target.value)}
              />
            </div>
            <div>
              <label className="text-sm font-medium">Hora de fin</label>
              <Input
                type="time"
                value={horaFin}
                onChange={(e) => setHoraFin(e.target.value)}
              />
            </div>
          </div>

          {!esEdicion && (
            <div>
              <label className="text-sm font-medium">
                Asignar a un grupo (opcional)
              </label>
              <Select onValueChange={setGrupoIdAsignar} value={grupoIdAsignar}>
                <SelectTrigger className="w-full">
                  <SelectValue placeholder="Sin asignar por ahora" />
                </SelectTrigger>
                <SelectContent>
                  {grupos.map((g) => (
                    <SelectItem key={g.id} value={g.id.toString()}>
                      {g.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              {diasSeleccionados.length > 1 && grupoIdAsignar && (
                <p className="text-xs text-muted-foreground mt-1">
                  Se asignará al grupo en cada uno de los{" "}
                  {diasSeleccionados.length} días marcados.
                </p>
              )}
            </div>
          )}
        </div>

        <div className="flex justify-end space-x-2">
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Cancelar
          </Button>
          <Button onClick={handleGuardar} disabled={guardando}>
            {guardando
              ? "Guardando..."
              : esEdicion
                ? "Guardar cambios"
                : diasSeleccionados.length > 1
                  ? `Crear ${diasSeleccionados.length} horarios`
                  : "Crear"}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Forms/PlanPagoModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { Pencil, Plus } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

const planSchema = z.object({
  nombre: z.string().min(1, "Requerido"),
  tipoPlanId: z.coerce
    .number()
    .int()
    .positive({ message: "Selecciona un tipo de plan válido" }),
  descripcion: z.string().optional(),
  valorMensual: z.coerce.number().positive("Debe ser mayor a 0"),
  fechaVigenciaInicio: z.string().min(1, "Requerido"),
  fechaVigenciaFin: z.string().optional().or(z.literal("")),
  activo: z.boolean(),
});
type PlanForm = z.infer<typeof planSchema>;

export interface PlanPago {
  id: number;
  nombre: string;
  tipoPlanId: number;
  tipoPlanNombre?: string;
  categoria: string;
  descripcion?: string;
  valorMensual: number;
  fechaVigenciaInicio: string;
  fechaVigenciaFin?: string;
  activo: boolean;
}

export function PlanPagoModal({
  categoria,
  plan,
  onGuardado,
}: {
  // "inscripcion" | "mensualidad" — determina qué tipos de plan se listan
  // en el selector y qué categoría lleva el plan por defecto al crear.
  categoria: "inscripcion" | "mensualidad";
  // Si viene un plan, el modal edita; si no, crea uno nuevo.
  plan?: PlanPago;
  onGuardado: () => void;
}) {
  const [open, setOpen] = useState(false);
  const [tiposPlan, setTiposPlan] = useState<{ id: number; nombre: string }[]>([]);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<PlanForm>({
    resolver: zodResolver(planSchema),
    defaultValues: {
      nombre: plan?.nombre ?? "",
      tipoPlanId: plan?.tipoPlanId ?? 0,
      descripcion: plan?.descripcion ?? "",
      valorMensual: plan?.valorMensual ?? 0,
      fechaVigenciaInicio: plan?.fechaVigenciaInicio ?? "",
      fechaVigenciaFin: plan?.fechaVigenciaFin ?? "",
      activo: plan?.activo ?? true,
    },
  });

  useEffect(() => {
    if (!open) return;
    api
      .get(`/api/planes-pago/tipos`, { params: { categoria } })
      .then((res) => setTiposPlan(res.data))
      .catch((err) => console.error("Error al cargar tipos de plan:", err));
  }, [open, categoria]);

  const onSubmit = async (data: PlanForm) => {
    const body = {
      ...data,
      fechaVigenciaFin: data.fechaVigenciaFin || null,
    };

    try {
      if (plan) {
        await api.put(`/api/planes-pago/${plan.id}`, body);
        toast.success("Plan actualizado correctamente");
      } else {
        await api.post(`/api/planes-pago`, body);
        toast.success("Plan creado correctamente");
      }
      onGuardado();
      reset();
      setOpen(false);
    } catch (error: any) {
      console.error("Error al guardar plan:", error);
      toast.error(error.response?.data ?? "Error al guardar el plan");
    }
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        {plan ? (
          <Button variant="outline" size="sm">
            <Pencil className="h-4 w-4 mr-1" /> Editar
          </Button>
        ) : (
          <Button>
            <Plus className="mr-2 h-4 w-4" /> Nuevo Plan
          </Button>
        )}
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>
            {plan ? "Editar plan" : "Registrar plan"} de{" "}
            {categoria === "inscripcion" ? "inscripción" : "mensualidad"}
          </DialogTitle>
          <DialogDescription>Completa los datos del plan</DialogDescription>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
          <div>
            <Label>Nombre</Label>
            <Input {...register("nombre")} />
            {errors.nombre && (
              <span className="text-sm text-red-500">{errors.nombre.message}</span>
            )}
          </div>

          <div>
            <Label>Tipo de plan</Label>
            <select
              className="w-full border rounded-md p-2"
              {...register("tipoPlanId")}
              defaultValue={plan?.tipoPlanId ?? ""}
            >
              <option key="default" value="" disabled>
                Selecciona un tipo
              </option>
              {tiposPlan.map((tipo) => (
                <option key={tipo.id} value={tipo.id}>
                  {tipo.nombre}
                </option>
              ))}
            </select>
            {errors.tipoPlanId && (
              <span className="text-sm text-red-500">
                {errors.tipoPlanId.message}
              </span>
            )}
          </div>

          <div>
            <Label>Descripción</Label>
            <Textarea {...register("descripcion")} />
          </div>

          <div>
            <Label>
              {categoria === "inscripcion" ? "Valor" : "Valor mensual"}
            </Label>
            <Input type="number" step="0.01" {...register("valorMensual")} />
            {errors.valorMensual && (
              <span className="text-sm text-red-500">
                {errors.valorMensual.message}
              </span>
            )}
          </div>

          <div className="flex space-x-2">
            <div className="flex-1">
              <Label>Inicio de vigencia</Label>
              <Input type="date" {...register("fechaVigenciaInicio")} />
              {errors.fechaVigenciaInicio && (
                <span className="text-sm text-red-500">
                  {errors.fechaVigenciaInicio.message}
                </span>
              )}
            </div>
            <div className="flex-1">
              <Label>Fin de vigencia (opcional)</Label>
              <Input type="date" {...register("fechaVigenciaFin")} />
            </div>
          </div>

          <div className="flex items-center gap-2">
            <input type="checkbox" id="activo" {...register("activo")} />
            <Label htmlFor="activo">Activo</Label>
          </div>

          <div className="flex justify-end space-x-2">
            <Button type="button" variant="outline" onClick={() => setOpen(false)}>
              Cancelar
            </Button>
            <Button type="submit">
              {plan ? "Guardar cambios" : "Crear plan"}
            </Button>
          </div>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Forms/RegistrarPagoModal.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2, CreditCard } from "lucide-react";
import { toast } from "react-toastify";
import {
  EstadoPago,
  FacturaConSaldo,
  MetodoPago,
  TipoPago,
  formatCOP,
  mensajeError,
  obtenerMetodosPago,
  obtenerTiposPago,
  registrarPago,
} from "@/app/lib/facturas-pagos";

export default function RegistrarPagoModal({
  open,
  onOpenChange,
  facturas,
  facturaPreseleccionada,
  onPagoRegistrado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  facturas: FacturaConSaldo[]; // solo facturas con saldo pendiente > 0
  facturaPreseleccionada?: FacturaConSaldo | null;
  onPagoRegistrado: () => void;
}) {
  const [cargandoCatalogos, setCargandoCatalogos] = useState(false);
  const [guardando, setGuardando] = useState(false);

  const [tiposPago, setTiposPago] = useState<TipoPago[]>([]);
  const [metodosPago, setMetodosPago] = useState<MetodoPago[]>([]);

  const [facturaId, setFacturaId] = useState<string>("");
  const [tipoPagoId, setTipoPagoId] = useState<string>("");
  const [metodoPagoId, setMetodoPagoId] = useState<string>("");
  const [fecha, setFecha] = useState(() =>
    new Date().toISOString().slice(0, 10),
  );
  const [monto, setMonto] = useState<string>("");
  const [estado, setEstado] = useState<EstadoPago>("Pagado");

  const facturaSeleccionada = useMemo(
    () => facturas.find((f) => String(f.id) === facturaId) ?? null,
    [facturas, facturaId],
  );

  useEffect(() => {
    if (!open) return;

    setCargandoCatalogos(true);
    setTipoPagoId("");
    setMetodoPagoId("");
    setFecha(new Date().toISOString().slice(0, 10));
    setEstado("Pagado");

    if (facturaPreseleccionada) {
      setFacturaId(String(facturaPreseleccionada.id));
      setMonto(String(facturaPreseleccionada.saldoPendiente));
    } else {
      setFacturaId("");
      setMonto("");
    }

    Promise.allSettled([obtenerTiposPago(), obtenerMetodosPago()]).then(
      ([resTipos, resMetodos]) => {
        if (resTipos.status === "fulfilled") {
          setTiposPago(resTipos.value);
          if (resTipos.value.length === 0) {
            toast.error(
              "No hay tipos de pago configurados. Agrega registros a la tabla tipos_pago (ej. Inscripción, Mensualidad).",
            );
          }
        } else {
          toast.error("No se pudieron cargar los tipos de pago");
        }

        if (resMetodos.status === "fulfilled") {
          setMetodosPago(resMetodos.value);
          if (resMetodos.value.length === 0) {
            toast.error(
              "No hay métodos de pago configurados. Agrega registros a la tabla metodos_pago (ej. Efectivo, Transferencia).",
            );
          }
        } else {
          toast.error("No se pudieron cargar los métodos de pago");
        }

        setCargandoCatalogos(false);
      },
    );
  }, [open, facturaPreseleccionada]);

  const handleFacturaChange = (value: string) => {
    setFacturaId(value);
    const factura = facturas.find((f) => String(f.id) === value);
    if (factura) setMonto(String(factura.saldoPendiente));
  };

  const handleSubmit = async () => {
    if (!facturaId || !tipoPagoId || !metodoPagoId || !monto) {
      toast.error("Completa todos los campos antes de guardar");
      return;
    }

    const montoNum = Number(monto);
    if (!montoNum || montoNum <= 0) {
      toast.error("El monto debe ser mayor a cero");
      return;
    }

    setGuardando(true);
    try {
      await registrarPago({
        facturaId: Number(facturaId),
        tipoPagoId: Number(tipoPagoId),
        metodoPagoId: Number(metodoPagoId),
        fecha,
        estado,
        monto: montoNum,
      });
      toast.success("Pago registrado correctamente");
      onPagoRegistrado();
      onOpenChange(false);
    } catch (error) {
      toast.error(mensajeError(error, "No se pudo registrar el pago"));
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-md">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <CreditCard className="size-5" />
            Registrar pago
          </DialogTitle>
        </DialogHeader>

        <div className="grid gap-4">
          <div className="grid gap-1.5">
            <Label>Factura</Label>
            <Select
              value={facturaId}
              onValueChange={handleFacturaChange}
              disabled={!!facturaPreseleccionada}
            >
              <SelectTrigger>
                <SelectValue placeholder="Selecciona una factura" />
              </SelectTrigger>
              <SelectContent>
                {facturas.length === 0 ? (
                  <p className="px-2 py-1.5 text-sm text-muted-foreground">
                    No hay facturas con saldo pendiente
                  </p>
                ) : (
                  facturas.map((f) => (
                    <SelectItem key={f.id} value={String(f.id)}>
                      {f.numeroFactura} — {f.persona.nombre}{" "}
                      {f.persona.apellidos} ({formatCOP(f.saldoPendiente)}{" "}
                      pendiente)
                    </SelectItem>
                  ))
                )}
              </SelectContent>
            </Select>
          </div>

          {facturaSeleccionada && (
            <p className="text-xs text-muted-foreground">
              Saldo pendiente de esta factura:{" "}
              {formatCOP(facturaSeleccionada.saldoPendiente)}
            </p>
          )}

          <div className="grid grid-cols-2 gap-4">
            <div className="grid gap-1.5">
              <Label>Tipo de pago</Label>
              <Select value={tipoPagoId} onValueChange={setTipoPagoId}>
                <SelectTrigger>
                  <SelectValue
                    placeholder={cargandoCatalogos ? "Cargando…" : "Selecciona"}
                  />
                </SelectTrigger>
                <SelectContent>
                  {tiposPago.map((t) => (
                    <SelectItem key={t.id} value={String(t.id)}>
                      {t.tipo}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            <div className="grid gap-1.5">
              <Label>Método de pago</Label>
              <Select value={metodoPagoId} onValueChange={setMetodoPagoId}>
                <SelectTrigger>
                  <SelectValue
                    placeholder={cargandoCatalogos ? "Cargando…" : "Selecciona"}
                  />
                </SelectTrigger>
                <SelectContent>
                  {metodosPago.map((m) => (
                    <SelectItem key={m.id} value={String(m.id)}>
                      {m.metodo}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div className="grid gap-1.5">
              <Label>Fecha</Label>
              <Input
                type="date"
                value={fecha}
                onChange={(e) => setFecha(e.target.value)}
              />
            </div>
            <div className="grid gap-1.5">
              <Label>Monto</Label>
              <Input
                type="number"
                min={0}
                value={monto}
                onChange={(e) => setMonto(e.target.value)}
              />
            </div>
          </div>

          <div className="grid gap-1.5">
            <Label>Estado</Label>
            <Select
              value={estado}
              onValueChange={(v) => setEstado(v as EstadoPago)}
            >
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="Pagado">Pagado</SelectItem>
                <SelectItem value="Pendiente">Pendiente</SelectItem>
                <SelectItem value="Vencido">Vencido</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Cancelar
          </Button>
          <Button onClick={handleSubmit} disabled={guardando}>
            {guardando ? (
              <>
                <Loader2 className="mr-2 size-4 animate-spin" />
                Guardando…
              </>
            ) : (
              "Guardar pago"
            )}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Forms/TipoPlanPagoModal.tsx">
"use client";

import { useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { Pencil, Plus } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

const tipoSchema = z.object({
  nombre: z.string().min(1, "Requerido"),
  categoria: z.enum(["inscripcion", "mensualidad"], {
    errorMap: () => ({ message: "Selecciona una categoría" }),
  }),
  duracionMeses: z.coerce.number().int().positive("Debe ser mayor a 0"),
  descripcion: z.string().optional(),
});
type TipoForm = z.infer<typeof tipoSchema>;

export interface TipoPlanPago {
  id: number;
  nombre: string;
  categoria: "inscripcion" | "mensualidad";
  duracionMeses: number;
  descripcion?: string;
  planesAsociados: number;
}

export function TipoPlanPagoModal({
  tipo,
  onGuardado,
}: {
  // Si viene un tipo, el modal edita; si no, crea uno nuevo.
  tipo?: TipoPlanPago;
  onGuardado: () => void;
}) {
  const [open, setOpen] = useState(false);

  const {
    register,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<TipoForm>({
    resolver: zodResolver(tipoSchema),
    defaultValues: {
      nombre: tipo?.nombre ?? "",
      categoria: tipo?.categoria ?? "mensualidad",
      duracionMeses: tipo?.duracionMeses ?? 1,
      descripcion: tipo?.descripcion ?? "",
    },
  });

  const onSubmit = async (data: TipoForm) => {
    try {
      if (tipo) {
        await api.put(`/api/tipos-planes-pago/${tipo.id}`, data);
        toast.success("Tipo de plan actualizado correctamente");
      } else {
        await api.post(`/api/tipos-planes-pago`, data);
        toast.success("Tipo de plan creado correctamente");
      }
      onGuardado();
      reset();
      setOpen(false);
    } catch (error: any) {
      console.error("Error al guardar tipo de plan:", error);
      toast.error(error.response?.data ?? "Error al guardar el tipo de plan");
    }
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        {tipo ? (
          <Button variant="outline" size="sm">
            <Pencil className="h-4 w-4 mr-1" /> Editar
          </Button>
        ) : (
          <Button>
            <Plus className="mr-2 h-4 w-4" /> Nuevo Tipo
          </Button>
        )}
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>{tipo ? "Editar" : "Crear"} tipo de plan</DialogTitle>
        </DialogHeader>

        <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
          <div>
            <Label>Nombre</Label>
            <Input {...register("nombre")} />
            {errors.nombre && (
              <span className="text-sm text-red-500">{errors.nombre.message}</span>
            )}
          </div>

          <div>
            <Label>Categoría</Label>
            <select
              className="w-full border rounded-md p-2"
              {...register("categoria")}
              defaultValue={tipo?.categoria ?? "mensualidad"}
            >
              <option value="inscripcion">Inscripción (pago único)</option>
              <option value="mensualidad">Mensualidad (recurrente)</option>
            </select>
            {errors.categoria && (
              <span className="text-sm text-red-500">{errors.categoria.message}</span>
            )}
          </div>

          <div>
            <Label>Duración (meses)</Label>
            <Input type="number" min={1} {...register("duracionMeses")} />
            {errors.duracionMeses && (
              <span className="text-sm text-red-500">
                {errors.duracionMeses.message}
              </span>
            )}
          </div>

          <div>
            <Label>Descripción</Label>
            <Textarea {...register("descripcion")} />
          </div>

          <div className="flex justify-end space-x-2">
            <Button type="button" variant="outline" onClick={() => setOpen(false)}>
              Cancelar
            </Button>
            <Button type="submit">{tipo ? "Guardar cambios" : "Crear tipo"}</Button>
          </div>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Horarios/CalendarioSemanal.tsx">
"use client";

import { useMemo } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

interface GrupoAsociado {
  horarioEntrenamientoId: number;
  grupoId: number;
  nombreGrupo: string;
}

interface HorarioResponseDTO {
  id: number;
  diaId: number;
  dia: string;
  horaInicio: string; // "HH:mm:ss"
  horaFin: string;
  grupos: GrupoAsociado[];
}

const DIAS_SEMANA = [
  { key: "lunes", label: "Lunes", corto: "Lun" },
  { key: "martes", label: "Martes", corto: "Mar" },
  { key: "miercoles", label: "Miércoles", corto: "Mié" },
  { key: "jueves", label: "Jueves", corto: "Jue" },
  { key: "viernes", label: "Viernes", corto: "Vie" },
  { key: "sabado", label: "Sábado", corto: "Sáb" },
  { key: "domingo", label: "Domingo", corto: "Dom" },
];

// Paleta cíclica para distinguir grupos a simple vista dentro del calendario.
const PALETA = [
  "bg-blue-100 text-blue-800 border-blue-300",
  "bg-emerald-100 text-emerald-800 border-emerald-300",
  "bg-purple-100 text-purple-800 border-purple-300",
  "bg-amber-100 text-amber-800 border-amber-300",
  "bg-pink-100 text-pink-800 border-pink-300",
  "bg-cyan-100 text-cyan-800 border-cyan-300",
  "bg-rose-100 text-rose-800 border-rose-300",
  "bg-indigo-100 text-indigo-800 border-indigo-300",
  "bg-lime-100 text-lime-800 border-lime-300",
  "bg-orange-100 text-orange-800 border-orange-300",
];

const HOUR_HEIGHT = 56; // px por hora

const normalizarDia = (dia: string) =>
  dia
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

const toMinutos = (hhmmss: string) => {
  const [h, m] = hhmmss.split(":").map(Number);
  return h * 60 + (m || 0);
};

const formatHora = (hora: string) => hora?.slice(0, 5) ?? "";

interface EventoLayout {
  horario: HorarioResponseDTO;
  startMin: number;
  endMin: number;
  col: number;
  totalCols: number;
}

// Algoritmo simple de layout tipo Google Calendar: agrupa eventos que se
// solapan en el tiempo y les reparte columnas para que no se encimen.
function layoutDia(horarios: HorarioResponseDTO[]): EventoLayout[] {
  const eventos = horarios
    .map((h) => ({
      horario: h,
      startMin: toMinutos(h.horaInicio),
      endMin: toMinutos(h.horaFin),
    }))
    .sort((a, b) => a.startMin - b.startMin || a.endMin - b.endMin);

  const columnas: (typeof eventos)[] = [];
  const asignadas = eventos.map((ev) => {
    let colIndex = columnas.findIndex(
      (col) => col[col.length - 1].endMin <= ev.startMin,
    );
    if (colIndex === -1) {
      colIndex = columnas.length;
      columnas.push([]);
    }
    columnas[colIndex].push(ev);
    return { ...ev, col: colIndex };
  });

  const totalCols = Math.max(columnas.length, 1);
  return asignadas.map((ev) => ({ ...ev, totalCols }));
}

export default function CalendarioSemanal({
  horarios,
}: {
  horarios: HorarioResponseDTO[];
}) {
  const { startHour, endHour } = useMemo(() => {
    if (horarios.length === 0) return { startHour: 7, endHour: 21 };
    const minStart = Math.min(...horarios.map((h) => toMinutos(h.horaInicio)));
    const maxEnd = Math.max(...horarios.map((h) => toMinutos(h.horaFin)));
    let sH = Math.floor(minStart / 60);
    let eH = Math.ceil(maxEnd / 60);
    if (eH - sH < 6) eH = sH + 6; // rango mínimo para que no se vea vacío
    return { startHour: sH, endHour: eH };
  }, [horarios]);

  const horas = useMemo(
    () => Array.from({ length: endHour - startHour + 1 }, (_, i) => startHour + i),
    [startHour, endHour],
  );

  const eventosPorDia = useMemo(() => {
    const map = new Map<string, HorarioResponseDTO[]>();
    DIAS_SEMANA.forEach((d) => map.set(d.key, []));
    horarios.forEach((h) => {
      const key = normalizarDia(h.dia);
      if (map.has(key)) {
        map.get(key)!.push(h);
      }
    });
    return map;
  }, [horarios]);

  // Asigna un color estable a cada grupo según el orden en que aparece,
  // así el mismo grupo se ve igual en todos los días de la semana.
  const colorPorGrupoId = useMemo(() => {
    const map = new Map<number, string>();
    let idx = 0;
    horarios.forEach((h) =>
      h.grupos.forEach((g) => {
        if (!map.has(g.grupoId)) {
          map.set(g.grupoId, PALETA[idx % PALETA.length]);
          idx++;
        }
      }),
    );
    return map;
  }, [horarios]);

  const totalAltura = (endHour - startHour) * HOUR_HEIGHT;

  if (horarios.length === 0) {
    return (
      <Card>
        <CardContent className="py-10 text-center text-muted-foreground">
          No hay horarios registrados todavía. Crea un horario para verlo en
          el calendario.
        </CardContent>
      </Card>
    );
  }

  return (
    <Card>
      <CardContent className="pt-6">
        <div className="overflow-x-auto">
          <div
            className="grid"
            style={{
              gridTemplateColumns: `56px repeat(${DIAS_SEMANA.length}, minmax(130px, 1fr))`,
              minWidth: `${56 + DIAS_SEMANA.length * 130}px`,
            }}
          >
            {/* Encabezado de días */}
            <div />
            {DIAS_SEMANA.map((d) => (
              <div
                key={d.key}
                className="text-center text-sm font-semibold py-2 border-b"
              >
                <span className="hidden sm:inline">{d.label}</span>
                <span className="sm:hidden">{d.corto}</span>
              </div>
            ))}

            {/* Columna de horas */}
            <div className="relative" style={{ height: totalAltura }}>
              {horas.slice(0, -1).map((h) => (
                <div
                  key={h}
                  className="absolute right-2 -translate-y-1/2 text-xs text-muted-foreground"
                  style={{ top: (h - startHour) * HOUR_HEIGHT }}
                >
                  {String(h).padStart(2, "0")}:00
                </div>
              ))}
            </div>

            {/* Columnas de días con eventos */}
            {DIAS_SEMANA.map((d) => {
              const eventosDia = layoutDia(eventosPorDia.get(d.key) ?? []);
              return (
                <div
                  key={d.key}
                  className="relative border-l"
                  style={{ height: totalAltura }}
                >
                  {/* Líneas guía por hora */}
                  {horas.map((h) => (
                    <div
                      key={h}
                      className="absolute left-0 right-0 border-t border-dashed border-muted"
                      style={{ top: (h - startHour) * HOUR_HEIGHT }}
                    />
                  ))}

                  {/* Bloques de horario */}
                  {eventosDia.map((ev) => {
                    const top = ((ev.startMin - startHour * 60) / 60) * HOUR_HEIGHT;
                    const height = Math.max(
                      ((ev.endMin - ev.startMin) / 60) * HOUR_HEIGHT - 2,
                      22,
                    );
                    const widthPct = 100 / ev.totalCols;
                    const leftPct = widthPct * ev.col;
                    const nombresGrupos = ev.horario.grupos.map(
                      (g) => g.nombreGrupo,
                    );
                    const color =
                      ev.horario.grupos.length > 0
                        ? colorPorGrupoId.get(ev.horario.grupos[0].grupoId)
                        : "bg-muted text-muted-foreground border-dashed";

                    return (
                      <div
                        key={ev.horario.id}
                        title={`${nombresGrupos.join(", ") || "Sin grupo asignado"} · ${formatHora(ev.horario.horaInicio)}-${formatHora(ev.horario.horaFin)}`}
                        className={`absolute rounded-md border px-1.5 py-1 text-[11px] leading-tight overflow-hidden ${color}`}
                        style={{
                          top,
                          height,
                          left: `${leftPct}%`,
                          width: `calc(${widthPct}% - 4px)`,
                        }}
                      >
                        <div className="font-semibold">
                          {formatHora(ev.horario.horaInicio)}-
                          {formatHora(ev.horario.horaFin)}
                        </div>
                        <div className="truncate">
                          {nombresGrupos.length > 0
                            ? nombresGrupos.join(", ")
                            : "Sin grupo"}
                        </div>
                      </div>
                    );
                  })}
                </div>
              );
            })}
          </div>
        </div>

        {/* Leyenda de grupos */}
        {colorPorGrupoId.size > 0 && (
          <div className="flex flex-wrap gap-2 mt-4 pt-4 border-t">
            {Array.from(colorPorGrupoId.entries()).map(([grupoId, color]) => {
              const nombre = horarios
                .flatMap((h) => h.grupos)
                .find((g) => g.grupoId === grupoId)?.nombreGrupo;
              return (
                <Badge key={grupoId} variant="outline" className={color}>
                  {nombre}
                </Badge>
              );
            })}
          </div>
        )}
      </CardContent>
    </Card>
  );
}
</file>

<file path="app/components/inventario/CategoriasProductoPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Plus, Pencil, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

export interface CategoriaProducto {
  id: number;
  nombre: string;
  codigo: string;
  descripcion: string;
}

const FORM_VACIO = { nombre: "", codigo: "", descripcion: "" };

export default function CategoriasProductoPanel() {
  const [cargando, setCargando] = useState(true);
  const [categorias, setCategorias] = useState<CategoriaProducto[]>([]);
  const [modalAbierto, setModalAbierto] = useState(false);
  const [enEdicion, setEnEdicion] = useState<CategoriaProducto | null>(null);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  const cargar = () => {
    setCargando(true);
    api
      .get("/api/categorias-producto")
      .then((res) => setCategorias(res.data))
      .catch(() => toast.error("No se pudieron cargar las categorías"))
      .finally(() => setCargando(false));
  };

  useEffect(() => {
    cargar();
  }, []);

  const abrirNueva = () => {
    setEnEdicion(null);
    setForm(FORM_VACIO);
    setModalAbierto(true);
  };

  const abrirEdicion = (c: CategoriaProducto) => {
    setEnEdicion(c);
    setForm({ nombre: c.nombre, codigo: c.codigo, descripcion: c.descripcion ?? "" });
    setModalAbierto(true);
  };

  const guardar = async () => {
    if (!form.nombre.trim() || !form.codigo.trim()) {
      toast.error("Nombre y código son obligatorios");
      return;
    }
    setGuardando(true);
    try {
      if (enEdicion) {
        await api.put(`/api/categorias-producto/${enEdicion.id}`, form);
        toast.success("Categoría actualizada");
      } else {
        await api.post("/api/categorias-producto", form);
        toast.success("Categoría creada");
      }
      setModalAbierto(false);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar la categoría",
      );
    } finally {
      setGuardando(false);
    }
  };

  const eliminar = async (id: number) => {
    if (!confirm("¿Eliminar esta categoría?")) return;
    try {
      await api.delete(`/api/categorias-producto/${id}`);
      toast.success("Categoría eliminada");
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo eliminar (puede tener productos asociados)",
      );
    }
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-10 text-muted-foreground">
        <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex justify-end">
        <Button size="sm" onClick={abrirNueva}>
          <Plus className="h-4 w-4 mr-1" /> Nueva Categoría
        </Button>
      </div>
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>Código</TableHead>
            <TableHead>Nombre</TableHead>
            <TableHead>Descripción</TableHead>
            <TableHead>Acciones</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {categorias.length === 0 ? (
            <TableRow>
              <TableCell colSpan={4} className="text-center py-8 text-muted-foreground">
                No hay categorías para mostrar.
              </TableCell>
            </TableRow>
          ) : (
            categorias.map((c) => (
              <TableRow key={c.id}>
                <TableCell className="font-mono">{c.codigo}</TableCell>
                <TableCell className="font-medium">{c.nombre}</TableCell>
                <TableCell>{c.descripcion}</TableCell>
                <TableCell>
                  <div className="flex space-x-2">
                    <Button variant="outline" size="sm" onClick={() => abrirEdicion(c)}>
                      <Pencil className="h-4 w-4 mr-1" /> Editar
                    </Button>
                    <Button variant="destructive" size="sm" onClick={() => eliminar(c.id)}>
                      <Trash2 className="h-4 w-4 mr-1" /> Eliminar
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            ))
          )}
        </TableBody>
      </Table>

      <Dialog open={modalAbierto} onOpenChange={setModalAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>{enEdicion ? "Editar categoría" : "Nueva categoría"}</DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid gap-1.5">
              <Label>Nombre</Label>
              <Input
                value={form.nombre}
                onChange={(e) => setForm({ ...form, nombre: e.target.value })}
                placeholder="Ej. Ropa"
              />
            </div>
            <div className="grid gap-1.5">
              <Label>Código (3 letras)</Label>
              <Input
                value={form.codigo}
                maxLength={3}
                onChange={(e) => setForm({ ...form, codigo: e.target.value.toUpperCase() })}
                placeholder="Ej. ROP"
              />
              <p className="text-xs text-muted-foreground">
                Se usa para armar el SKU de los productos de esta categoría.
              </p>
            </div>
            <div className="grid gap-1.5">
              <Label>Descripción</Label>
              <Textarea
                value={form.descripcion}
                onChange={(e) => setForm({ ...form, descripcion: e.target.value })}
              />
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setModalAbierto(false)} disabled={guardando}>
              Cancelar
            </Button>
            <Button onClick={guardar} disabled={guardando}>
              {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="app/components/inventario/ProductoFormModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Switch } from "@/components/ui/switch";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import { CategoriaProducto } from "./CategoriasProductoPanel";

export interface Producto {
  id: number;
  sku: string;
  nombre: string;
  descripcion: string;
  categoriaProductoId: number;
  categoriaNombre: string;
  precioMinReferencia: number;
  precioMaxReferencia: number;
  origen: string;
  notasProveedor: string;
  requiereControlStock: boolean;
  activo: boolean;
  stockTotal: number | null;
}

const FORM_VACIO = {
  codigo: "",
  nombre: "",
  descripcion: "",
  categoriaProductoId: "",
  precioMinReferencia: "",
  precioMaxReferencia: "",
  origen: "",
  notasProveedor: "",
  requiereControlStock: true,
};

export default function ProductoFormModal({
  open,
  onOpenChange,
  producto,
  onGuardado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  producto: Producto | null;
  onGuardado: () => void;
}) {
  const [categorias, setCategorias] = useState<CategoriaProducto[]>([]);
  const [form, setForm] = useState(FORM_VACIO);
  const [guardando, setGuardando] = useState(false);

  useEffect(() => {
    if (!open) return;
    api
      .get("/api/categorias-producto")
      .then((res) => setCategorias(res.data))
      .catch(() => toast.error("No se pudieron cargar las categorías"));

    if (producto) {
      setForm({
        codigo: "",
        nombre: producto.nombre,
        descripcion: producto.descripcion ?? "",
        categoriaProductoId: String(producto.categoriaProductoId),
        precioMinReferencia: String(producto.precioMinReferencia ?? ""),
        precioMaxReferencia: String(producto.precioMaxReferencia ?? ""),
        origen: producto.origen ?? "",
        notasProveedor: producto.notasProveedor ?? "",
        requiereControlStock: producto.requiereControlStock,
      });
    } else {
      setForm(FORM_VACIO);
    }
  }, [open, producto]);

  const guardar = async () => {
    if (!form.nombre.trim() || !form.categoriaProductoId) {
      toast.error("Nombre y categoría son obligatorios");
      return;
    }
    if (!producto && !form.codigo.trim()) {
      toast.error("El código del artículo es obligatorio (se usa para armar el SKU)");
      return;
    }
    setGuardando(true);
    try {
      const payload = {
        codigo: form.codigo || undefined,
        nombre: form.nombre,
        descripcion: form.descripcion,
        categoriaProductoId: Number(form.categoriaProductoId),
        precioMinReferencia: form.precioMinReferencia ? Number(form.precioMinReferencia) : null,
        precioMaxReferencia: form.precioMaxReferencia ? Number(form.precioMaxReferencia) : null,
        origen: form.origen,
        notasProveedor: form.notasProveedor,
        requiereControlStock: form.requiereControlStock,
      };
      if (producto) {
        await api.put(`/api/productos/${producto.id}`, payload);
        toast.success("Producto actualizado");
      } else {
        await api.post("/api/productos", payload);
        toast.success("Producto creado");
      }
      onOpenChange(false);
      onGuardado();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo guardar el producto",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-lg max-h-[85vh] flex flex-col p-0">
        <DialogHeader className="px-6 pt-6 pb-2">
          <DialogTitle>{producto ? "Editar producto" : "Nuevo producto"}</DialogTitle>
        </DialogHeader>
        <div className="space-y-4 px-6 py-4 overflow-y-auto flex-1">
          <div className="grid gap-1.5">
            <Label>Nombre</Label>
            <Input
              value={form.nombre}
              onChange={(e) => setForm({ ...form, nombre: e.target.value })}
              placeholder="Ej. Camiseta de entrenamiento"
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Categoría</Label>
            <Select
              value={form.categoriaProductoId}
              onValueChange={(v) => setForm({ ...form, categoriaProductoId: v })}
            >
              <SelectTrigger>
                <SelectValue placeholder="Selecciona una categoría" />
              </SelectTrigger>
              <SelectContent>
                {categorias.map((c) => (
                  <SelectItem key={c.id} value={String(c.id)}>
                    {c.nombre}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          {!producto && (
            <div className="grid gap-1.5">
              <Label>Código del artículo (3 letras)</Label>
              <Input
                value={form.codigo}
                maxLength={3}
                onChange={(e) => setForm({ ...form, codigo: e.target.value.toUpperCase() })}
                placeholder="Ej. CAE"
              />
              <p className="text-xs text-muted-foreground">
                El SKU completo se arma solo (RAT + categoría + este código).
              </p>
            </div>
          )}
          <div className="grid gap-1.5">
            <Label>Descripción</Label>
            <Textarea
              value={form.descripcion}
              onChange={(e) => setForm({ ...form, descripcion: e.target.value })}
            />
          </div>
          <div className="flex gap-4">
            <div className="flex-1 grid gap-1.5">
              <Label>Precio mín. referencia</Label>
              <Input
                type="number"
                value={form.precioMinReferencia}
                onChange={(e) => setForm({ ...form, precioMinReferencia: e.target.value })}
              />
            </div>
            <div className="flex-1 grid gap-1.5">
              <Label>Precio máx. referencia</Label>
              <Input
                type="number"
                value={form.precioMaxReferencia}
                onChange={(e) => setForm({ ...form, precioMaxReferencia: e.target.value })}
              />
            </div>
          </div>
          <div className="grid gap-1.5">
            <Label>Origen / Proveedor</Label>
            <Input
              value={form.origen}
              onChange={(e) => setForm({ ...form, origen: e.target.value })}
            />
          </div>
          <div className="grid gap-1.5">
            <Label>Notas del proveedor</Label>
            <Textarea
              value={form.notasProveedor}
              onChange={(e) => setForm({ ...form, notasProveedor: e.target.value })}
            />
          </div>
          <div className="flex items-center gap-2">
            <Switch
              id="requiere-stock"
              checked={form.requiereControlStock}
              onCheckedChange={(v) => setForm({ ...form, requiereControlStock: v })}
            />
            <Label htmlFor="requiere-stock">Controlar stock de este producto</Label>
          </div>
        </div>
        <DialogFooter className="gap-3 px-6 pb-6 pt-3 border-t">
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={guardando}>
            Cancelar
          </Button>
          <Button onClick={guardar} disabled={guardando}>
            {guardando ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
            Guardar
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/inventario/ProductoVariantesPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Plus, ArrowLeftRight, Trash2, Loader2 } from "lucide-react";
import { toast } from "react-toastify";
import { api } from "@/lib/api";

interface Variante {
  id: number;
  productoId: number;
  nombreProducto: string;
  talla: string;
  color: string;
  skuVariante: string;
  precioVenta: number;
  stockActual: number | null;
  activo: boolean;
}

interface Movimiento {
  id: number;
  productoVarianteId: number;
  skuVariante: string;
  tipo: string;
  cantidad: number;
  motivo: string;
  fecha: string;
  usuario: string;
}

const FORM_VARIANTE_VACIO = { talla: "", color: "", precioVenta: "", stockInicial: "" };
const FORM_MOVIMIENTO_VACIO = { tipo: "entrada", cantidad: "", motivo: "" };

export default function ProductoVariantesPanel({
  productoId,
  requiereControlStock,
}: {
  productoId: number;
  requiereControlStock: boolean;
}) {
  const [cargando, setCargando] = useState(true);
  const [variantes, setVariantes] = useState<Variante[]>([]);

  const [modalVarianteAbierto, setModalVarianteAbierto] = useState(false);
  const [formVariante, setFormVariante] = useState(FORM_VARIANTE_VACIO);
  const [guardandoVariante, setGuardandoVariante] = useState(false);

  const [varianteMovimientos, setVarianteMovimientos] = useState<Variante | null>(null);
  const [movimientos, setMovimientos] = useState<Movimiento[]>([]);
  const [cargandoMovimientos, setCargandoMovimientos] = useState(false);
  const [formMovimiento, setFormMovimiento] = useState(FORM_MOVIMIENTO_VACIO);
  const [registrandoMovimiento, setRegistrandoMovimiento] = useState(false);

  const cargar = () => {
    setCargando(true);
    api
      .get(`/api/producto-variantes/producto/${productoId}`)
      .then((res) => setVariantes(res.data))
      .catch(() => toast.error("No se pudieron cargar las variantes"))
      .finally(() => setCargando(false));
  };

  useEffect(() => {
    cargar();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [productoId]);

  const guardarVariante = async () => {
    if (!formVariante.precioVenta) {
      toast.error("El precio de venta es obligatorio");
      return;
    }
    setGuardandoVariante(true);
    try {
      await api.post("/api/producto-variantes", {
        productoId,
        talla: formVariante.talla || null,
        color: formVariante.color || null,
        precioVenta: Number(formVariante.precioVenta),
        stockInicial: formVariante.stockInicial ? Number(formVariante.stockInicial) : 0,
      });
      toast.success("Variante creada");
      setModalVarianteAbierto(false);
      setFormVariante(FORM_VARIANTE_VACIO);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo crear la variante",
      );
    } finally {
      setGuardandoVariante(false);
    }
  };

  const desactivar = async (id: number) => {
    if (!confirm("¿Desactivar esta variante? Dejará de estar disponible para venta.")) return;
    try {
      await api.delete(`/api/producto-variantes/${id}`);
      toast.success("Variante desactivada");
      cargar();
    } catch {
      toast.error("No se pudo desactivar la variante");
    }
  };

  const abrirMovimientos = (variante: Variante) => {
    setVarianteMovimientos(variante);
    setFormMovimiento(FORM_MOVIMIENTO_VACIO);
    setCargandoMovimientos(true);
    api
      .get(`/api/movimientos-inventario/variante/${variante.id}`)
      .then((res) => setMovimientos(res.data))
      .catch(() => toast.error("No se pudieron cargar los movimientos"))
      .finally(() => setCargandoMovimientos(false));
  };

  const registrarMovimiento = async () => {
    if (!varianteMovimientos || !formMovimiento.cantidad) {
      toast.error("La cantidad es obligatoria");
      return;
    }
    setRegistrandoMovimiento(true);
    try {
      await api.post("/api/movimientos-inventario", {
        productoVarianteId: varianteMovimientos.id,
        tipo: formMovimiento.tipo,
        cantidad: Number(formMovimiento.cantidad),
        motivo: formMovimiento.motivo,
      });
      toast.success("Movimiento registrado");
      setFormMovimiento(FORM_MOVIMIENTO_VACIO);
      abrirMovimientos(varianteMovimientos);
      cargar();
    } catch (error: any) {
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo registrar el movimiento",
      );
    } finally {
      setRegistrandoMovimiento(false);
    }
  };

  if (cargando) {
    return (
      <div className="flex items-center justify-center py-6 text-muted-foreground">
        <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex justify-end">
        <Button size="sm" variant="outline" onClick={() => setModalVarianteAbierto(true)}>
          <Plus className="h-4 w-4 mr-1" /> Nueva Variante
        </Button>
      </div>

      {variantes.length === 0 ? (
        <p className="text-center py-4 text-muted-foreground">
          Ninguna variante creada todavía (talla/color).
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>SKU</TableHead>
              <TableHead>Talla</TableHead>
              <TableHead>Color</TableHead>
              <TableHead>Precio</TableHead>
              <TableHead>Stock</TableHead>
              <TableHead>Estado</TableHead>
              <TableHead>Acciones</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {variantes.map((v) => (
              <TableRow key={v.id}>
                <TableCell className="font-mono text-xs">{v.skuVariante}</TableCell>
                <TableCell>{v.talla ?? "—"}</TableCell>
                <TableCell>{v.color ?? "—"}</TableCell>
                <TableCell>${Number(v.precioVenta).toLocaleString()}</TableCell>
                <TableCell>
                  {requiereControlStock ? (
                    <Badge variant={(v.stockActual ?? 0) <= 5 ? "destructive" : "outline"}>
                      {v.stockActual ?? 0}
                    </Badge>
                  ) : (
                    <span className="text-muted-foreground">No aplica</span>
                  )}
                </TableCell>
                <TableCell>
                  <Badge variant={v.activo ? "default" : "secondary"}>
                    {v.activo ? "Activa" : "Inactiva"}
                  </Badge>
                </TableCell>
                <TableCell>
                  <div className="flex space-x-2">
                    {requiereControlStock && (
                      <Button variant="outline" size="sm" onClick={() => abrirMovimientos(v)}>
                        <ArrowLeftRight className="h-4 w-4 mr-1" /> Movimientos
                      </Button>
                    )}
                    {v.activo && (
                      <Button variant="destructive" size="sm" onClick={() => desactivar(v.id)}>
                        <Trash2 className="h-4 w-4 mr-1" /> Desactivar
                      </Button>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}

      {/* Nueva variante */}
      <Dialog open={modalVarianteAbierto} onOpenChange={setModalVarianteAbierto}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Nueva variante</DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <div className="flex gap-4">
              <div className="flex-1 grid gap-1.5">
                <Label>Talla</Label>
                <Input
                  value={formVariante.talla}
                  onChange={(e) => setFormVariante({ ...formVariante, talla: e.target.value })}
                  placeholder="Ej. M"
                />
              </div>
              <div className="flex-1 grid gap-1.5">
                <Label>Color</Label>
                <Input
                  value={formVariante.color}
                  onChange={(e) => setFormVariante({ ...formVariante, color: e.target.value })}
                  placeholder="Ej. Negro"
                />
              </div>
            </div>
            <div className="grid gap-1.5">
              <Label>Precio de venta</Label>
              <Input
                type="number"
                value={formVariante.precioVenta}
                onChange={(e) => setFormVariante({ ...formVariante, precioVenta: e.target.value })}
              />
            </div>
            {requiereControlStock && (
              <div className="grid gap-1.5">
                <Label>Stock inicial</Label>
                <Input
                  type="number"
                  value={formVariante.stockInicial}
                  onChange={(e) =>
                    setFormVariante({ ...formVariante, stockInicial: e.target.value })
                  }
                />
              </div>
            )}
          </div>
          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setModalVarianteAbierto(false)}
              disabled={guardandoVariante}
            >
              Cancelar
            </Button>
            <Button onClick={guardarVariante} disabled={guardandoVariante}>
              {guardandoVariante ? <Loader2 className="h-4 w-4 animate-spin mr-2" /> : null}
              Guardar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Movimientos de una variante */}
      <Dialog
        open={!!varianteMovimientos}
        onOpenChange={(open) => !open && setVarianteMovimientos(null)}
      >
        <DialogContent className="sm:max-w-lg max-h-[85vh] flex flex-col p-0">
          <DialogHeader className="px-6 pt-6 pb-2">
            <DialogTitle>
              Movimientos — {varianteMovimientos?.skuVariante}
            </DialogTitle>
          </DialogHeader>
          <div className="px-6 py-4 overflow-y-auto flex-1 space-y-4">
            <div className="flex gap-2 items-end border-b pb-4">
              <div className="grid gap-1.5">
                <Label>Tipo</Label>
                <Select
                  value={formMovimiento.tipo}
                  onValueChange={(v) => setFormMovimiento({ ...formMovimiento, tipo: v })}
                >
                  <SelectTrigger className="w-[130px]">
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="entrada">Entrada</SelectItem>
                    <SelectItem value="salida">Salida</SelectItem>
                    <SelectItem value="ajuste">Ajuste</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="grid gap-1.5 w-[100px]">
                <Label>Cantidad</Label>
                <Input
                  type="number"
                  value={formMovimiento.cantidad}
                  onChange={(e) =>
                    setFormMovimiento({ ...formMovimiento, cantidad: e.target.value })
                  }
                />
              </div>
              <div className="grid gap-1.5 flex-1">
                <Label>Motivo</Label>
                <Input
                  value={formMovimiento.motivo}
                  onChange={(e) =>
                    setFormMovimiento({ ...formMovimiento, motivo: e.target.value })
                  }
                  placeholder="Ej. Compra a proveedor"
                />
              </div>
              <Button onClick={registrarMovimiento} disabled={registrandoMovimiento}>
                {registrandoMovimiento ? (
                  <Loader2 className="h-4 w-4 animate-spin" />
                ) : (
                  "Registrar"
                )}
              </Button>
            </div>

            {cargandoMovimientos ? (
              <div className="flex items-center justify-center py-6 text-muted-foreground">
                <Loader2 className="h-4 w-4 animate-spin mr-2" /> Cargando…
              </div>
            ) : movimientos.length === 0 ? (
              <p className="text-center py-4 text-muted-foreground">
                Ningún movimiento registrado todavía.
              </p>
            ) : (
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Fecha</TableHead>
                    <TableHead>Tipo</TableHead>
                    <TableHead>Cantidad</TableHead>
                    <TableHead>Motivo</TableHead>
                    <TableHead>Usuario</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {movimientos.map((m) => (
                    <TableRow key={m.id}>
                      <TableCell>{new Date(m.fecha).toLocaleString()}</TableCell>
                      <TableCell>
                        <Badge
                          variant={
                            m.tipo === "entrada"
                              ? "default"
                              : m.tipo === "salida"
                                ? "destructive"
                                : "outline"
                          }
                        >
                          {m.tipo}
                        </Badge>
                      </TableCell>
                      <TableCell>{m.cantidad}</TableCell>
                      <TableCell>{m.motivo}</TableCell>
                      <TableCell>{m.usuario}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            )}
          </div>
          <DialogFooter className="px-6 pb-6 pt-3 border-t">
            <Button variant="outline" onClick={() => setVarianteMovimientos(null)}>
              Cerrar
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
