"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Search, DollarSign, Loader2 } from "lucide-react";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { Switch } from "@/components/ui/switch";
import { Label } from "@/components/ui/label";
import { toast } from "react-toastify";
import { api } from "@/lib/api";
import CrearDescuentoForm from "../components/Forms/CrearDescuentoForm";
import ModalEditarDescuento from "../components/Forms/ModalEditarDescuento";
import ModalEliminarDescuento from "../components/Forms/ModalEliminarDescuento";

// Nota: esta página antes también traía un tab "Convenios" con datos
// 100% de ejemplo, que ni siquiera se llegaba a mostrar (no había
// TabsList para cambiar de tab). Se quitó — los convenios ya se
// gestionan en su propia página, app/convenios/page.tsx, que sí está
// conectada al backend real.

export interface Descuento {
  id: number;
  nombre: string;
  descripcion: string;
  porcentaje: number;
  fechaInicio: string;
  fechaFin: string | null;
  activo: boolean;
}

export default function DescuentosPage() {
  const [searchTerm, setSearchTerm] = useState("");
  const [mostrarInactivos, setMostrarInactivos] = useState(false);
  const [cargando, setCargando] = useState(true);
  const [descuentos, setDescuentos] = useState<Descuento[]>([]);

  const refetchDescuentos = () => {
    setCargando(true);
    api
      .get("/api/descuentos")
      .then((res) => setDescuentos(res.data))
      .catch(() => toast.error("No se pudieron cargar los descuentos"))
      .finally(() => setCargando(false));
  };

  useEffect(() => {
    refetchDescuentos();
  }, []);

  const filteredDescuentos = descuentos.filter((descuento) => {
    const matchesSearch =
      descuento.nombre.toLowerCase().includes(searchTerm.toLowerCase()) ||
      (descuento.descripcion ?? "").toLowerCase().includes(searchTerm.toLowerCase());

    if (!mostrarInactivos) {
      return matchesSearch && descuento.activo;
    }
    return matchesSearch;
  });

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Descuentos</h1>
          <p className="text-muted-foreground">
            Gestiona los descuentos para las Inscripciones
          </p>
        </div>
      </div>

      <div className="flex justify-between items-center">
        <div className="flex items-center space-x-2 w-full max-w-sm">
          <Input
            placeholder="Buscar descuentos..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="h-9"
          />
          <Button variant="outline" size="sm">
            <Search className="h-4 w-4" />
          </Button>
        </div>
        <div className="flex space-x-4 items-center">
          <div className="flex items-center space-x-2">
            <Switch
              id="mostrar-inactivos"
              checked={mostrarInactivos}
              onCheckedChange={setMostrarInactivos}
            />
            <Label htmlFor="mostrar-inactivos">Mostrar inactivos</Label>
          </div>
          <CrearDescuentoForm onCreated={refetchDescuentos} />
        </div>
      </div>

      <Card>
        <CardContent className="p-0">
          {cargando ? (
            <div className="flex items-center justify-center py-10 text-muted-foreground">
              <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
            </div>
          ) : (
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Nombre</TableHead>
                  <TableHead>Descripción</TableHead>
                  <TableHead>Porcentaje</TableHead>
                  <TableHead>Vigencia</TableHead>
                  <TableHead>Estado</TableHead>
                  <TableHead>Acciones</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {filteredDescuentos.length === 0 ? (
                  <TableRow>
                    <TableCell colSpan={6} className="text-center py-8 text-muted-foreground">
                      No hay descuentos para mostrar.
                    </TableCell>
                  </TableRow>
                ) : (
                  filteredDescuentos.map((descuento) => (
                    <TableRow key={descuento.id}>
                      <TableCell className="font-medium">
                        {descuento.nombre}
                      </TableCell>
                      <TableCell>{descuento.descripcion}</TableCell>
                      <TableCell>{descuento.porcentaje}%</TableCell>
                      <TableCell>
                        {new Date(descuento.fechaInicio).toLocaleDateString()}
                        {descuento.fechaFin
                          ? ` - ${new Date(descuento.fechaFin).toLocaleDateString()}`
                          : " - Sin fecha de fin"}
                      </TableCell>
                      <TableCell>
                        <Badge
                          variant={descuento.activo ? "default" : "secondary"}
                        >
                          {descuento.activo ? "Activo" : "Inactivo"}
                        </Badge>
                      </TableCell>
                      <TableCell>
                        <div className="flex space-x-2">
                          <ModalEditarDescuento
                            {...({
                              descuento,
                              onUpdated: refetchDescuentos,
                            } as any)}
                          />
                          <ModalEliminarDescuento
                            {...({
                              descuentoId: descuento.id,
                              onDeleted: refetchDescuentos,
                            } as any)}
                          />
                        </div>
                      </TableCell>
                    </TableRow>
                  ))
                )}
              </TableBody>
            </Table>
          )}
        </CardContent>
      </Card>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-lg">Total de Descuentos</CardTitle>
            <CardDescription>Descuentos registrados</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold">{descuentos.length}</div>
            <p className="text-xs text-muted-foreground mt-1">
              {descuentos.filter((d) => d.activo).length} activos,{" "}
              {descuentos.filter((d) => !d.activo).length} inactivos
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-lg">Descuentos Vigentes</CardTitle>
            <CardDescription>Activos y dentro de su fecha de vigencia</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold">
              {
                descuentos.filter((d) => {
                  if (!d.activo) return false;
                  const hoy = new Date();
                  const fin = d.fechaFin ? new Date(d.fechaFin) : null;
                  return !fin || fin >= hoy;
                }).length
              }
            </div>
            <p className="text-xs text-muted-foreground mt-1">
              <DollarSign className="inline h-3 w-3" /> vigentes hoy
            </p>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
</file>

<file path="app/facturas/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  ChevronDown,
  ChevronRight,
  Plus,
  Filter,
  Search,
  FileText,
  CreditCard,
  Loader2,
} from "lucide-react";
import { Input } from "@/components/ui/input";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { Badge } from "@/components/ui/badge";
import { toast } from "react-toastify";
import React from "react";
import RegistrarPagoModal from "@/app/components/Forms/RegistrarPagoModal";
import {
  Factura,
  FacturaConSaldo,
  Pago,
  calcularFacturasConSaldo,
  formatCOP,
  obtenerFacturas,
  obtenerPagos,
} from "@/app/lib/facturas-pagos";

export default function FacturasPage() {
  const [expandedFacturas, setExpandedFacturas] = useState<number[]>([]);
  const [searchTerm, setSearchTerm] = useState("");
  const [estadoFiltro, setEstadoFiltro] = useState<string | null>(null);
  const [cargando, setCargando] = useState(true);

  const [facturas, setFacturas] = useState<Factura[]>([]);
  const [pagos, setPagos] = useState<Pago[]>([]);

  const [modalAbierto, setModalAbierto] = useState(false);
  const [facturaParaPago, setFacturaParaPago] =
    useState<FacturaConSaldo | null>(null);

  const cargarDatos = () => {
    setCargando(true);
    Promise.allSettled([obtenerFacturas(), obtenerPagos()]).then(
      ([resFacturas, resPagos]) => {
        if (resFacturas.status === "fulfilled") {
          setFacturas(resFacturas.value);
        } else {
          toast.error("No se pudieron cargar las facturas");
        }
        if (resPagos.status === "fulfilled") {
          setPagos(resPagos.value);
        }
        setCargando(false);
      },
    );
  };

  useEffect(() => {
    cargarDatos();
  }, []);

  // Facturas con su estado de cuenta real (calculado contra los pagos, ya
  // que Factura no guarda su propio estado de pago).
  const facturasConSaldo = useMemo<FacturaConSaldo[]>(
    () => calcularFacturasConSaldo(facturas, pagos),
    [facturas, pagos],
  );

  const toggleFacturaExpand = (facturaId: number) => {
    setExpandedFacturas((prev) =>
      prev.includes(facturaId)
        ? prev.filter((id) => id !== facturaId)
        : [...prev, facturaId],
    );
  };

  const abrirModalParaFactura = (factura: FacturaConSaldo) => {
    setFacturaParaPago(factura);
    setModalAbierto(true);
  };

  // Filtrar facturas por término de búsqueda y estado de cuenta
  const filteredFacturas = facturasConSaldo.filter((factura) => {
    const matchesSearch =
      factura.numeroFactura.toLowerCase().includes(searchTerm.toLowerCase()) ||
      factura.persona.nombre.toLowerCase().includes(searchTerm.toLowerCase()) ||
      factura.descripcion.toLowerCase().includes(searchTerm.toLowerCase());

    if (estadoFiltro) {
      return matchesSearch && factura.estadoCuenta === estadoFiltro;
    }
    return matchesSearch;
  });

  const facturasPendientes = facturasConSaldo.filter(
    (f) => f.saldoPendiente > 0,
  );

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">
            Facturas y Pagos
          </h1>
          <p className="text-muted-foreground">
            Gestiona las facturas y pagos de los deportistas
          </p>
        </div>
        <Button disabled title="Las facturas se generan automáticamente al crear una inscripción">
          <Plus className="mr-2 h-4 w-4" /> Nueva Factura
        </Button>
      </div>

      <div className="space-y-4">
        <div className="flex justify-between mb-4">
          <div className="flex items-center space-x-2 w-full max-w-sm">
            <Input
              placeholder="Buscar facturas…"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="h-9"
            />
            <Button variant="outline" size="sm">
              <Search className="h-4 w-4" />
            </Button>
          </div>
          <div className="flex space-x-2">
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button variant="outline" size="sm">
                  <Filter className="mr-2 h-4 w-4" />
                  {estadoFiltro || "Filtrar por Estado"}
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end">
                <DropdownMenuItem onClick={() => setEstadoFiltro(null)}>
                  Todos
                </DropdownMenuItem>
                <DropdownMenuItem onClick={() => setEstadoFiltro("Pagado")}>
                  Pagado
                </DropdownMenuItem>
                <DropdownMenuItem
                  onClick={() => setEstadoFiltro("Abono parcial")}
                >
                  Abono parcial
                </DropdownMenuItem>
                <DropdownMenuItem onClick={() => setEstadoFiltro("Sin pagos")}>
                  Sin pagos
                </DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
        </div>

        {cargando ? (
          <div className="flex items-center justify-center py-12 text-muted-foreground">
            <Loader2 className="mr-2 h-5 w-5 animate-spin" /> Cargando
            facturas…
          </div>
        ) : (
          <Card>
            <CardContent className="p-0">
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead className="w-[50px]"></TableHead>
                    <TableHead>Número</TableHead>
                    <TableHead>Fecha</TableHead>
                    <TableHead>Cliente</TableHead>
                    <TableHead>Descripción</TableHead>
                    <TableHead>Total</TableHead>
                    <TableHead>Estado</TableHead>
                    <TableHead>Acciones</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {filteredFacturas.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={8} className="text-center py-6 text-muted-foreground">
                        No se encontraron facturas
                      </TableCell>
                    </TableRow>
                  ) : (
                    filteredFacturas.map((factura) => (
                      <React.Fragment key={factura.id}>
                        <TableRow>
                          <TableCell>
                            <Button
                              variant="ghost"
                              size="sm"
                              onClick={() => toggleFacturaExpand(factura.id)}
                            >
                              {expandedFacturas.includes(factura.id) ? (
                                <ChevronDown className="h-4 w-4" />
                              ) : (
                                <ChevronRight className="h-4 w-4" />
                              )}
                            </Button>
                          </TableCell>
                          <TableCell className="font-medium">
                            {factura.numeroFactura}
                          </TableCell>
                          <TableCell>
                            {new Date(factura.fechaEmision).toLocaleDateString()}
                          </TableCell>
                          <TableCell>
                            {factura.persona.nombre} {factura.persona.apellidos}
                          </TableCell>
                          <TableCell>{factura.descripcion}</TableCell>
                          <TableCell>{formatCOP(factura.total)}</TableCell>
                          <TableCell>
                            <Badge
                              variant={
                                factura.estadoCuenta === "Pagado"
                                  ? "default"
                                  : factura.estadoCuenta === "Abono parcial"
                                  ? "outline"
                                  : "destructive"
                              }
                            >
                              {factura.estadoCuenta}
                            </Badge>
                          </TableCell>
                          <TableCell>
                            <div className="flex space-x-2">
                              {factura.saldoPendiente > 0 && (
                                <Button
                                  size="sm"
                                  onClick={() => abrirModalParaFactura(factura)}
                                >
                                  <CreditCard className="h-4 w-4 mr-1" /> Registrar
                                  Pago
                                </Button>
                              )}
                              <DropdownMenu>
                                <DropdownMenuTrigger asChild>
                                  <Button variant="outline" size="sm">
                                    <FileText className="h-4 w-4 mr-1" /> Detalle
                                  </Button>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent align="end">
                                  <DropdownMenuItem
                                    onClick={() => toggleFacturaExpand(factura.id)}
                                  >
                                    Ver desglose
                                  </DropdownMenuItem>
                                </DropdownMenuContent>
                              </DropdownMenu>
                            </div>
                          </TableCell>
                        </TableRow>
                        {expandedFacturas.includes(factura.id) && (
                          <TableRow
                            key={`${factura.id}-details`}
                            className="bg-muted/50"
                          >
                            <TableCell colSpan={8} className="p-0">
                              <div className="p-4">
                                <div className="grid grid-cols-2 gap-4">
                                  <div>
                                    <h4 className="font-semibold mb-2">
                                      Detalles de la Factura
                                    </h4>
                                    <div className="space-y-2">
                                      {factura.descuento ? (
                                        <>
                                          <div className="grid grid-cols-2">
                                            <span className="text-muted-foreground">
                                              Descuento aplicado:
                                            </span>
                                            <span>
                                              {factura.descuento.nombre} (
                                              {factura.descuento.porcentaje}%)
                                            </span>
                                          </div>
                                        </>
                                      ) : (
                                        <div className="grid grid-cols-2">
                                          <span className="text-muted-foreground">
                                            Descuento de convenio:
                                          </span>
                                          <span className="text-muted-foreground">
                                            Ninguno registrado (si el plan
                                            tenía descuento, ya está aplicado
                                            en el total)
                                          </span>
                                        </div>
                                      )}
                                      <div className="grid grid-cols-2">
                                        <span className="text-muted-foreground">
                                          Total:
                                        </span>
                                        <span className="font-bold">
                                          {formatCOP(factura.total)}
                                        </span>
                                      </div>
                                    </div>
                                  </div>
                                  <div>
                                    <h4 className="font-semibold mb-2">
                                      Información de Pago
                                    </h4>
                                    <div className="space-y-2">
                                      <div className="grid grid-cols-2">
                                        <span className="text-muted-foreground">
                                          Pagado:
                                        </span>
                                        <span>
                                          {formatCOP(factura.totalPagado)}
                                        </span>
                                      </div>
                                      <div className="grid grid-cols-2">
                                        <span className="text-muted-foreground">
                                          Saldo pendiente:
                                        </span>
                                        <span className="font-bold">
                                          {formatCOP(factura.saldoPendiente)}
                                        </span>
                                      </div>
                                      {factura.saldoPendiente > 0 && (
                                        <Button
                                          size="sm"
                                          onClick={() =>
                                            abrirModalParaFactura(factura)
                                          }
                                        >
                                          <CreditCard className="h-4 w-4 mr-1" />{" "}
                                          Registrar Pago
                                        </Button>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </TableCell>
                          </TableRow>
                        )}
                      </React.Fragment>
                    ))
                  )}
                </TableBody>
              </Table>
            </CardContent>
          </Card>
        )}
      </div>

      <RegistrarPagoModal
        open={modalAbierto}
        onOpenChange={setModalAbierto}
        facturas={facturasPendientes}
        facturaPreseleccionada={facturaParaPago}
        onPagoRegistrado={cargarDatos}
      />
    </div>
  );
}
</file>

<file path="app/perfil/page.tsx">
"use client";
import ProtectedRoute from "@/components/ProtectedRoute";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { toast } from "react-toastify";
import { api, clearAuthToken } from "@/lib/api";
import { useUser } from "@/context/UserContext";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Badge } from "@/components/ui/badge";
import {
  CalendarIcon,
  Camera,
  Check,
  Key,
  LogOut,
  Mail,
  Phone,
  Save,
  User,
  MapPin,
} from "lucide-react";
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover";
import { Calendar } from "@/components/ui/calendar";
import { format } from "date-fns";
import { es } from "date-fns/locale";
import { cn } from "@/lib/utils";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

const generos = [
  { id: 1, nombre: "Masculino" },
  { id: 2, nombre: "Femenino" },
  { id: 3, nombre: "Otro" },
];

// El backend expone el perfil vía GET /api/usuario/me devolviendo un
// UsuarioDTO. Ese DTO trae los datos de la persona asociada APLANADOS
// (nombre, apellidos, direccion, telefono, fechaNacimiento, generoId,
// personaId) y el rol como "rolNombre", no como objetos anidados
// "persona"/"rol". Este tipo refleja eso para no repetir el bug del front
// original, que asumía una forma que el backend nunca produce.
interface UsuarioPerfil {
  id: number;
  username: string;
  email: string;
  rolNombre: string | null;
  ultimoAcceso: string | null;
  activo: boolean;
  requiereCambioPassword: boolean;
  personaId: number | null;
  nombre: string | null;
  apellidos: string | null;
  direccion: string | null;
  telefono: string | null;
  fechaNacimiento: string | null;
  generoId: number | null;
}

function PerfilContent() {
  const router = useRouter();
  const { setUser } = useUser();
  const [loading, setLoading] = useState(true);
  const [usuario, setUsuario] = useState<UsuarioPerfil | null>(null);
  const [formData, setFormData] = useState({
    email: "",
    nombre: "",
    direccion: "",
    telefono: "",
    genero_id: 1,
  });
  const [date, setDate] = useState<Date | undefined>(undefined);
  const [isEditing, setIsEditing] = useState(false);
  const [passwordData, setPasswordData] = useState({
    currentPassword: "",
    newPassword: "",
    confirmPassword: "",
  });
  const [passwordError, setPasswordError] = useState("");
  const [passwordSuccess, setPasswordSuccess] = useState("");
  const [changingPassword, setChangingPassword] = useState(false);

  useEffect(() => {
    const fetchUser = async () => {
      setLoading(true);
      try {
        const res = await api.get("/api/usuario/me");
        const data: UsuarioPerfil = res.data;
        setUsuario(data);

        setFormData({
          email: data.email || "",
          nombre: data.personaId ? data.nombre || "" : "",
          direccion: data.personaId ? data.direccion || "" : "",
          telefono: data.personaId ? data.telefono || "" : "",
          genero_id: data.generoId || 1,
        });
        setDate(
          data.personaId && data.fechaNacimiento
            ? new Date(data.fechaNacimiento)
            : undefined
        );
      } catch (err) {
        setUsuario(null);
      } finally {
        setLoading(false);
      }
    };
    fetchUser();
  }, []);

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handlePasswordChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setPasswordData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSaveProfile = () => {
    // NOTA: el backend todavía no expone un endpoint de auto-servicio para
    // que un usuario edite sus propios datos de persona (el único endpoint
    // existente, PUT /api/usuario/actualizar/{id}, requiere el permiso
    // administrativo "modificar_usuario"). Hasta que exista ese endpoint,
    // dejamos claro que el formulario no persiste cambios en vez de simular
    // un guardado exitoso que en realidad no ocurre.
    setIsEditing(false);
    toast.info(
      "La edición de perfil aún no está conectada a un endpoint del backend. Contacta a un administrador para actualizar tus datos."
    );
  };

  const handleChangePassword = async () => {
    setPasswordError("");
    setPasswordSuccess("");

    if (!passwordData.currentPassword) {
      setPasswordError("Debes ingresar tu contraseña actual");
      return;
    }
    if (passwordData.newPassword.length < 8) {
      setPasswordError("La nueva contraseña debe tener al menos 8 caracteres");
      return;
    }
    if (passwordData.newPassword !== passwordData.confirmPassword) {
      setPasswordError("Las contraseñas no coinciden");
      return;
    }

    setChangingPassword(true);
    try {
      const response = await api.post("/api/change-password", {
        currentPassword: passwordData.currentPassword,
        newPassword: passwordData.newPassword,
      });

      if (response.data.success) {
        setPasswordSuccess("Contraseña actualizada correctamente");
        setPasswordData({
          currentPassword: "",
          newPassword: "",
          confirmPassword: "",
        });
      } else {
        setPasswordError(response.data.message || "No se pudo cambiar la contraseña");
      }
    } catch (err: any) {
      setPasswordError(
        err.response?.data?.message || "Error al conectar con el servidor"
      );
    } finally {
      setChangingPassword(false);
    }
  };

  const handleLogout = async () => {
    try {
      await api.post("/api/logout", {});
    } catch (err) {
      // Si el logout en el backend falla igual limpiamos la sesión local.
    } finally {
      clearAuthToken();
      setUser(null);
      router.push("/login");
    }
  };

  const getInitials = (name: string) => {
    if (!name) return "U";
    return name
      .split(" ")
      .map((n) => n[0])
      .join("")
      .toUpperCase()
      .substring(0, 2);
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <p>Cargando perfil...</p>
      </div>
    );
  }

  if (!usuario) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <p>No se pudo cargar el perfil.</p>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-3xl font-bold tracking-tight">Mi Perfil</h1>
        <p className="text-muted-foreground">
          Gestiona tu información personal y configuración de cuenta
        </p>
      </div>

      <div className="grid gap-6 md:grid-cols-[1fr_3fr]">
        {/* Tarjeta de perfil */}
        <Card>
          <CardContent className="pt-6 flex flex-col items-center">
            <div className="relative mb-4">
              <Avatar className="h-24 w-24">
                <AvatarImage
                  src="/placeholder.svg?height=96&width=96"
                  alt="Avatar"
                />
                <AvatarFallback className="text-lg bg-purple-100 text-purple-700">
                  {usuario.personaId
                    ? getInitials(usuario.nombre || "")
                    : getInitials(usuario.username)}
                </AvatarFallback>
              </Avatar>
              <Button
                size="icon"
                variant="outline"
                className="absolute bottom-0 right-0 rounded-full h-8 w-8 bg-background"
              >
                <Camera className="h-4 w-4" />
                <span className="sr-only">Cambiar foto</span>
              </Button>
            </div>

            <h2 className="text-xl font-bold mt-2">
              {usuario.personaId ? usuario.nombre : usuario.username}
            </h2>
            <p className="text-sm text-muted-foreground">{usuario.email}</p>

            <Badge variant="outline" className="mt-2">
              {usuario.rolNombre}
            </Badge>

            <div className="w-full mt-6 space-y-2">
              <div className="flex items-center text-sm">
                <User className="mr-2 h-4 w-4 text-muted-foreground" />
                <span>Usuario: {usuario.username}</span>
              </div>
              {usuario.personaId && (
                <>
                  <div className="flex items-center text-sm">
                    <Phone className="mr-2 h-4 w-4 text-muted-foreground" />
