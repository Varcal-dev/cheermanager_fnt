<file path="app/components/Forms/CrearConvenio.tsx">
"use client";

import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectTrigger,
  SelectValue,
  SelectContent,
  SelectItem,
} from "@/components/ui/select";
import { Calendar } from "@/components/ui/calendar";
import { CalendarIcon, Plus } from "lucide-react";
import {
  Popover,
  PopoverTrigger,
  PopoverContent,
} from "@/components/ui/popover";
import { cn } from "@/lib/utils";
import { format } from "date-fns";
import React, { useEffect, useState } from "react";
import axios from "axios";
import { toast } from "react-toastify";

interface Descuento {
  id: number;
  nombre: string;
  porcentaje: number;
  activo: boolean;
}

export function ModalCrearConvenio({
  onConvenioCreado,
}: {
  onConvenioCreado?: () => void;
}) {
  const [open, setOpen] = useState(false);
  const [nombreEmpresa, setNombreEmpresa] = useState("");
  const [descuentoId, setDescuentoId] = useState<string>("");
  const [fechaInicio, setFechaInicio] = useState<Date | undefined>();
  const [fechaFin, setFechaFin] = useState<Date | undefined>();
  const [descuentos, setDescuentos] = useState<Descuento[]>([]);

  useEffect(() => {
    fetch(`${process.env.NEXT_PUBLIC_API_URL}/api/descuentos`)
      .then((res) => res.json())
      .then((data: Descuento[]) => {
        const activos = data.filter((d) => d.activo);
        setDescuentos(activos);
      });
  }, []);

  const handleSubmit = async () => {
    const payload = {
      nombreEmpresa,
      descuentoId: parseInt(descuentoId),
      fechaInicio,
      fechaFin,
    };

    try {
        console.log("Data: ", payload);
      const res = await axios.post(
        `${process.env.NEXT_PUBLIC_API_URL}/api/convenios`,
        payload
      );

      if (res.status === 200 || res.status === 201) {
        toast.success("Nuevo convenio registrado");
        setOpen(false);
        setNombreEmpresa("");
        setDescuentoId("");
        setFechaInicio(undefined);
        setFechaFin(undefined);
        onConvenioCreado?.();
      } else {
        toast.error("Respuesta inesperada al crear convenio");
        console.error("Respuesta inesperada al crear convenio:", res.status);
      }
    } catch (error) {
      toast.error("Error al crear convenio:");
      console.error("Error al crear convenio:", error);
    }
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        <Button>
          <Plus className="mr-2 h-4 w-4" />
          Nuevo Convenio
        </Button>
      </DialogTrigger>
      <DialogContent className="sm:max-w-lg">
        <DialogHeader>
          <DialogTitle>Registrar Convenio</DialogTitle>
        </DialogHeader>

        <div className="grid gap-4 py-2">
          <div className="grid gap-2">
            <Label>Empresa/Institución</Label>
            <Input
              value={nombreEmpresa}
              onChange={(e) => setNombreEmpresa(e.target.value)}
            />
          </div>

          <div className="grid gap-2">
            <Label>Descuento</Label>
            <Select value={descuentoId} onValueChange={setDescuentoId}>
              <SelectTrigger>
                <SelectValue placeholder="Selecciona un descuento" />
              </SelectTrigger>
              <SelectContent>
                {descuentos.map((d) => (
                  <SelectItem key={d.id} value={String(d.id)}>
                    {d.nombre} - {d.porcentaje}%
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div className="grid gap-2">
              <Label>Fecha Inicio</Label>
              <Popover>
                <PopoverTrigger asChild>
                  <Button
                    variant="outline"
                    className={cn(
                      "justify-start text-left font-normal",
                      !fechaInicio && "text-muted-foreground"
                    )}
                  >
                    <CalendarIcon className="mr-2 h-4 w-4" />
                    {fechaInicio
                      ? format(fechaInicio, "dd/MM/yyyy")
                      : "Selecciona una fecha"}
                  </Button>
                </PopoverTrigger>
                <PopoverContent className="w-auto p-0">
                  <Calendar
                    mode="single"
                    selected={fechaInicio}
                    onSelect={setFechaInicio}
                  />
                </PopoverContent>
              </Popover>
            </div>

            <div className="grid gap-2">
              <Label>Fecha Fin</Label>
              <Popover>
                <PopoverTrigger asChild>
                  <Button
                    variant="outline"
                    className={cn(
                      "justify-start text-left font-normal",
                      !fechaFin && "text-muted-foreground"
                    )}
                  >
                    <CalendarIcon className="mr-2 h-4 w-4" />
                    {fechaFin
                      ? format(fechaFin, "dd/MM/yyyy")
                      : "Selecciona una fecha"}
                  </Button>
                </PopoverTrigger>
                <PopoverContent className="w-auto p-0">
                  <Calendar
                    mode="single"
                    selected={fechaFin}
                    onSelect={setFechaFin}
                  />
                </PopoverContent>
              </Popover>
            </div>
          </div>
        </div>

        <div className="flex justify-end gap-2">
          <Button variant="outline" onClick={() => setOpen(false)}>
            Cancelar
          </Button>
          <Button
            onClick={handleSubmit}
            disabled={
              !nombreEmpresa || !descuentoId || !fechaInicio || !fechaFin
            }
          >
            Registrar
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/Forms/EliminarConvenio.tsx">
"use client";

import { useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Trash2 } from "lucide-react";

interface ModalEliminarConvenioProps {
  convenioId: number;
  nombreEmpresa: string;
  onEliminado: () => void;
}

export function ModalEliminarConvenio({
  convenioId,
  nombreEmpresa,
  onEliminado,
}: ModalEliminarConvenioProps) {
  const [open, setOpen] = useState(false);
  const [loading, setLoading] = useState(false);

  const eliminarConvenio = async () => {
    setLoading(true);
    try {
      const response = await fetch(
        `${process.env.NEXT_PUBLIC_API_URL}/api/convenios/${convenioId}`,
        {
          method: "DELETE",
        }
      );
      if (response.ok) {
        onEliminado();
        setOpen(false);
      } else {
        console.error("Error al eliminar convenio");
      }
    } catch (error) {
      console.error("Error en la solicitud:", error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <>
      <Button variant="destructive" size="sm" onClick={() => setOpen(true)}>
        <Trash2 className="h-4 w-4 mr-1" /> Eliminar
      </Button>

      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>¿Eliminar convenio con {nombreEmpresa}?</DialogTitle>
          </DialogHeader>
          <p>
            Esta acción no se puede deshacer. ¿Estás seguro de que deseas
            continuar?
          </p>
          <DialogFooter>
            <Button
              variant="secondary"
              onClick={() => setOpen(false)}
              disabled={loading}
            >
              Cancelar
            </Button>
            <Button
              variant="destructive"
              onClick={eliminarConvenio}
              disabled={loading}
            >
              {loading ? "Eliminando..." : "Eliminar"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </>
  );
}
</file>

<file path="app/components/nav-config.ts">
import type { LucideIcon } from "lucide-react";
import {
  Home,
  Users,
  Calendar,
  Award,
  BarChart3,
  ShoppingBag,
  DollarSign,
  Shield,
  Settings,
  UserPlus,
  Layers,
  ClipboardList,
  Trophy,
  Target,
  FileText,
  ShoppingCart,
  CreditCard,
  Lock,
} from "lucide-react";

// -----------------------------------------------------------------------------
// Fuente única de verdad para la navegación del sistema.
// El sidebar y los breadcrumbs se generan a partir de esta config, así que
// agregar/quitar/mover una página es un cambio en UN solo lugar.
//
// `status: "soon"` = la página aún no existe en el frontend (el controller de
// backend ya existe, pero falta construir la vista). Se muestra en el sidebar
// como no-clickeable con badge "Pronto" en vez de generar un 404.
// Cuando construyas la página, solo cambia el status a "ready" (o bórralo).
// -----------------------------------------------------------------------------

export interface NavItem {
  href: string;
  label: string;
  icon: LucideIcon;
  status?: "ready" | "soon";
}

export interface NavSection {
  id: string;
  label: string;
  icon: LucideIcon;
  permission: string;
  items: NavItem[];
}

export const HOME_ITEM: NavItem = {
  href: "/",
  label: "Inicio",
  icon: Home,
};

export const NAV_SECTIONS: NavSection[] = [
  {
    id: "personas",
    label: "Personas",
    icon: Users,
    permission: "ver_dash_personas",
    items: [
      { href: "/deportistas", label: "Deportistas", icon: UserPlus },
      { href: "/entrenadores", label: "Entrenadores", icon: Users },
      {
        href: "/historial-medico",
        label: "Historial Médico",
        icon: ClipboardList,
      },
    ],
  },
  {
    id: "organizacion",
    label: "Organización",
    icon: Layers,
    permission: "ver_dash_organizacion",
    items: [
      { href: "/niveles", label: "Niveles", icon: BarChart3 },
      { href: "/divisiones", label: "Divisiones", icon: Layers },
      {
        href: "/categorias-nivel",
        label: "Categorías por Nivel",
        icon: Layers
      },
      { href: "/grupos", label: "Grupos", icon: Users },
      { href: "/inscripciones", label: "Inscripciones", icon: FileText },
    ],
  },
  {
    id: "horarios",
    label: "Horarios",
    icon: Calendar,
    permission: "ver_dash_horarios",
    items: [
      { href: "/horarios", label: "Gestión de Horarios", icon: Calendar },
      {
        href: "/asistencias",
        label: "Asistencias",
        icon: ClipboardList
      },
    ],
  },
  {
    id: "eventos",
    label: "Eventos",
    icon: Trophy,
    permission: "ver_dash_eventos",
    items: [
      {
        href: "/eventos",
        label: "Competencias y Eventos",
        icon: Award,
      },
      { href: "/premios", label: "Premios", icon: Trophy, status: "soon" },
    ],
  },
  {
    id: "evaluacion",
    label: "Evaluación",
    icon: BarChart3,
    permission: "ver_dash_evaluacion",
    items: [
      {
        href: "/criterios-evaluacion",
        label: "Criterios",
        icon: ClipboardList,
        status: "soon",
      },
      { href: "/evaluaciones", label: "Evaluaciones", icon: BarChart3 },
      { href: "/objetivos", label: "Objetivos", icon: Target},
    ],
  },
  {
    id: "tienda",
    label: "Tienda",
    icon: ShoppingBag,
    permission: "ver_dash_tienda",
    items: [  
      { href: "/inventario", label: "Inventario", icon: ClipboardList },
      { href: "/ventas", label: "Ventas", icon: ShoppingCart },
    ],
  },
  {
    id: "finanzas",
    label: "Finanzas",
    icon: DollarSign,
    permission: "ver_dash_finanzas",
    items: [
      {
        href: "/planes-inscripcion",
        label: "Planes de Inscripción",
        icon: FileText,
      },
      {
        href: "/planes-mensualidad",
        label: "Planes de Mensualidad",
        icon: FileText,
      },
      {
        href: "/tipos-planes-pago",
        label: "Tipos de Planes de Pago",
        icon: FileText,
      },
      { href: "/descuentos", label: "Descuentos", icon: DollarSign },
      { href: "/convenios", label: "Convenios", icon: FileText },
      { href: "/facturas", label: "Facturas", icon: FileText },
      { href: "/pagos", label: "Pagos", icon: CreditCard },
    ],
  },
  {
    id: "administracion",
    label: "Administración",
    icon: Settings,
    permission: "ver_dash_administracion",
    items: [
      { href: "/usuarios", label: "Usuarios", icon: Users },
      { href: "/roles", label: "Roles y Permisos", icon: Lock },
      { href: "/auditoria", label: "Auditoría", icon: Shield },
    ],
  },
];

/** Todas las entradas de navegación, planas, incluyendo Inicio. Útil para breadcrumbs. */
export const ALL_NAV_ITEMS: NavItem[] = [
  HOME_ITEM,
  ...NAV_SECTIONS.flatMap((s) => s.items),
];

/** Encuentra la sección que contiene una ruta dada (o undefined si es de nivel raíz). */
export function findSectionForPath(pathname: string): NavSection | undefined {
  return NAV_SECTIONS.find((section) =>
    section.items.some((item) => pathname.startsWith(item.href))
  );
}

/** Encuentra el NavItem exacto (o el prefijo más largo que matchea) para una ruta. */
export function findNavItemForPath(pathname: string): NavItem | undefined {
  const candidates = ALL_NAV_ITEMS.filter(
    (item) => item.href === "/" ? pathname === "/" : pathname.startsWith(item.href)
  );
  // El match más específico (href más largo) gana, ej. evita que "/eventos"
  // le gane a un futuro "/eventos/[id]".
  return candidates.sort((a, b) => b.href.length - a.href.length)[0];
}
