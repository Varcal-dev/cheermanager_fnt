      const yaExpandido = prev.includes(id);
      if (!yaExpandido && !historialNivelesPorDeportista[id]) {
        cargarHistorialesDeDeportista(id);
      }
      return yaExpandido ? prev.filter((i) => i !== id) : [...prev, id];
