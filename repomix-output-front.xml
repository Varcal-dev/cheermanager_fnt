  inscripcionId: number | null;
  // La lista de Inscripciones ya conoce estos dos datos (vienen de
  // InscripcionDetalleDto, ya probado) — se los pasamos en vez de
  // volver a derivarlos del GET /{id}, que devuelve el entity crudo
  // con una forma anidada distinta.
  nombreDeportista: string;
  fechaInscripcion: string;
  onActualizado: () => void;
}) {
  const [cargando, setCargando] = useState(true);
  const [guardando, setGuardando] = useState(false);

  const [planesInscripcion, setPlanesInscripcion] = useState<PlanPago[]>([]);
  const [planesMensualidad, setPlanesMensualidad] = useState<PlanPago[]>([]);

  const [planSeleccionado, setPlanSeleccionado] = useState("");
  const [planMensualidadSeleccionado, setPlanMensualidadSeleccionado] = useState("");
  const [fechaVencimiento, setFechaVencimiento] = useState("");
  const [estado, setEstado] = useState("Activa");

  useEffect(() => {
    if (!open || !inscripcionId) return;

    setCargando(true);
    Promise.allSettled([
      api.get(`/api/inscripciones/${inscripcionId}`),
      api.get("/api/planes-pago", { params: { categoria: "inscripcion" } }),
      api.get("/api/planes-pago", { params: { categoria: "mensualidad" } }),
    ]).then(([resInscripcion, resPlanes, resPlanesMensualidad]) => {
      if (resInscripcion.status === "fulfilled") {
        const data = resInscripcion.value.data;
        setPlanSeleccionado(data.planPago?.id ? String(data.planPago.id) : "");
        setPlanMensualidadSeleccionado(
          data.planMensualidad?.id ? String(data.planMensualidad.id) : "",
        );
        setFechaVencimiento(data.fechaVencimiento ?? "");
        setEstado(data.estado ?? "Activa");
      } else {
        toast.error("No se pudo cargar la inscripción");
      }

      if (resPlanes.status === "fulfilled") setPlanesInscripcion(resPlanes.value.data);
      if (resPlanesMensualidad.status === "fulfilled")
        setPlanesMensualidad(resPlanesMensualidad.value.data);

      setCargando(false);
    });
  }, [open, inscripcionId]);

  const handleSubmit = async () => {
    if (!inscripcionId || !planSeleccionado) return;

    // Salvavidas: si por algún motivo no tenemos la fecha de inscripción
    // original, no mandamos el PUT — el backend la rechazaría igual (la
    // columna es NOT NULL) pero preferimos avisar claro aquí en vez de
    // dejar que llegue como error de base de datos.
    if (!fechaInscripcion) {
      toast.error(
        "No se pudo determinar la fecha de inscripción original. Cierra y vuelve a intentar.",
      );
      return;
    }

    setGuardando(true);
    try {
      await api.put(`/api/inscripciones/${inscripcionId}`, {
        planPago: { id: Number(planSeleccionado) },
        planMensualidad: planMensualidadSeleccionado
          ? { id: Number(planMensualidadSeleccionado) }
          : null,
        fechaInscripcion,
        fechaVencimiento,
        estado,
      });
      toast.success("Inscripción actualizada correctamente");
      onOpenChange(false);
      onActualizado();
    } catch (error: any) {
      // El backend rechaza el cambio de plan con un mensaje claro si la
      // factura ya tiene pagos registrados — se lo mostramos tal cual.
      toast.error(
        error.response?.data?.message || error.response?.data || "No se pudo actualizar la inscripción",
      );
    } finally {
      setGuardando(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>Editar inscripción</DialogTitle>
        </DialogHeader>

        {cargando ? (
          <div className="flex items-center justify-center py-10 text-muted-foreground">
            <Loader2 className="h-5 w-5 animate-spin mr-2" /> Cargando…
          </div>
        ) : (
          <div className="space-y-4 py-2">
            <p className="text-sm text-muted-foreground">
              Editando la inscripción de <strong>{nombreDeportista}</strong>
            </p>

            <div className="grid gap-1.5">
              <Label>Plan de inscripción</Label>
              <Select value={planSeleccionado} onValueChange={setPlanSeleccionado}>
                <SelectTrigger>
                  <SelectValue placeholder="Selecciona un plan" />
                </SelectTrigger>
                <SelectContent>
                  {planesInscripcion.map((plan) => (
                    <SelectItem key={plan.id} value={String(plan.id)}>
                      {plan.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              <p className="text-xs text-muted-foreground">
                Si esta inscripción ya tiene pagos registrados, cambiar el
                plan será rechazado por el sistema.
              </p>
            </div>

            <div className="grid gap-1.5">
              <Label>
                Plan de mensualidad{" "}
                <span className="font-normal text-muted-foreground">(opcional)</span>
              </Label>
              <Select
                value={planMensualidadSeleccionado}
                onValueChange={setPlanMensualidadSeleccionado}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Sin mensualidad" />
                </SelectTrigger>
                <SelectContent>
                  {planesMensualidad.map((plan) => (
                    <SelectItem key={plan.id} value={String(plan.id)}>
                      {plan.nombre}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            <div className="grid gap-1.5">
              <Label>Fecha de vencimiento</Label>
              <Input
                type="date"
                value={fechaVencimiento}
                onChange={(e) => setFechaVencimiento(e.target.value)}
              />
            </div>

            <div className="grid gap-1.5">
              <Label>Estado</Label>
              <Select value={estado} onValueChange={setEstado}>
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="Activa">Activa</SelectItem>
                  <SelectItem value="Inactiva">Inactiva</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
        )}

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={guardando}>
            Cancelar
          </Button>
          <Button onClick={handleSubmit} disabled={cargando || guardando || !planSeleccionado}>
            {guardando ? (
              <>
                <Loader2 className="mr-2 h-4 w-4 animate-spin" /> Guardando…
              </>
            ) : (
              "Guardar cambios"
            )}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="app/components/matricula/MatriculaWizard.tsx">
"use client";

import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { UserPlus, Check } from "lucide-react";
import { useMatriculaState } from "./useMatriculaState";
import { EstadoMatricula, PasoMatricula } from "@/app/lib/matricula";
import PasoDeportista from "./PasoDeportista";
import PasoPlanPago from "./PasoPlanPago";
import PasoGrupo from "./PasoGrupo";
import PasoConfirmacion from "./PasoConfirmacion";

const PASOS: { id: PasoMatricula; label: string }[] = [
  { id: "deportista", label: "Deportista" },
  { id: "plan", label: "Plan de pago" },
  { id: "grupo", label: "Grupo" },
  { id: "confirmacion", label: "Confirmar" },
];

export default function MatriculaWizard({
  open,
  onOpenChange,
  estadoInicial,
  onCompletado,
}: {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  estadoInicial?: EstadoMatricula;
  onCompletado: () => void;
}) {
  const wizard = useMatriculaState(estadoInicial);
  const pasoActualIndex = PASOS.findIndex((p) => p.id === wizard.estado.paso);

  const cerrar = (nuevoOpen: boolean) => {
    // No hay "cancelar" destructivo: cualquier avance ya está guardado en
    // el backend. Cerrar simplemente pausa; la fila de inscripciones
    // refleja el estado real y permite continuar después.
    onOpenChange(nuevoOpen);
    if (!nuevoOpen) onCompletado();
  };

  return (
    <Dialog open={open} onOpenChange={cerrar}>
      <DialogContent className="max-w-xl">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <UserPlus className="h-5 w-5" /> Matricular deportista
          </DialogTitle>
        </DialogHeader>

        <div className="flex items-center gap-2 mb-2">
          {PASOS.map((paso, i) => (
            <div key={paso.id} className="flex items-center gap-2 flex-1">
              <div
                className={`h-7 w-7 rounded-full flex items-center justify-center text-xs font-medium shrink-0 ${
                  i < pasoActualIndex
                    ? "bg-green-600 text-white"
                    : i === pasoActualIndex
                    ? "bg-primary text-primary-foreground"
                    : "bg-muted text-muted-foreground"
                }`}
              >
                {i < pasoActualIndex ? <Check className="h-4 w-4" /> : i + 1}
              </div>
              <span className="text-xs text-muted-foreground hidden sm:block">
                {paso.label}
              </span>
              {i < PASOS.length - 1 && (
                <div className="h-px bg-border flex-1" />
              )}
            </div>
          ))}
        </div>

        {wizard.estado.paso === "deportista" && (
          <PasoDeportista onSeleccionar={wizard.elegirDeportista} />
        )}
        {wizard.estado.paso === "plan" && wizard.estado.deportista && (
          <PasoPlanPago
            deportista={wizard.estado.deportista}
            guardando={wizard.guardando}
            permitirVolver={!wizard.estado.inscripcionId}
            onVolver={() => wizard.irA("deportista")}
            onConfirmar={wizard.confirmarPlan}
          />
        )}
        {wizard.estado.paso === "grupo" && wizard.estado.deportista && (
          <PasoGrupo
            deportistaId={wizard.estado.deportista.deportista_id}
            guardando={wizard.guardando}
            onVolver={() => wizard.irA("plan")}
            onConfirmar={wizard.confirmarGrupo}
          />
        )}
        {wizard.estado.paso === "confirmacion" && (
          <PasoConfirmacion
            estado={wizard.estado}
            onCerrar={() => cerrar(false)}
          />
        )}
      </DialogContent>
    </Dialog>
  );
}
</file>

